Функция ПолучитьАдресРесурса(Ресурс)
	
	Если ВРЕГ(Ресурс) = "GETSERVICE" Тогда
		
		Возврат "services/hs/rest/v1.0/public/getService";
		
	ИначеЕсли ВРЕГ(Ресурс) = "GETINFOBYLOGIN" Тогда
		
