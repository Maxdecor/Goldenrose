// Определяет ник сервиса по переданному наименованию
Функция ПолучитьНикСервисаПоНаименованию(НаименованиеСервиса) Экспорт
	
	Если ВРЕГ(НаименованиеСервиса) = "ЗАГРУЗКАИНДЕКСОВПЕРЕОЦЕНКИОС" Тогда
		
		Возврат "uz-revaluation-indices";
		
	ИначеЕсли ВРЕГ(НаименованиеСервиса) = "ЗАГРУЗКАДАННЫХКОНТРАГЕНТАПОИНН" Тогда
		
		Возврат "uz-counteragent-by-tin";
		
	ИначеЕсли ВРЕГ(НаименованиеСервиса) = "ЗАГРУЗКАКЛАССИФИКАТОРАБАНКОВ" Тогда
		
		Возврат "uz-bank-classifier";
		
	ИначеЕсли ВРЕГ(НаименованиеСервиса) = "ЗАГРУЗКАКУРСОВВАЛЮТ" Тогда
		
		Возврат "uz-currency-rates";
		
	ИначеЕсли ВРЕГ(НаименованиеСервиса) = "ИСПОЛЬЗОВАНИЕЭДО" Тогда
		
		Возврат "uz-edo-access";
		
	ИначеЕсли ВРЕГ(НаименованиеСервиса) = "ВЫГРУЗКАРЕГЛАМЕНТИРОВАННОЙОТЧЕТНОСТИНАСАЙТГНК" Тогда
		
		Возврат "uz-reporting";
		
	КонецЕсли;	
	
	
	Возврат "";	
	
КонецФункции // ПолучитьНикСервисаПоНаименованию()

