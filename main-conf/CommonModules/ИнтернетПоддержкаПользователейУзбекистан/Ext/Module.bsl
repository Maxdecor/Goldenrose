// Получает текст ошибки из стандартного ответа сервера поставщика сервисов
Функция ПолучитьТекстОшибкиИзОтветаСервера(ОтветСервера)
	
	ТекстОшибки = "";
	
	Если ОтветСервера.Получить("error") <> Неопределено Тогда
		
		КлассОшибки = ОтветСервера.Получить("error");
		
		Если КлассОшибки.Получить("errorMessageRu") <> Неопределено Тогда
			
			ТекстОшибки = КлассОшибки.Получить("errorMessageRu");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции // ПолучитьТекстОшибкиИзОтветаСервера()

// Получает текст ошибки из стандартного ответа сервиса
Функция ПолучитьТекстОшибкиИзОтветаСервиса(ОтветСервиса)
	
	ТекстОшибки = "";
	
	Если ОтветСервиса.Получить("serviceError") <> Неопределено Тогда
		
		КлассОшибки = ОтветСервиса.Получить("serviceError");
		
		Если КлассОшибки.Получить("serviceErrorMessageRu") <> Неопределено Тогда
			
			ТекстОшибки = КлассОшибки.Получить("serviceErrorMessageRu");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции // ПолучитьТекстОшибкиИзОтветаСервиса()


