#Область УстановкаКомпоненты

// Процедура запускает процесс установки файла компоненты криптографии
// Вызывается асинхронно
// Параметры:
// 		ОписаниеОповещения - Описание оповещения вызова процедуры по завершению установки
// 		ДопПараметры - дополнительные параметры асинхронного вызова процедуры (не используется)
Процедура УстановкаКомпонентаКриптографииНачало(ОписаниеОповещения, ДопПараметры = Неопределено) Экспорт
	
	#Если НЕ ВебКлиент Тогда
		
		КаталогКомпонентыКриптографии = uzbled_EImzoСлужебный.ПолучитьКаталогКомпонентыКриптографии();
		
		Если Не ПустаяСтрока(КаталогКомпонентыКриптографии) Тогда
			ПутьККомпонентеКриптографии = КаталогКомпонентыКриптографии + "eimzoClient.jar";
		Иначе
			ПутьККомпонентеКриптографии = ПолучитьИмяВременногоФайла(".jar");
		КонецЕсли;
		
		ДопПараметры_УстановкаКомпонентаКриптографииЗавершение = Новый Структура;
		ДопПараметры_УстановкаКомпонентаКриптографииЗавершение.Вставить("ОписаниеОповещения", ОписаниеОповещения);
		ДопПараметры_УстановкаКомпонентаКриптографииЗавершение.Вставить("ПутьККомпонентеКриптографии", ПутьККомпонентеКриптографии);
		
		Оповещение = Новый ОписаниеОповещения("УстановкаКомпонентаКриптографииЗавершение", uzbled_ОбщегоНазначенияКлиентСервер.ОбщийМодуль("uzbled_EImzo"), ДопПараметры_УстановкаКомпонентаКриптографииЗавершение);
		
		АдресКомпонентыКриптографии = uzbled_EImzoСлужебный.ПолучитьДвоичныеДанныеКомпонентыКриптографии();
		ДДКомпонентыКриптографии = ПолучитьИзВременногоХранилища(АдресКомпонентыКриптографии);
		ДДКомпонентыКриптографии.НачатьЗапись(Оповещение, ПутьККомпонентеКриптографии);
		
	#Иначе
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Ложь);
		
	#КонецЕсли
	
КонецПроцедуры

// Процедура записывает путь к компоненту в соответствующую константу
// Вызывается асинхронно
// Параметры:
// 		ДопПараметры - дополнительные параметры асинхронного вызова процедуры, структура
//					ключ "ОписаниеОповещения" содержит описание оповещения процедуры (функции) куда возвращается результат
// ***
// Результат установки всегда Истина, т.к. асинхронный метод записи двоичных данных в файл
// не сообщает о результате записи
Процедура УстановкаКомпонентаКриптографииЗавершение(ДопПараметры) Экспорт

	#Если НЕ ВебКлиент Тогда
		
		uzbled_EImzoСлужебный.ЗаписатьПутьККомпонентеКриптографии(ДопПараметры["ПутьККомпонентеКриптографии"]);
		ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], Истина);
		
	#Иначе
		
		ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], Ложь);
		
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область ПолучитьВерсию

#КонецОбласти

#Область ПодключитьсяКВебСокету

// Процедура запускает процесс подключения к компоненте
// Успешное подключение означает: - установлена jre (jdk, jvm); - установлена компонента криптографии; - установление e-imzo
// Вызывается асинхронно
// Параметры:
// 		ОписаниеОповещения - Описание оповещения вызова процедуры по завершению подключения
// 		ДопПараметры - дополнительные параметры асинхронного вызова процедуры (не используется)
Процедура ПодключитьсяНачало(ОписаниеОповещения = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	#Если НЕ ВебКлиент Тогда
		
		ПутьКВыходномуФайлу = "";
		
		СтрокаЗапроса = ПолучитьСтрокуЗапроса("Подключиться", ПутьКВыходномуФайлу);
		
		ДопПараметры_ПодключитьсяПродолжение = Новый Структура;
		ДопПараметры_ПодключитьсяПродолжение.Вставить("ОписаниеОповещения", ОписаниеОповещения);
		ДопПараметры_ПодключитьсяПродолжение.Вставить("ПутьКВыходномуФайлу", ПутьКВыходномуФайлу);
		
		Оповещение_ПодключитьсяПродолжение = Новый ОписаниеОповещения("ПодключитьсяПродолжение", uzbled_ОбщегоНазначенияКлиентСервер.ОбщийМодуль("uzbled_EImzo"), ДопПараметры_ПодключитьсяПродолжение);
		
		ДопПараметры_ВыполнитьКомандуСистемыНачало = Новый Структура;
		ДопПараметры_ВыполнитьКомандуСистемыНачало.Вставить("ОписаниеОповещения", Оповещение_ПодключитьсяПродолжение);
		
		Оповещение = Новый ОписаниеОповещения("ВыполнитьКомандуСистемыНачало", uzbled_ОбщегоНазначенияКлиентСервер.ОбщийМодуль("uzbled_EImzo"), ДопПараметры_ВыполнитьКомандуСистемыНачало);
		
		ВыполнитьОбработкуОповещения(Оповещение, СтрокаЗапроса);
		
	#Иначе
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Ложь);
		
	#КонецЕсли
	
КонецПроцедуры

// Процедура продолжает процесс подключения к компоненте
// Происходит чтение файла, куда был записан результат подключения
// Вызывается асинхронно
// Параметры:
// 		Результат - признак отработки запроса к e-imzo
// 		ДопПараметры - дополнительные параметры асинхронного вызова [ПутьКВыходномуФайлу, ОписаниеОповещения]
Процедура ПодключитьсяПродолжение(Результат, ДопПараметры = Неопределено) Экспорт
	
	#Если НЕ ВебКлиент Тогда
		
		РезультатСтрока = "";
		
		Если Результат Тогда
			
			ПутьКВыходномуФайлу = ДопПараметры["ПутьКВыходномуФайлу"];
			
			Попытка
				ДД = Новый ДвоичныеДанные(ПутьКВыходномуФайлу);
				РезультатСтрока = uzbled_EImzoСлужебный.ПолучитьТекстИзФайла(ПоместитьВоВременноеХранилище(ДД), ".json");
			Исключение
			КонецПопытки;			
			
		КонецЕсли;
		
		ДопПараметры_ПодключитьсяЗавершение = Новый Структура;
		ДопПараметры_ПодключитьсяЗавершение.Вставить("ОписаниеОповещения", ДопПараметры["ОписаниеОповещения"]);
		
		Оповещение_ПодключитьсяЗавершение = Новый ОписаниеОповещения("ПодключитьсяЗавершение", uzbled_ОбщегоНазначенияКлиентСервер.ОбщийМодуль("uzbled_EImzo"), ДопПараметры_ПодключитьсяЗавершение);
		
		ВыполнитьОбработкуОповещения(Оповещение_ПодключитьсяЗавершение, РезультатСтрока);
		
	#Иначе
		
		ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], Ложь);
		
	#КонецЕсли
	
КонецПроцедуры

// Процедура завершает процесс подключения к компоненте
// Происходит разбор результата подключения
// Вызывается асинхронно
// Параметры:
// 		Результат - результат выполнения запроса (Строка)
// 		ДопПараметры - дополнительные параметры асинхронного вызова [ОписаниеОповещения]
Процедура ПодключитьсяЗавершение(Результат, ДопПараметры = Неопределено) Экспорт
	
	#Если НЕ ВебКлиент Тогда
		
		ПодключениеУстановлено = Ложь;
		
		Если НЕ ПустаяСтрока(Результат) Тогда
			
			Попытка
				
				РезультатаСоответствие = uzbled_EImzoСлужебный.ПрочитатьСтрокуJSON(Результат, Истина);
				
				Если РезультатаСоответствие.Получить("success") <> Неопределено
					И РезультатаСоответствие.Получить("success") Тогда
					
					ПодключениеУстановлено = Истина;
					
				Иначе
					
					ПодключениеУстановлено = Ложь;
					
				КонецЕсли;	
				
			Исключение
				
				ПодключениеУстановлено = Ложь;
				
			КонецПопытки;
			
		КонецЕсли;
		
		Если ДопПараметры["ОписаниеОповещения"] <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], ПодключениеУстановлено);
		КонецЕсли;
		
	#Иначе
		
		ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], Ложь);
		
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область ПолучениеСпискаКлючей

// Процедура запускает процесс получения списка ключей доступный пользователю ОС
// Вызывается асинхронно
// Параметры:
// 		ОписаниеОповещения - Описание оповещения вызова процедуры по завершению процесса
// 		ДопПараметры - дополнительные параметры асинхронного вызова процедуры (не используется)
Процедура ПолучитьСписокКлючейНачало(ОписаниеОповещения, ДопПараметры = Неопределено) Экспорт
	
	#Если НЕ ВебКлиент Тогда
		
		ПутьКВыходномуФайлу = "";
		
		СтрокаЗапроса = ПолучитьСтрокуЗапроса("ПолучитьСписокКлючей", ПутьКВыходномуФайлу);
		
		ДопПараметры_ПолучитьСписокКлючейПродолжение = Новый Структура;
		ДопПараметры_ПолучитьСписокКлючейПродолжение.Вставить("ОписаниеОповещения", ОписаниеОповещения);
		ДопПараметры_ПолучитьСписокКлючейПродолжение.Вставить("ПутьКВыходномуФайлу", ПутьКВыходномуФайлу);
		
		Оповещение_ПолучитьСписокКлючейПродолжение = Новый ОписаниеОповещения("ПолучитьСписокКлючейПродолжение", uzbled_ОбщегоНазначенияКлиентСервер.ОбщийМодуль("uzbled_EImzo"), ДопПараметры_ПолучитьСписокКлючейПродолжение);
		
		ДопПараметры_ВыполнитьКомандуСистемыНачало = Новый Структура;
		ДопПараметры_ВыполнитьКомандуСистемыНачало.Вставить("ОписаниеОповещения", Оповещение_ПолучитьСписокКлючейПродолжение);
		
		Оповещение = Новый ОписаниеОповещения("ВыполнитьКомандуСистемыНачало", uzbled_ОбщегоНазначенияКлиентСервер.ОбщийМодуль("uzbled_EImzo"), ДопПараметры_ВыполнитьКомандуСистемыНачало);
		
		ВыполнитьОбработкуОповещения(Оповещение, СтрокаЗапроса);
		
	#Иначе
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Новый Массив);
		
	#КонецЕсли
	
КонецПроцедуры

// Процедура продолждает процесс получения списка ключей доступный пользователю ОС
// Вызывается асинхронно
// Параметры:
// 		Результат - признак отработки запроса к e-imzo
// 		ДопПараметры - дополнительные параметры асинхронного вызова [ОписаниеОповещения]
Процедура ПолучитьСписокКлючейПродолжение(Результат, ДопПараметры = Неопределено) Экспорт
	
	#Если НЕ ВебКлиент Тогда
		
		РезультатСтрока = "";
		
		Если Результат Тогда
			
			ПутьКВыходномуФайлу = ДопПараметры["ПутьКВыходномуФайлу"];
			
			РезультатСтрока = "";
			
			ДД = Новый ДвоичныеДанные(ПутьКВыходномуФайлу);
			
			РезультатСтрока = uzbled_EImzoСлужебный.ПолучитьТекстИзФайла(ПоместитьВоВременноеХранилище(ДД), ".json");
			
		КонецЕсли;
		
		ДопПараметры_ПолучитьСписокКлючейЗавершение = Новый Структура;
		ДопПараметры_ПолучитьСписокКлючейЗавершение.Вставить("ОписаниеОповещения", ДопПараметры["ОписаниеОповещения"]);
		
		Оповещение = Новый ОписаниеОповещения("ПолучитьСписокКлючейЗавершение", uzbled_ОбщегоНазначенияКлиентСервер.ОбщийМодуль("uzbled_EImzo"), ДопПараметры_ПолучитьСписокКлючейЗавершение);
		
		ВыполнитьОбработкуОповещения(Оповещение, РезультатСтрока);
		
	#Иначе
		
		ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], Новый Массив);
		
	#КонецЕсли
	
КонецПроцедуры

// Процедура завершает процесс получения списка ключей доступный пользователю ОС
// Происходит разбор результата подключения и создания массива ключей
// Вызывается асинхронно
// Параметры:
// 		Результат - результат выполнения запроса (Строка)
// 		ДопПараметры - дополнительные параметры асинхронного вызова [ОписаниеОповещения]
Процедура ПолучитьСписокКлючейЗавершение(Результат, ДопПараметры = Неопределено) Экспорт
	
	#Если НЕ ВебКлиент Тогда
		
		МассивКлючей = Новый Массив;
		
		Если НЕ ПустаяСтрока(Результат) Тогда
			
			РезультатСоответствие = uzbled_EImzoСлужебный.ПрочитатьСтрокуJSON(Результат, Истина);
			
			Если РезультатСоответствие.Получить("success") <> Неопределено
				И РезультатСоответствие.Получить("success") Тогда
				
				СписокВыбора = Новый СписокЗначений;
				
				Certificates = РезультатСоответствие.Получить("certificates");
				Для каждого Certificate Из Certificates Цикл
					
					СоответствиеКлючей = Новый Соответствие;
					
					СоответствиеКлючей.Вставить("СтруктураКлюча", Новый Структура);
					СоответствиеКлючей.Вставить("ПараметрыКлюча", "");
					СоответствиеКлючей.Вставить("ПредставлениеКлюча", "");
					
					СоответствиеКлючей["ПараметрыКлюча"] = Certificate;   
					СоответствиеКлючей["СтруктураКлюча"] = uzbled_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруИзСоответствия(Certificate);
					СоответствиеКлючей["СтруктураКлюча"].Вставить("file_name", СоответствиеКлючей["СтруктураКлюча"].name);
					СписокКлючей = uzbled_ОбщегоНазначенияКлиентСервер.ПреобразоватьСписокВСписокЗначений(Certificate.Получить("alias"), ",");
					СоответствиеКлючей["СтруктураКлюча"] = uzbled_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруИзСпискаЗначений(СписокКлючей, СоответствиеКлючей["СтруктураКлюча"]); 
					СоответствиеКлючей["СтруктураКлюча"].Вставить("active", Истина);
					СоответствиеКлючей["СтруктураКлюча"].Вставить("plugin", "pfx");
					СоответствиеКлючей["ПредставлениеКлюча"] = ПолучитьПредставлениеКлюча(Certificate); //Certificate.Получить("alias"); 
					Если СоответствиеКлючей["СтруктураКлюча"].Свойство("validfrom") Тогда
						СоответствиеКлючей["СтруктураКлюча"].Вставить("validFromDate", ПолучитьДатуИзСтроки(СоответствиеКлючей["СтруктураКлюча"].validfrom, 2)); 
						СоответствиеКлючей["СтруктураКлюча"].Вставить("validToDate", ПолучитьДатуИзСтроки(СоответствиеКлючей["СтруктураКлюча"].validto, 2));
						Если СоответствиеКлючей["СтруктураКлюча"].validToDate < ТекущаяДата()  Тогда
							СоответствиеКлючей["СтруктураКлюча"].Вставить("active", Ложь);
						КонецЕсли;
					Иначе
						СоответствиеКлючей["СтруктураКлюча"].Вставить("active", Ложь);
					КонецЕсли;
					// Получаем ID ключа в 10 системе счисления
					Если СоответствиеКлючей["СтруктураКлюча"].active Тогда
						СоответствиеКлючей["СтруктураКлюча"].Вставить("id", ПеревестиЧислоИзШестнадцатиричногоВДесятичное(СоответствиеКлючей["СтруктураКлюча"].serialnumber));
					КонецЕсли;
					
					МассивКлючей.Добавить(СоответствиеКлючей);
					
				КонецЦикла;
				
			Иначе
				
			КонецЕсли;
			
		КонецЕсли;
		
		ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], МассивКлючей);
		
	#Иначе
		
		ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], Новый Массив);
		
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область ПолучениеКлючаОрганизации

Процедура ПолучениеКлючаОрганизацииНачало(ИНН, ДопПараметры) Экспорт
	
	#Если НЕ ВебКлиент Тогда
		
		ПИНФЛ = ?(ДопПараметры.Свойство("ПИНФЛ"), ДопПараметры["ПИНФЛ"], "");
		
		//УчетнаяЗапись = Неопределено;
		//Если ДопПараметры.Свойство("УчетнаяЗапись", УчетнаяЗапись) И ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		//	ИНН = uzbled_ЭлектронныеДокументыВызовСервера.ПолучитьИННДляАвторизации(УчетнаяЗапись);
		//	ПИНФЛ = uzbled_ЭлектронныеДокументыВызовСервера.ПолучитьПИНФЛДляАвторизации(УчетнаяЗапись);
		//КонецЕсли;
		
		ДопПараметры_ПолучитьЭЦПЗавершение = Новый Структура;
