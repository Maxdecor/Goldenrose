Процедура ПодписатьCreatePKCS7Начало(ОписаниеОповещения, ДопПараметры = Неопределено) Экспорт 
	
	#Если НЕ ВебКлиент Тогда
		
		СоответствиеКлюча = ДопПараметры["СоответствиеКлюча"];	
		
		Если ТипЗнч(СоответствиеКлюча) = Тип("Соответствие") Тогда
			СтруктураКлюча = СоответствиеКлюча.Получить("СтруктураКлюча");
		Иначе
			СтруктураКлюча = СоответствиеКлюча;
		КонецЕсли;
		
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить("any string");
		МассивСтрок.Добавить(СтруктураКлюча.disk);
		МассивСтрок.Добавить(СтруктураКлюча.path);
		МассивСтрок.Добавить(СтруктураКлюча.file_name);
		МассивСтрок.Добавить(СтруктураКлюча.alias);
		
		Адрес = uzbled_EImzoСлужебный.ЗаписатьСтрокиВФайл(МассивСтрок, ".txt", КодировкаТекста.UTF8);
		ДД = ПолучитьИзВременногоХранилища(Адрес);
		ИмяФайла = ПолучитьИмяВременногоФайла(".txt");
		
		ПослеОбновления = Ложь;
		Если ДопПараметры.Свойство("ПослеОбновления") Тогда 
			ПослеОбновления = ДопПараметры["ПослеОбновления"];
		КонецЕсли;
		
		ДопПараметры_ПодписатьCreatePKCS7Продолжение1 = Новый Структура;
		ДопПараметры_ПодписатьCreatePKCS7Продолжение1.Вставить("ОписаниеОповещения", ОписаниеОповещения);
		ДопПараметры_ПодписатьCreatePKCS7Продолжение1.Вставить("СоответствиеКлюча", ДопПараметры["СоответствиеКлюча"]);
		ДопПараметры_ПодписатьCreatePKCS7Продолжение1.Вставить("СтрокаНаПодпись", ДопПараметры["СтрокаНаПодпись"]);
		ДопПараметры_ПодписатьCreatePKCS7Продолжение1.Вставить("ПослеОбновления", ПослеОбновления);
		ДопПараметры_ПодписатьCreatePKCS7Продолжение1.Вставить("ИмяФайла", ИмяФайла);
		
		Оповещение_ПодписатьCreatePKCS7Продолжение1 = Новый ОписаниеОповещения("ПодписатьCreatePKCS7Продолжение1", uzbled_ОбщегоНазначенияКлиентСервер.ОбщийМодуль("uzbled_EImzo"), ДопПараметры_ПодписатьCreatePKCS7Продолжение1);
		
		ДД.НачатьЗапись(Оповещение_ПодписатьCreatePKCS7Продолжение1, ИмяФайла);
		
	#Иначе
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, "");
		
	#КонецЕсли
	
КонецПроцедуры

