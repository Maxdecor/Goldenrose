			ДопПараметры_ПодписатьCreatePKCS7Завершение = Новый Структура;
			ДопПараметры_ПодписатьCreatePKCS7Завершение.Вставить("ОписаниеОповещения", ДопПараметры["ОписаниеОповещения"]);
			
