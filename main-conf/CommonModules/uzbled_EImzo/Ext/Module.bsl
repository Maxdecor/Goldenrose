Процедура ВыполнитьКомандуСистемыЗавершение(ДвоичныеДанные, ДопПараметры = Неопределено) Экспорт
	
	#Если НЕ ВебКлиент Тогда
		
		СистемнаяИнформация = Новый СистемнаяИнформация;
		
		Если СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86
			Или СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда
			
			КомандаВыполненаУспешно = Ложь;
			
			BATFile = ПолучитьИмяВременногоФайла(".bat");
			ДвоичныеДанные.Записать(BATFile);
			
			WSShell = Новый COMОбъект("WScript.Shell");
			
			Попытка
				WSShell.Run("""" + BATFile + """", 0, 1);
				КомандаВыполненаУспешно = Истина;
			Исключение
			КонецПопытки;
			
			Если Не КомандаВыполненаУспешно Тогда
				
				// TODO
				
			КонецЕсли;
			
			Попытка
				УдалитьФайлы(BATFile);
			Исключение
			КонецПопытки;
			
			ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], КомандаВыполненаУспешно);
			
		Иначе
			
			ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], Ложь);
			
		КонецЕсли;
		
	#Иначе
		
		ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], Ложь);
		
	#КонецЕсли
	
КонецПроцедуры

