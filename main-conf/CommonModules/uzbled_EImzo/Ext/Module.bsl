		Иначе
			
			ВыполнитьОбработкуОповещения(Оповещение_ПодписатьCreatePKCS7Продолжение2, Истина);		
			
		КонецЕсли;
		
	#Иначе
		
		ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], "");
		
