			Оповещение_ПодписатьCreatePKCS7Продолжение3 = Новый ОписаниеОповещения("ПодписатьCreatePKCS7Продолжение3", uzbled_ОбщегоНазначенияКлиентСервер.ОбщийМодуль("uzbled_EImzo"), ДопПараметры_ПодписатьCreatePKCS7Продолжение3);
			
			ДД.НачатьЗапись(Оповещение_ПодписатьCreatePKCS7Продолжение3, ИмяФайла);
			
