Процедура ПодписатьCreatePKCS7Завершение(Результат, ДопПараметры = Неопределено) Экспорт
	
	#Если НЕ ВебКлиент Тогда
		
		Если Результат Тогда
			
			ПутьКВыходномуФайлу = ДопПараметры["ПутьКВыходномуФайлу"];
			
			ДД = Новый ДвоичныеДанные(ПутьКВыходномуФайлу);
			СтрокаJSON = uzbled_EImzoСлужебный.ПолучитьТекстИзФайла(ПоместитьВоВременноеХранилище(ДД), ".json");
			
			Если Не ПустаяСтрока(СтрокаJSON) Тогда
				
				ПодписанныйТекст = СтрокаJSON;
				РезультатСоответствие = uzbled_EImzoСлужебный.ПрочитатьСтрокуJSON(СтрокаJSON, Истина);
				
				Если РезультатСоответствие.Получить("success") <> Неопределено
					И РезультатСоответствие.Получить("success") Тогда
					
					ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], ПодписанныйТекст);	
					
				ИначеЕсли НЕ ДопПараметры["ПослеОбновления"] Тогда
					
					ДопПараметры_ПодписатьCreatePKCS7Начало = Новый Структура;
					ДопПараметры_ПодписатьCreatePKCS7Начало.Вставить("СоответствиеКлюча", ДопПараметры["СоответствиеКлюча"]);
