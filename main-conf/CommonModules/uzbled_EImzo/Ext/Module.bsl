					ДопПараметры_ПодписатьCreatePKCS7Начало.Вставить("ПослеОбновления", Истина);
					Оповещение_ПодписатьCreatePKCS7Начало = Новый ОписаниеОповещения("ПодписатьCreatePKCS7Начало", uzbled_ОбщегоНазначенияКлиентСервер.ОбщийМодуль("uzbled_EImzo"), ДопПараметры_ПодписатьCreatePKCS7Начало);
					ВыполнитьОбработкуОповещения(Оповещение_ПодписатьCreatePKCS7Начало, ДопПараметры["ОписаниеОповещения"]);
					
				Иначе
					
					ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], "");
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], "");
			
		КонецЕсли;	
		
	#Иначе
		
		ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], "");
		
