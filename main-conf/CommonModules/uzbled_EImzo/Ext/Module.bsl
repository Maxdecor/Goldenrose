Процедура ПолучениеКлючаОрганизацииЗавершение(Результат, ДопПараметры = Неопределено) Экспорт
	
	#Если НЕ ВебКлиент Тогда
		
		Успешно = Ложь;
		МассивКлючей = Результат;
		ИНН = ДопПараметры["ИНН"];
		ПИНФЛ = ДопПараметры["ПИНФЛ"];
		СтруктураКлюча = Новый Структура;
		
		Для каждого СоответствиеКлюча Из МассивКлючей Цикл
			
			СтруктураКлюча = СоответствиеКлюча["СтруктураКлюча"];
			
			Если СтруктураКлюча["active"] Тогда
				
				alias = СтруктураКлюча["alias"];
				Если 	(ЗначениеЗаполнено(ПИНФЛ) И ПИНФЛ = ПолучитьПИНФЛИзAlias(alias))
					ИЛИ (ЗначениеЗаполнено(ИНН) И ИНН = ПолучитьИННИзAlias(alias)) Тогда
					
					Успешно = Истина;
					Прервать;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], ?(Успешно, СтруктураКлюча, Новый Структура));
		
	#Иначе
		
		ВыполнитьОбработкуОповещения(ДопПараметры["ОписаниеОповещения"], Новый Структура);
		
	#КонецЕсли
	
КонецПроцедуры

