Функция ПолучитьСуммуЗадоженностиПоКонтрагенту(Месяц, Контрагент, Проект)
	
	СуммаЗадоженностиПоКонтрагенту = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(РасчетыСКлиентамиПоСрокамОстатки.ДолгОстаток, 0)) КАК ДолгОстаток
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов.ДополнительныеРеквизиты КАК ДоговорыКонтрагентовДополнительныеРеквизиты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСКлиентамиПоСрокам.Остатки(
		|				&ПериодОстаток,
		|				РасчетныйДокумент ССЫЛКА Документ.РеализацияТоваровУслуг
		|					И АналитикаУчетаПоПартнерам.Контрагент = &Контрагент) КАК РасчетыСКлиентамиПоСрокамОстатки
		|		ПО ДоговорыКонтрагентовДополнительныеРеквизиты.Ссылка = РасчетыСКлиентамиПоСрокамОстатки.АналитикаУчетаПоПартнерам.Договор
		|			И ДоговорыКонтрагентовДополнительныеРеквизиты.Ссылка.Контрагент = РасчетыСКлиентамиПоСрокамОстатки.АналитикаУчетаПоПартнерам.Контрагент
		|ГДЕ
		|	ДоговорыКонтрагентовДополнительныеРеквизиты.Свойство = &Свойство
		|	И ДоговорыКонтрагентовДополнительныеРеквизиты.Значение = &Значение
		|	И РасчетыСКлиентамиПоСрокамОстатки.АналитикаУчетаПоПартнерам.Контрагент = &Контрагент";
		
	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "Проект_f2b5133a590f44d0a8579f3a969ae46a"));
	Запрос.УстановитьПараметр("ПериодОстаток",  Месяц);
	Запрос.УстановитьПараметр("Значение", Проект);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СуммаЗадоженностиПоКонтрагенту = ВыборкаДетальныеЗаписи.ДолгОстаток;
	КонецЕсли; 
	
	Возврат СуммаЗадоженностиПоКонтрагенту;
	
КонецФункции

Функция ПолучитьТекущийЛимит(Контрагент, Проект, Месяц)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОстатокЛимитовОстатки.ЛимитОстаток КАК ЛимитОстаток
		|ИЗ
		|	РегистрНакопления.ОстатокЛимитов.Остатки(
		|			&Период,
		|			Контрагент = &Контрагент
		|				И Проект = &Проект) КАК ОстатокЛимитовОстатки";
	
	Запрос.УстановитьПараметр("Период", Месяц);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Проект", Проект);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат РезультатЗапроса.ЛимитОстаток;
	Иначе
		Возврат 0;
	КонецЕсли;
	
	
КонецФункции
