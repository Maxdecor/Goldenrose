Процедура ПроверитьКодыМаркировки(Команда)
	
	//Если Не РазрешеноПодключаться() Тогда 
	//	Возврат;
	//КонецЕсли; 
	
	Если Организация.Пустая() тогда
		Сообщить("Выберите организацию !");
		возврат;
	КонецЕсли;
	
	ЕстьНесуществующиеКоды = Истина;
	ПослеАвторизации = Ложь;
	
	//УдаляетПустоеЗначениеИзСписок();
	КодыРазныхТиповТоваров.Очистить();
	СтатусыСОшибками.Очистить(); 
	KoдыРазныхGTIN.Очистить();
	КодыРазныхЕмкостей.Очистить();
	КодыРазныхУпаковокТоваров.Очистить();
	НесуществующиеКоды.Очистить();
	
	КодыМаркировки = ПолучитьВсеКодыМаркировки();
	Если КодыМаркировки.Количество() > 100 Тогда 
		//ПоказатьПредупреждение(, НСтр("ru = 'Обработка запросов требует времени потому, что у вас более 100 кодов. Пожалуйста, отметьте кнопку ""Запомнить на 6 часов"", чтобы срок действия токена не истек!'"));
	КонецЕсли;	
	
	СинхронизоватьКодыМаркировкиССайтом(КодыМаркировки, Истина);
	
	ТекстСообщения = НСтр("ru = 'Синхронизация завершена!'");
	//ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	Сообщить(ТекстСообщения);
		
КонецПроцедуры

&НаСервере
Функция ПолучитьВсеКодыМаркировки()
	
	КодыМаркировки = Новый Массив;
	
	//ПотребительскиеКодыМаркировки = ПотребительскихСписокКодовМаркировки.ВыгрузитьЗначения();
	//ГрупповыеКодыМаркировки       = ГрупповыхСписокКодовМаркировки.ВыгрузитьЗначения();
	//ТранспортныеКодыМаркировки	  = ТранспортныхСписокКодовМаркировки.ВыгрузитьЗначения();   
	
	ПотребительскиеКодыМаркировки = Новый Массив;
	ГрупповыеКодыМаркировки = Новый Массив;
	ТранспортныеКодыМаркировки = Новый Массив;

	
	Для Каждого ТабСтр из Объект.КодыСписок Цикл
		Если ТабСтр.УровеньУпаковки=0 тогда
			ПотребительскиеКодыМаркировки.Добавить(ТабСтр.Товар);
		ИначеЕсли ТабСтр.УровеньУпаковки=1 тогда
			ГрупповыеКодыМаркировки.Добавить(ТабСтр.Товар);
		иначе
			ТранспортныеКодыМаркировки.Добавить(ТабСтр.Товар);
		Конецесли;	
	КонецЦикла;
	
	//ОбщегоНазначения.ЗаполнитьМассивУникальнымиЗначениями(КодыМаркировки, ПотребительскиеКодыМаркировки);
	//ОбщегоНазначения.ЗаполнитьМассивУникальнымиЗначениями(КодыМаркировки, ГрупповыеКодыМаркировки);
	//ОбщегоНазначения.ЗаполнитьМассивУникальнымиЗначениями(КодыМаркировки, ТранспортныеКодыМаркировки);
	
	//ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивПриемник, МассивИсточник, Истина);
	//ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КодыМаркировки, ПотребительскиеКодыМаркировки, Истина);
	//ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КодыМаркировки, ГрупповыеКодыМаркировки, Истина);
	//ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КодыМаркировки, ТранспортныеКодыМаркировки, Истина);
	ДополнитьМассив(КодыМаркировки, ПотребительскиеКодыМаркировки, Истина);
	ДополнитьМассив(КодыМаркировки, ГрупповыеКодыМаркировки, Истина);
	ДополнитьМассив(КодыМаркировки, ТранспортныеКодыМаркировки, Истина);
	
	Возврат КодыМаркировки;
	
КонецФункции

Процедура ДополнитьМассив(МассивПриемник, МассивИсточник, ТолькоУникальныеЗначения = Ложь) Экспорт
	
	Если ТолькоУникальныеЗначения Тогда
		
		УникальныеЗначения = Новый Соответствие;
		
		Для Каждого Значение Из МассивПриемник Цикл
			УникальныеЗначения.Вставить(Значение, Истина);
		КонецЦикла;
		
		Для Каждого Значение Из МассивИсточник Цикл
			Если УникальныеЗначения[Значение] = Неопределено Тогда
				МассивПриемник.Добавить(Значение);
				УникальныеЗначения.Вставить(Значение, Истина);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Для Каждого Значение Из МассивИсточник Цикл
			МассивПриемник.Добавить(Значение);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуДляМаркировки()
	
	Таблица = Новый ТаблицаЗначений;
	
	//Таблица.Колонки.Добавить("Код", ОбщегоНазначения.ОписаниеТипаСтрока(250));
	Таблица.Колонки.Добавить("Код", ОписаниеТипаСтрока(250));
	Таблица.Колонки.Добавить("GTIN", Метаданные.ОпределяемыеТипы.GTIN.Тип);
	Таблица.Колонки.Добавить("НаименованиеТовара", ОписаниеТипаСтрока(250));
	Таблица.Колонки.Добавить("ТипТовара", Новый ОписаниеТипов("ПеречислениеСсылка.ОсобенностиУчетаНоменклатуры"));     
	Таблица.Колонки.Добавить("ТипУпаковки", Новый ОписаниеТипов("ПеречислениеСсылка.ВариантыИспользованияЕдиницыХраненияИСМП"));
	Таблица.Колонки.Добавить("УровеньУпаковки", ОбщегоНазначения.ОписаниеТипаЧисло(2));
	Таблица.Колонки.Добавить("ЕмкостьУпаковки", ОбщегоНазначения.ОписаниеТипаЧисло(5));
	Таблица.Колонки.Добавить("СтатусКода", Новый ОписаниеТипов("ПеречислениеСсылка.aslbelgisi_СтатусКодовМаркировки"));
	Таблица.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Булево"));
	
	Возврат Таблица;
	
КонецФункции

&НаСервере
Функция ОписаниеТипаСтрока(ДлинаСтроки) Экспорт

	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));

	КвалификаторСтроки = Новый КвалификаторыСтроки(ДлинаСтроки, ДопустимаяДлина.Переменная);

	Возврат Новый ОписаниеТипов(Массив, , КвалификаторСтроки);

КонецФункции

&НаКлиенте
Процедура СинхронизоватьКодыМаркировкиССайтом(КодыМаркировки, ТолькоПроверить)
	
	ТаблицаКодов = Новый Массив;
	Токен = ПолучитьТокен(Организация);
	
	ДанныеИзСайта = ПолучитьДанныеДляКодовМаркировки(Токен, КодыМаркировки, ТаблицаКодов);	
	
	Если ДанныеИзСайта.ТипОшибки = ПредопределенноеЗначение("Перечисление.aslbelgisi_ВидыОшибок.ОшибкаАутентификации") Тогда 
		
		Если ПослеАвторизации = Истина Тогда 
			ТекстСообщения = НСтр("ru = 'Произошли ошибки при авторизации!'");
			//ОбщегоНазначенияКлиент_ненужен.СообщитьПользователю(ТекстСообщения);
			Сообщить(ТекстСообщения);
			Возврат;
		КонецЕсли;

		ПодписанныйТекст = "";
		СтруктураОтвета = АвторизацияНачало();
		
		Если СтруктураОтвета = Неопределено Тогда 
			ТекстСообщения = НСтр("ru = 'Произошли ошибки при авторизации: Не удалось подключиться к сервису!'");
			//ОбщегоНазначенияКлиент_ненужен.СообщитьПользователю(ТекстСообщения);
			Сообщить(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		СтрокаНаПодпись = СтруктураОтвета.Получить("data");
		Идентификатор = СтруктураОтвета.Получить("uuid");
		
		ПолучениеКлючаОрганизацииНачало();
		ОтправитьПодписатьСтроку(КодыМаркировки, ТолькоПроверить);
		Возврат;
		
	ИначеЕсли ДанныеИзСайта.ТипОшибки = ПредопределенноеЗначение("Перечисление.aslbelgisi_ВидыОшибок.НекорректныйЗапрос") Тогда 
		
		//ТекстСообщения = СтрШаблон(ДанныеИзСайта.ТекстОшибки);
		ТекстСообщения = ДанныеИзСайта.ТекстОшибки;
		//ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Сообщить(ТекстСообщения);
		
		МассивВТаблицуЗначенийПоКоду(ПолучитьВсеКодыМаркировки());		
		РаботаСНеправильнымиКодамиНачало();    
		
	ИначеЕсли ДанныеИзСайта.ТипОшибки = ПредопределенноеЗначение("Перечисление.aslbelgisi_ВидыОшибок.ВнутренняяОшибкаСервиса") Тогда 
		
		//ТекстСообщения = СтрШаблон(ДанныеИзСайта.ТекстОшибки);
		ТекстСообщения = ДанныеИзСайта.ТекстОшибки;
		//ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Сообщить(ТекстСообщения);
		
	Иначе

		Если ТаблицаКодов.Количество()=0 тогда 
			Сообщить("Все указанные коды в AslBelgisi не найдены!");  
			Возврат;

		иначеЕсли ТолькоПроверить=Ложь и ТаблицаКодов.Количество()>0 тогда     // Запись распакованных кодов   
			ЗаписатьРаспакованныеКоды(ТаблицаКодов);
			
		Иначе  
			
			
			АгрегационныеКоды = ПроверитьЗаписатьКодыМаркировки(ТаблицаКодов, СобратьСтруктуруМаркировки(), ТолькоПроверить);
			
						
			//Если АгрегационныеКоды.Количество() Тогда 
			//	СинхронизоватьКодыМаркировкиССайтом(АгрегационныеКоды, ТолькоПроверить);	
			//	Возврат;
			//КонецЕсли;
			
		КонецЕсли;
		
		РаботаСНеправильнымиКодамиНачало();
	КонецЕсли;	
	
КонецПроцедуры

#Область ПолучениеКлючаОрганизации

