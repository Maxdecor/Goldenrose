	Результат.Вставить("ПотребительскиеКоды", ПотребительскиеКоды);
	
	// Групповые коды
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ  
		|	ОбщиеКоды.КодМаркировки КАК КодМаркировки,
		|	ОбщиеКоды.Пометка КАК Пометка
		|ПОМЕСТИТЬ ВТ_ОбщиеКоды
		|ИЗ
		|	&ОбщиеКоды КАК ОбщиеКоды
		|ГДЕ
		|	ОбщиеКоды.ТипУпаковки = &ТипУпаковки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОбщиеКоды.КодМаркировки КАК КодМаркировки,
