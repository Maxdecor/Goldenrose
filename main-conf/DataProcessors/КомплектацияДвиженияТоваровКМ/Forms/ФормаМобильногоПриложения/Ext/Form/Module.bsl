		|ИЗ
		|	ВТ_ОбщиеКоды КАК ВТ_ОбщиеКоды";
	
	Запрос.УстановитьПараметр("ОбщиеКоды", ИсправленнаяТаблица);
	Запрос.УстановитьПараметр("ТипУпаковки", Перечисления.ВариантыИспользованияЕдиницыХраненияИСМП.ГрупповаяУпаковка);
	ГрупповыеКоды1 = ОбщегоНазначения.ТаблицаЗначенийВМассив(Запрос.Выполнить().Выгрузить());
	Результат.Вставить("ГрупповыеКоды", ГрупповыеКоды1);
	
	// Транспортные коды
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОбщиеКоды.КодМаркировки КАК КодМаркировки,
		|	ОбщиеКоды.Пометка КАК Пометка
		|ПОМЕСТИТЬ ВТ_ОбщиеКоды
