&НаСервере	
Функция ПроверитьЗапись(Запись,НомерСтроки) 
	SGTIN=СокрЛП(Запись.КодSSCC1)+" "+Лев(Запись.КодМаркировки,31); 
	ФлОшибПров=0;
	Если Объект.ДокументОснование=неопределено тогда
		Сообщить("строка "+Строка(НомерСтроки)+" КМ "+SGTIN+" уже записан!"); 
		ФлОшибПров=1;
	ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") тогда //расход  
		Если Запись.Статус<2 тогда
			Сообщить("строка "+Строка(НомерСтроки)+" КМ "+SGTIN+" не оприходован!") ; 
			ФлОшибПров=1;
		ИначеЕсли Запись.Статус>2 Тогда
			Если  Объект.ДокументОснование.Ссылка<>Запись.ДокументРасхода.Ссылка тогда
				Сообщить("строка "+Строка(НомерСтроки)+" КМ "+SGTIN+" уже связан с другим документом реализации!");
			иначе
				Сообщить("строка "+Строка(НомерСтроки)+" КМ "+SGTIN+" уже записан!");
			КонецЕсли;	
			ФлОшибПров=1;
		КонецЕсли;
	иначе
		Если Запись.Статус>2 тогда
			Сообщить("строка "+Строка(НомерСтроки)+" КМ "+SGTIN+" уже в обороте - есть связь с документом реализации!"); 
			ФлОшибПров=1;
		ИначеЕсли Запись.Статус<>0 Тогда
			Если Объект.ДокументОснование.Ссылка<>Запись.ДокументПрихода.Ссылка тогда
				Сообщить("строка "+Строка(НомерСтроки)+" КМ "+SGTIN+" уже связан с "+Запись.ДокументПрихода.Ссылка);
			иначе	
				Сообщить("строка "+Строка(НомерСтроки)+" КМ "+SGTIN+" уже записан!");
			КонецЕсли;	
			ФлОшибПров=1;
		КонецЕсли;	
	КонецЕсли; 

	Возврат ФлОшибПров;
КонецФункции

&НаКлиенте
Функция КонтрольПоДокументу(GTIN,КоличКодов,НомерСтроки,СтрокаДокументаВыбор);
	
	ФлGTIN=0;
	ФлВыборСтроки=0;
	СтрокаДокументаВыбор=Новый Структура;
	
	Остаток=КоличКодов;
	Откат=Новый Массив(Объект.Контроль.Количество()+1);
	
	Для Каждого СтрокаДок из Объект.Контроль Цикл
		
		Если СтрокаДок.ВыборСтроки=Ложь тогда продолжить;
		КонецЕсли;
		
		ФлВыборСтроки=1;
		НомерСерии=""; 
		
		
		Откат[СтрокаДок.НомерСтроки]=СтрокаДок.КоличествоКМ; // сохраним старое значение
		
		Если СтрокаДок.GTIN<>GTIN  тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаДок.GTIN=GTIN Тогда 
			
			Если ФлGTIN=0 тогда 
				СтрокаДокументаВыбор.Вставить("GTIN",GTIN);
				СтрокаДокументаВыбор.Вставить("Номенклатура",СтрокаДок.Номенклатура); 
				СтрокаДокументаВыбор.Вставить("НомерСерии",СтрокаДок.НомерСерии);
				//СтрокаДокументаВыбор.Вставить("Емкость",СтрокаДок.Емкость); 
				ФлGTIN=1;
			КонецЕсли;
			
			Разность=СтрокаДок.Количество-СтрокаДок.Сертификация-СтрокаДок.КоличествоКМ;
			Если Разность>=Остаток тогда
				СтрокаДок.КоличествоКМ=СтрокаДок.КоличествоКМ+Остаток;
				Остаток=0;
			иначе
				СтрокаДок.КоличествоКМ=СтрокаДок.КоличествоКМ+Разность;
				Остаток=Остаток-Разность;
			КонецЕсли;
			
			//Если СтрокаДок.Емкость<>0 Тогда
			//	СтрокаДок.КоличествоУпаковок=Цел(СтрокаДок.КоличествоКМ/СтрокаДок.Емкость);
			//КонецЕсли;	
			
			Если Остаток=0 тогда прервать;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	Если ФлВыборСтроки=0 и Не Объект.ДокументОснование=Неопределено тогда 
		Сообщить("Выберите строку(строки при совпадении серий) для подсчета введеных кодов "); 
		Возврат Ложь;
		
	ИначеЕсли ФлGTIN=0 и Не Объект.ДокументОснование=Неопределено тогда 
		Сообщить("строка "+Строка(НомерСтроки)+"GTIN в документе не найден!"); 
		Возврат Ложь;
	КонецЕсли;
	
	Если Остаток>0  тогда 
		Сообщить("строка "+Строка(НомерСтроки)+" количество единиц  товара в КМ превышает количество в документе!");
		// восстановим старые значения
		Для Каждого СтрокаДок из Объект.Контроль Цикл
			Если Откат[СтрокаДок.НомерСтроки]= Неопределено тогда продолжить;
			КонецЕсли;
			СтрокаДок.КоличествоКМ=Откат[СтрокаДок.НомерСтроки] // восстановим старое значение
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции
		
&НаКлиенте
Процедура ТоварыСписокТоварПриИзменении(Элемент)
	
	Если  Не ОкончаниеВводаТекста тогда  Возврат;
	КонецЕсли;
	
	ОкончаниеВводаТекста=Ложь;
	
	
	ТабСтрока=Элементы.ТоварыСписок.ТекущиеДанные;
	//КМ=ТабСтрока.Товар;  
	УбратьКодПроверкиИКриптохвост(ТабСтрока.Товар,УпаковкаУровень,ТипТовара);

	//Если Сред(КМ,32,1)=Символ(29) и Сред(КМ,39,1)=Символ(29) тогда
	//	КМ1=Сред(КМ,1,31); 
	//	КМ2=Сред(КМ,33,6);      
	//	КМ3=Сред(КМ,40);      
	//	
	//	КМ=КМ1+КМ2+КМ3;
	//	
	//	// убираем символы 029
	//иначеЕсли Сред(КМ,32,3)="029" и Сред(КМ,41,3)="029" тогда
	//	КМ1=Сред(КМ,1,31); 
	//	КМ2=Сред(КМ,35,6);      
	//	КМ3=Сред(КМ,44);      
	//	
	//	КМ=КМ1+КМ2+КМ3;
	//КонецЕсли; 
	
	//Если НеПолныйКод и СтрДлина(КМ)>31 Тогда
	//	КМ=Лев(КМ,31);
	//КонецЕсли;
	
	//ТабСтрока.Товар=КМ;
	
	// проверка на повтор ввода  
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Товар", ТабСтрока.Товар);
	МассивСтрок = Объект.КодыСписок.НайтиСтроки(ПараметрыОтбора);
	Если МассивСтрок.Количество()>1 тогда
		//Сообщить("строка "+Строка(ТабСтрока.НомерСтроки)+" Повтор КМ при вводе!(строка "+Строка(МассивСтрок[0].номерстроки)+")") ; 
		Сообщить("Повтор КМ при вводе!(строка "+Строка(МассивСтрок[0].номерстроки)+")") ; 
		ТабСтрока.Проверка=Ложь;
		ОшибкаВвода=Истина;
		ТабСтрока.Товар="";
		Возврат;
	КонецЕсли;	
	
	СтрокаДокументаВыбор=ПолучитьДанныеСтрокиДокумента(); 
	
	Если Лев(ТабСтрока.Товар,2)="01" и Сред(ТабСтрока.Товар,17,2)="21"  тогда 
		Если ТипУпаковки=ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ТранспортнаяУпаковка") тогда 
			Сообщить("Несоответствие структуры КМ выбраннму типу упаковки! (строка "+Строка(МассивСтрок[0].номерстроки)+")") ; 
			ТабСтрока.Проверка=Ложь;
			ОшибкаВвода=Истина;
			//ТабСтрока.Товар="";
			возврат;
		КонецЕсли;
		
		ТабСтрока.GTIN=Сред(ТабСтрока.Товар,3,14);
		// поищем в справочнике 
		НоменклатураСсылка=ПолучитьНоменклатуруНаСервере(ТабСтрока.GTIN);
		Если НоменклатураСсылка.Пустая() тогда
			Сообщить("строка "+Строка(ТабСтрока.НомерСтроки)+" Номенклатура по GTIN не найдена!") ; 
			ТабСтрока.Проверка=Ложь;
			ОшибкаВвода=Истина;
			Возврат;
		КонецЕсли;
		
		ТабСтрока.Номенклатура=НоменклатураСсылка;
	Иначе 
		Если ТипУпаковки=ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ПотребительскаяУпаковка") или 
			ТипУпаковки=ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ГрупповаяУпаковка") тогда 
			Сообщить("Несоответствие структуры КМ выбранному типу упаковки! (строка "+Строка(МассивСтрок[0].номерстроки)+")") ; 
			ТабСтрока.Проверка=Ложь;
			ОшибкаВвода=Истина;
			//ТабСтрока.Товар="";
			возврат;
		КонецЕсли;
		
		//для транспортных кодов - по документу;
		ТабСтрока.GTIN=СтрокаДокументаВыбор.GTIN;
		ТабСтрока.Номенклатура=СтрокаДокументаВыбор.Номенклатура;
	КонецЕсли;	
	
	ТабСтрока.Количество=УпаковкаКоличество;      // зависит от выбраной упаковки 
	ТабСтрока.ЕмкостьУпаковки=Емкость;      
	ТабСтрока.УровеньУпаковки=УпаковкаУровень; 
	ТабСтрока.ТипУпаковки=ТипУпаковки; 
	ТабСтрока.НомерСерии=СтрокаДокументаВыбор.НомерСерии;   // предварительная запись

	ФлОшиб=0;
	
	Запись=ПрочитатьЗаписьИзРеестра(Табстрока.Товар);
	
	Если Запись.Выбран тогда 
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг")и Разагрегация=Истина тогда
			Сообщить("строка "+Строка(ТабСтрока.НомерСтроки)+" Разагрегация: код КМ "+ ТабСтрока.Товар+" в реестре уже есть! Код коробки "+Запись.КодSSCC1) ; 
			ФлОшиб=1;
		иначе
			ТабСтрока.КодSSCC1=Запись.КодSSCC1;
			ТабСтрока.Статус=Запись.Статус;
			ТабСтрока.ДокументПрихода=Запись.ДокументПрихода;
			ТабСтрока.ДокументРасхода=Запись.ДокументРасхода; 
			ТабСтрока.НомерСерии=Запись.НомерСерии;
			
			Если ТабСтрока.ЕмкостьУпаковки<>Запись.ЕмкостьУпаковки и Запись.Статус >0 тогда
				Сообщить("строка "+Строка(ТабСтрока.НомерСтроки)+" Емкость упаковки не совпадает с емкостью  в реестре уже записанного КМ ") ; 
				ФлОшиб=1;
			КонецЕсли;	 
			
			// проверка серии
			
			
			Если СокрЛП(Запись.НомерСерии)="" и Запись.Статус=0 тогда
			     ТабСтрока.НомерСерии=СтрокаДокументаВыбор.НомерСерии;   // код введен без документа или был очищен
			ИначеЕсли СокрЛП(ТабСтрока.НомерСерии)<>СокрЛП(СтрокаДокументаВыбор.НомерСерии)  тогда
				Сообщить("строка "+Строка(ТабСтрока.НомерСтроки)+" Серия КМ не совпадает с серией выбраной строки документа!") ; 
				ФлОшиб=1;
			иначе	
				ФлОшибЗап=ПроверитьЗапись(Запись,ТабСтрока.Номерстроки);  /////////....\\
				Если ФлОшибЗап=1 тогда
					ФлОшиб=1;
				КонецЕсли;
			КонецЕсли;	 
		КонецЕсли;	 
			
	ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") тогда
		
		Если Разагрегация тогда   // ищем агрегатный код 
			
			Запись=ПрочитатьЗаписьИзРеестра(КодАгрегации);

			Если Запись.Выбран тогда
				ТабСтрока.КодSSCC1=КодАгрегации;
				ТабСтрока.Статус=Запись.Статус;
				ТабСтрока.Номенклатура=Запись.Номенклатура;
				ТабСтрока.ДокументПрихода=Запись.ДокументПрихода;
				ТабСтрока.ДокументРасхода=Запись.ДокументРасхода; 
				ТабСтрока.НомерСерии=Запись.НомерСерии;
				ТабСтрока.ЕмкостьУпаковки=Запись.ЕмкостьУпаковки;
				ТабСтрока.Количество=Запись.Количество;
				ТабСтрока.НовыйКод=Истина;
				Введено=Введено+1;
				Если Введено>Запись.ЕмкостьУпаковки тогда
					Сообщить("строка "+Строка(ТабСтрока.НомерСтроки)+" Количество введенных КМ превышает емкость упаковки! ") ; 
					ФлОшиб=1;
				КонецЕсли;
			Иначе
				Сообщить("строка "+Строка(ТабСтрока.НомерСтроки)+" Код Разагрегации в реестре не найден! Разагрегация не возможна!") ; 
				ФлОшиб=1;
			КонецЕсли;
		Иначе	
			Сообщить("строка "+Строка(ТабСтрока.НомерСтроки)+" КМ нет в реестре! Реализация не возможна!") ; 
			ФлОшиб=1;
		КонецЕсли;
		
	КонецЕсли;

	Если ФлОшиб=1 тогда 
		ТабСтрока.Проверка=Ложь; 
		ОшибкаВвода=Истина;
		Возврат;
		// проверка соответствия документу 
	иначеЕсли объект.ДокументОснование <> неопределено тогда
		СтрокаДокумента=Неопределено;
		Если Не КонтрольПоДокументу(ТабСтрока.GTIN,ТабСтрока.Количество,ТабСтрока.НомерСтроки,СтрокаДокумента) тогда
			ТабСтрока.Проверка=Ложь; 
			ОшибкаВвода=Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
			
	ТабСтрока.Проверка=Истина;
	//Если СтрокаДокумента.Количество()>0 тогда // структура заполнена 
	//	ТабСтрока.НомерСерии=СтрокаДокумента.НомерСерии;
	//	ТабСтрока.ЕмкостьУпаковки=СтрокаДокумента.Емкость;
	//КонецЕсли;
		
	Если Объект.ДокументОснование=Неопределено и СокрЛП(ТабСтрока.КодSSCC1)="" тогда
		ТабСтрока.КодSSCC1=КодАгрегации; 
		Введено=Введено+1; 
		Если Емкость<>0 Тогда
			ВведеноУпаковок=Цел(введено/емкость);
		КонецЕсли;
		
		Если Введено=1 тогда
			Элементы.КодАгрегации.Доступность=Ложь;
			Элементы.Емкость.Доступность=Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	ЭтаФорма.ОбновитьОтображениеДанных(Элементы.Контроль);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСписокКодSSCC1ОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	ОшибкаВвода=Ложь;
	
	ТабСтрока=Элементы.ТоварыСписок.ТекущиеДанные;
	КодSSCC1=Элемент.ТекстРедактирования;   
	
	// проверка на повтор ввода  
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("КодSSCC1", КодSSCC1);
	МассивСтрок = Объект.КодыСписок.НайтиСтроки(ПараметрыОтбора);
	Если МассивСтрок.Количество()>0 тогда
		Сообщить("Повтор Кода коробки при вводе!(строка "+Строка(МассивСтрок[0].номерстроки)+")") ;
		Текст="";
		Ошибкаввода=Истина;
		СтандартнаяОбработка=ложь; 
		
		//wsh1=Новый COMОбъект("WScript.Shell"); 
		//wsh1.SendKeys("{Esc}"); 
		wsh.SendKeys("{Esc}"); 
	КонецЕсли;
	
	Если ОшибкаВвода=Ложь Тогда
		ОкончаниеВводаТекста=Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьКодSSCC1ВРеестре(НомерСтроки,КодSSCC,СтрокаДокумента)
	
	Результат=Новый Соответствие;
	
	// поиск в реестре
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КодыМаркировки.КодМаркировки КАК КодМаркировки,
		|	КодыМаркировки.Номенклатура КАК Номенклатура,
		|	КодыМаркировки.Статус КАК Статус,
		|	КодыМаркировки.ДокументПрихода КАК ДокументПрихода,
		|	КодыМаркировки.ДокументРасхода КАК ДокументРасхода,
		|	КодыМаркировки.Номенклатура.GTIN КАК GTIN,
		|	КодыМаркировки.КоличествоЕдиницТовара КАК КоличествоЕдиницТовара,
		|	КодыМаркировки.КодSSCC1 КАК КодSSCC1,
		|	КодыМаркировки.НомерСерии КАК НомерСерии,
		|	КодыМаркировки.ЕмкостьУпаковки КАК ЕмкостьУпаковки
		|ИЗ
		|	РегистрСведений.КодыМаркировки КАК КодыМаркировки
		|ГДЕ
		|	КодыМаркировки.КодSSCC1 = &КодSSCC
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура";
	
	Запрос.УстановитьПараметр("КодSSCC", КодSSCC);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	ФлОшиб=0; 
	КоличКм=0;

	Если ВыборкаДетальныеЗаписи.Количество()=0 тогда  
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") тогда	
			Сообщить("строка "+Строка(НомерСтроки)+" Код упаковки в реестре КМ не найден!") ;   
			ФлОшиб=1;
		иначе // по документу
			//СтрокаДокумента=ПолучитьДанныеСтрокиДокумента();
			GTIN0=СтрокаДокумента.GTIN;
			Номенклатура0=СтрокаДокумента.Номенклатура;	
			НомерСерии0=СтрокаДокумента.НомерСерии;
			//ЕмкостьУпаковки0=СтрокаДокумента.Емкость;
			//КоличКМ=ЕмкостьУпаковки0;
		КонецЕсли;
	ИначеЕсли ВыборкаДетальныеЗаписи.Количество()=1 и 
		ВыборкаДетальныеЗаписи.КодSSCC1=ВыборкаДетальныеЗаписи.КодМаркировки тогда  // целая коробка 	
		
		ВыборкаДетальныеЗаписи.Следующий();		
		КоличКм=ВыборкаДетальныеЗаписи.КоличествоЕдиницТовара;
		GTIN0=ВыборкаДетальныеЗаписи.GTIN;
		Номенклатура0=ВыборкаДетальныеЗаписи.Номенклатура;	
		Статус0=ВыборкаДетальныеЗаписи.Статус;
		ДокПрихода0=ВыборкаДетальныеЗаписи.ДокументПрихода;
		ДокРасхода0=ВыборкаДетальныеЗаписи.ДокументРасхода;
		НомерСерии0=ВыборкаДетальныеЗаписи.НомерСерии;
		ЕмкостьУпаковки0=ВыборкаДетальныеЗаписи.ЕмкостьУпаковки;
		ФлОшибЗап=ПроверитьЗапись(ВыборкаДетальныеЗаписи,НомерСтроки);
		Если ФлОшибЗап=1 тогда
			ФлОшиб=1;
		КонецЕсли;

	иначе
		// проверка комплектности и подсчет количества кодов
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
			Если ВыборкаДетальныеЗаписи.КодSSCC1=ВыборкаДетальныеЗаписи.КодМаркировки тогда
				продолжить; //разагрегированный код
			КонецЕсли;
			Если КоличКМ=0 тогда // первый вход
				GTIN0=ВыборкаДетальныеЗаписи.GTIN;
				Номенклатура0=ВыборкаДетальныеЗаписи.Номенклатура;	
				Статус0=ВыборкаДетальныеЗаписи.Статус;
				ДокПрихода0=ВыборкаДетальныеЗаписи.ДокументПрихода;
				ДокРасхода0=ВыборкаДетальныеЗаписи.ДокументРасхода; 
				НомерСерии0=ВыборкаДетальныеЗаписи.НомерСерии;
				ЕмкостьУпаковки0=ВыборкаДетальныеЗаписи.ЕмкостьУпаковки;
			КонецЕсли;	
			Запись=Регистрысведений.КодыМаркировки.СоздатьМенеджерЗаписи(); 
			Запись.КодМаркировки=ВыборкаДетальныеЗаписи.КодМаркировки; 
			Запись.Прочитать();
			Если Запись.Выбран() тогда 
				Если  Запись.Номенклатура.GTIN=GTIN0 и Запись.Статус=Статус0
					и Запись.ДокументПрихода=ДокПрихода0 и Запись.ДокументРасхода=ДокРасхода0 тогда 
					КоличКм=КоличКм+1; 
				КонецЕсли;
				ФлОшибЗап=ПроверитьЗапись(Запись,НомерСтроки);
				Если ФлОшибЗап=1 тогда
					 ФлОшиб=1;
                КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если КоличКМ<>ВыборкаДетальныеЗаписи.Количество() тогда
			Сообщить("строка "+Строка(НомерСтроки)+" Нарушение комплектности КМ в упаковке!(разные характеристики)") ;
			ФлОшиб=1;
		КонецЕсли;	
	КонецЕсли;

	Результат.Вставить("ФлОшиб",ФлОшиб);
	Результат.Вставить("КоличКМ",КоличКМ);

	Если ФлОшиб=0 тогда 
		Результат.Вставить("GTIN",GTIN0);
		Результат.Вставить("Номенклатура",Номенклатура0);
		Результат.Вставить("Статус",Статус0);
		Результат.Вставить("ДокПрихода",ДокПрихода0);
		Результат.Вставить("ДокРасхода",ДокРасхода0);
		Результат.Вставить("НомерСерии",НомерСерии0);
		//Результат.Вставить("ЕмкостьУпаковки",ЕмкостьУпаковки0);
	КонецЕсли;

	Возврат Результат;

КонецФункции	
	
	
