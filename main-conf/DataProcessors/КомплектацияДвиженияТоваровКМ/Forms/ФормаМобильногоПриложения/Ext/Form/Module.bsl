						Если НайденныеСтроки.Количество()>0 тогда   
							Запись.КодSSCC1=НайденныеСтроки[0].КодSSCC1;
							Запись.Номенклатура=НайденныеСтроки[0].Номенклатура;
							Запись.НомерСерии=НайденныеСтроки[0].НомерСерии;
							Запись.КоличествоЕдиницТовара=НайденныеСтроки[0].Количество;
							Запись.ТипУпаковки=НайденныеСтроки[0].ТипУпаковки;
							Запись.ЕмкостьУпаковки=НайденныеСтроки[0].ЕмкостьУпаковки;
						КонецЕсли;
						
						Запись.Записать(); 
						
					ИначеЕсли (мСтатус=3 или мСтатус=4) и Запись.Статус=2 тогда
						Запись.ДокументРасхода=Объект.ДокументОснование;
						Запись.Статус=мСтатус;
						Запись.Записать(); 
					КонецЕсли;	 
				КонецЕсли;
				
				Инд=МассивКодов.Найти(Выборка.КодМаркировки);
				Если Не Инд=Неопределено тогда
					МассивКодов.Удалить(инд);
				КонецЕсли;	
			КонецЦикла; 
		конецЕсли;
		
		// запись оставшихся новых кодов 
		//Если ТипЗнч(Объект.ДокументОснование) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") тогда
			Для Каждого ТабСтр из Объект.КодыСписок Цикл
				//Если ТабСтр.Товар<>"" тогда
					ЗначениеКода=ТабСтр.Товар;
				//Иначе
				//	//ЗначениеКода=ТабСтр.КодSSCC1;
				//КонецЕсли;	
				
				Инд=МассивКодов.Найти(ЗначениеКода);
				Если Инд=Неопределено тогда
					продолжить;
				КонецЕсли;	
				
				Запись=Регистрысведений.КодыМаркировки.СоздатьМенеджерЗаписи(); 
				Запись.КодМаркировки=ТабСтр.Товар; 
				Запись.Прочитать();
				Если Не Запись.Выбран() тогда
					Запись.КодSSCC1=ТабСтр.КодSSCC1;
					Запись.КодМаркировки=ЗначениеКода;;
					Запись.КоличествоЕдиницТовара=ТабСтр.Количество;
					Запись.Номенклатура=ТабСтр.Номенклатура;
					Запись.НомерСерии=ТабСтр.НомерСерии; 
					Запись.ТипУпаковки=ТабСтр.ТипУпаковки;
					Запись.ЕмкостьУпаковки=ТабСтр.ЕмкостьУпаковки;
					Запись.Статус=мСтатус;
					Если мСтатус=1 или мСтатус=2 тогда
						Запись.ДокументПрихода=Объект.ДокументОснование;
					ИначеЕсли мСтатус=3 или мСтатус=4 тогда         // только если разагрегация
						Запись.ДокументПрихода=ТабСтр.ДокументПрихода; 
						Запись.ДокументРасхода=Объект.ДокументОснование; 	
					КонецЕсли;
					Запись.Записать();
					// корректировка количества записи-коробки 
					Если мСтатус=3 или мСтатус=4 тогда   // только если разагрегация
						Запись.КодМаркировки=ТабСтр.КодSSCC1; 
						Запись.Прочитать();
						Если Запись.Выбран() тогда
							Запись.КоличествоЕдиницТовара=Запись.КоличествоЕдиницТовара-1;	
							Запись.Записать();
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;	
		//КонецЕсли;
		Если Объект.ДокументОснование=Неопределено тогда 
			Сообщить("Выполнена запись кодов маркировки в реестр "); 
		Иначе
			// обновить таблицу импорта 
			Для Каждого ТабСтр из Объект.КодыСписок Цикл
				Если ТабСтр.Проверка=Ложь тогда
					Продолжить;
				КонецЕсли;
				
				ТабСтр.Статус=мСтатус;
				Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") тогда //приход
					ТабСтр.ДокументПрихода=Объект.ДокументОснование;
				Иначе	
					ТабСтр.ДокументРасхода=Объект.ДокументОснование; 
				КонецЕсли;	
			КонецЦикла;
			
			//ДокОбъект=Объект.ДокументОснование.ПолучитьОбъект();
			//ДокОбъект.ИмпортКодовМаркировки=Истина; 
			//ДокОбъект.Записать();
			
			Сообщить("Записаны коды маркировки для документа "+Объект.ДокументОснование); 
		КонецЕсли;	

		            
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьКомплектацию(Команда) 
	
	//ДокОбъект=Объект.ДокументОснование.ПолучитьОбъект();
	//Если ДокОбъект.ИмпортКодовМаркировки=Истина тогда 
	//	Сообщить(" Запись кодов маркировки по документу "+Объект.ДокументОснование+" уже производилась!" );
	//	Возврат;
	//КонецЕсли;
	
	Если Объект.КодыСписок.Количество()=0 Тогда
		Сообщить("Заполните таблицу Комплектация товара!");
		Возврат;
	КонецЕсли;
	
	// проверка 
	
	НомерСтроки=0;
	ФлЗаписи=Истина;
	ФлОшиб=0;
	Для Каждого ТабСтрока из Объект.Контроль Цикл  
		НомерСтроки=НомерСтроки+1;
		Если ТабСтрока.Количество-Табстрока.Сертификация<>ТабСтрока.КоличествоКМ тогда
				Сообщить("Строка "+Строка(ТабСтрока.НомерСтроки)+" (Контроль по документу) - Количество товаров в документе основания не совпадает с количеством КМ");
				ФлОшиб=1;
			Возврат;
		КонецЕсли;	
	КонецЦикла;	  

	Если ФлОшиб=1 тогда возврат;
	КонецЕсли;	
	
	ЗаписатьКомплектациюНаСервере();
КонецПроцедуры

