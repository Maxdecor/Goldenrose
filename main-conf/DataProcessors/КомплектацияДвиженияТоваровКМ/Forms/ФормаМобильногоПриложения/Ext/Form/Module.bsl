#Область ОбщиеМетоды  
Функция АвторизацияНачало() Экспорт
	
	ОтветСоответствие = aslbelgisi_МетодыДляИнтеграцииССайтом.authKey();
	
	Если Не ЗначениеЗаполнено(ОтветСоответствие.Получить("data")) 
		ИЛИ	Не ЗначениеЗаполнено(ОтветСоответствие.Получить("uuid")) Тогда 
			Возврат Неопределено;		
	КонецЕсли;

	Возврат ОтветСоответствие;
	
КонецФункции

Функция АвторизацияЗавершение(Идентификатор, ПодписаннаяСтрока) Экспорт
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("uuid", Идентификатор);
	СтруктураЗапроса.Вставить("data", ПодписаннаяСтрока);
	
	ТелоЗапроса = uzbled_EImzoСлужебный.ЗаписатьВСтрокуJSON(СтруктураЗапроса);
	Токен = aslbelgisi_МетодыДляИнтеграцииССайтом.authSimpleSignIn(ТелоЗапроса);
	
	Если Не ЗначениеЗаполнено(Токен) Тогда 
		ТекстСообщения = НСтр("ru = 'Произошли ошибки при авторизации: получил пустой токен!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	Возврат Токен;
	
КонецФункции

Функция ПолучитьДанныеДляКодовМаркировки(Токен, КодыМаркировки, ТаблицаКодов) Экспорт 
	
	// Это структура для ошибки
	ДанныеИзСайта = Новый Структура("ТипОшибки, ТекстОшибки");
		
	ТелоЗапроса = uzbled_EImzoСлужебный.ЗаписатьВСтрокуJSON(КодыМаркировки);
	ОтветСоответствие = aslbelgisi_МетодыДляИнтеграцииССайтом.cisesInfo(Токен, ТелоЗапроса);
	
	ТипОшибки = ОтветСоответствие.Получить("ТипОшибки");
	ИнформацииОКодахМаркировки = ОтветСоответствие.Получить("ИнформацииОКодахМаркировки");
 
	Если ТипОшибки = Неопределено Тогда 
		
		Для Каждого СтрокаМассива Из ИнформацииОКодахМаркировки Цикл
			
			Если СтрокаМассива.Получить("errorCode") = Неопределено Тогда 
				ИнформацияОКоде = СтрокаМассива.Получить("cisInfo");
				КодМаркировки = ИнформацияОКоде.Получить("cis"); 
				GTIN = ИнформацияОКоде.Получить("gtin");
				УровеньУпаковки=ПолучитьУровеньУпаковкиИзСайта(ИнформацияОКоде.Получить("packageType"));
				НаименованиеТовара=ИнформацияОКоде.Получить("productName");
				ТипУпаковки = ПолучитьТипУпаковкиИзСайта(ИнформацияОКоде.Получить("packageType"));
				ТипТовара = ПолучитьТипТовараИзСайта(ИнформацияОКоде.Получить("productGroup"));
				СтатусКода = ПолучитьСтатусКодаИзСайта(ИнформацияОКоде.Получить("status"));		
				Агрегации = ИнформацияОКоде.Получить("child");
				Если Агрегации<>Неопределено тогда
					ЕмкостьУпаковки=Агрегации.Количество(); 
				Иначе
					ЕмкостьУпаковки=1;
				КонецЕсли;
				ТаблицаКодов.Добавить(Новый Структура("Код,GTIN,НаименованиеТовара,ТипТовара,УровеньУпаковки, ТипУпаковки, СтатусКода, Агрегации,ЕмкостьУпаковки", 
					КодМаркировки,GTIN,НаименованиеТовара, ТипТовара,УровеньУпаковки, ТипУпаковки, СтатусКода, Агрегации,ЕмкостьУпаковки));
					
			КонецЕсли;

		КонецЦикла;
		
	Иначе
		ДанныеИзСайта.ТипОшибки = ОтветСоответствие.Получить("ТипОшибки");				
		ДанныеИзСайта.ТекстОшибки = ОтветСоответствие.Получить("error_message");
	КонецЕсли;
	
	Возврат ДанныеИзСайта;
	
КонецФункции

