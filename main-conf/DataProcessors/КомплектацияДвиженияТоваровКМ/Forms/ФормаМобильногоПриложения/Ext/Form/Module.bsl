Функция ПолучитьТокен(Организация) Экспорт
	
	Токен = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	aslbelgisi_Токены.Токен КАК Токен
		|ИЗ
		|	РегистрСведений.aslbelgisi_Токены КАК aslbelgisi_Токены
		|ГДЕ
		|	aslbelgisi_Токены.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		Токен = ВыборкаДетальныеЗаписи.Токен;	
	КонецЕсли;
	
	Возврат Токен;
	
КонецФункции

Функция ПолучитьТипУпаковкиИзСайта(ТипУпаковки) Экспорт
	
	Если ТипУпаковки = "АТК" ИЛИ ТипУпаковки = "BUNDLE"  
		ИЛИ ТипУпаковки = "LEVEL5" ИЛИ ТипУпаковки = "LEVEL4"  
		ИЛИ ТипУпаковки = "LEVEL3" ИЛИ ТипУпаковки = "LEVEL2" Тогда 
		
		Возврат Перечисления.ВариантыИспользованияЕдиницыХраненияИСМП.ТранспортнаяУпаковка;

	ИначеЕсли ТипУпаковки = "LEVEL1" Тогда 
		Возврат Перечисления.ВариантыИспользованияЕдиницыХраненияИСМП.ГрупповаяУпаковка;
	Иначе
		Возврат Перечисления.ВариантыИспользованияЕдиницыХраненияИСМП.ПотребительскаяУпаковка;
	КонецЕсли;
	
КонецФункции 

Функция ПолучитьУровеньУпаковкиИзСайта(ТипУпаковки) Экспорт
	
	Если ТипУпаковки = "АТК" ИЛИ ТипУпаковки = "BUNDLE" тогда
		Возврат 99;
	ИначеЕсли ТипУпаковки="UNIT" тогда
		Возврат 0; 
	ИначеЕсли СтрНайти(ТипУпаковки,"LEVEL")>0 Тогда 
		Возврат Число(СтрЗаменить(ТипУпаковки,"LEVEL",""));
	Иначе
		Возврат Неопределено
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТипТовараИзСайта(ТипТовара) Экспорт
	
	Если ТипТовара = "tobacco" Тогда 
		Возврат Перечисления.ОсобенностиУчетаНоменклатуры.ТабачнаяПродукция;
	ИначеЕсли ТипТовара = "pharma" Тогда 
		Возврат Перечисления.ОсобенностиУчетаНоменклатуры.ЛекарственныеСредства;
	ИначеЕсли ТипТовара = "alcohol" Тогда 
		Возврат Перечисления.ОсобенностиУчетаНоменклатуры.АлкогольнаяПродукция;
	ИначеЕсли ТипТовара = "water" Тогда 
		Возврат Перечисления.ОсобенностиУчетаНоменклатуры.ВодаИПрохладительныеНапитки;
	ИначеЕсли ТипТовара = "beer" Тогда 
		Возврат Перечисления.ОсобенностиУчетаНоменклатуры.ПивоИПивныеНапитки;
	ИначеЕсли ТипТовара = "appliances" Тогда 
		Возврат Перечисления.ОсобенностиУчетаНоменклатуры.БытоваяТехника;
	Иначе
		Возврат Перечисления.ОсобенностиУчетаНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции 

Функция ПолучитьСтатусКодаИзСайта(Статус) Экспорт
	
	Если Статус = "EMITTED" Тогда 
		Возврат Перечисления.aslbelgisi_СтатусКодовМаркировки.Эмитирован;
	ИначеЕсли Статус = "APPLIED" Тогда 
		Возврат Перечисления.aslbelgisi_СтатусКодовМаркировки.Нанесён;
	ИначеЕсли Статус = "INTRODUCED" Тогда 
		Возврат Перечисления.aslbelgisi_СтатусКодовМаркировки.ВведенВОборот;
	ИначеЕсли Статус = "WRITTEN_OFF" Тогда 
		Возврат Перечисления.aslbelgisi_СтатусКодовМаркировки.Утилизирован;
	ИначеЕсли Статус = "WITHDRAWN" Тогда 
		Возврат Перечисления.aslbelgisi_СтатусКодовМаркировки.ВыведенИзОборота;
	ИначеЕсли Статус = "INTRODUCED_RETURNED" Тогда 
		Возврат Перечисления.aslbelgisi_СтатусКодовМаркировки.ВозвращёнВОборот;
	ИначеЕсли Статус = "DISAGGREGATED" Тогда 
		Возврат Перечисления.aslbelgisi_СтатусКодовМаркировки.Дезагрегирован;
	ИначеЕсли Статус = "APPLIED_NOT_PAID" Тогда 
		Возврат Перечисления.aslbelgisi_СтатусКодовМаркировки.НанесёнНеОплачен;
	Иначе
		Возврат Перечисления.aslbelgisi_СтатусКодовМаркировки.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Процедура ДополнитьТаблицу(ТаблицаИсточник, ТаблицаПриемник, Колонка) Экспорт
	
	Для Каждого СтрокаТаблицыИсточник Из ТаблицаИсточник Цикл
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить(Колонка, СтрокаТаблицыИсточник[Колонка]);
		НайденныеСтроки = ТаблицаПриемник.НайтиСтроки(ПараметрыОтбора);
				
		Если Не НайденныеСтроки.Количество() Тогда 
			ЗаполнитьЗначенияСвойств(ТаблицаПриемник.Добавить(), СтрокаТаблицыИсточник);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьОтчетОбОшибкеТаблица(СтруктураФормы) Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	//Макет = ПолучитьОбщийМакет("ОтчетОбОшибкеМаркировки");
	//Макет = Обработки.КомплектацияДвиженияМаркированныхТоваров.ПолучитьМакет("ОтчетОбОшибкеМаркировки");
	Макет = Обработки.КомплектацияДвиженияТоваровКМ.ПолучитьМакет("ОтчетОбОшибкеМаркировки");

	Область = Макет.ПолучитьОбласть("Заголовок");
	Область.Параметры.Заполнить(Новый Структура("Дата, Организация", ТекущаяДата(), СтруктураФормы.Организация));
	ТабДок.Вывести(Область);
	
	Если СтруктураФормы.НесуществующиеКоды.Количество() Тогда 
		ТабДок.НачатьГруппуСтрок("ЗаголовокНесуществующихКодов");
		Область = Макет.ПолучитьОбласть("ЗаголовокНесуществующихКодов");
		ТабДок.Вывести(Область);
		Для каждого СтрокаТЧ Из СтруктураФормы.НесуществующиеКоды Цикл
			Область = Макет.ПолучитьОбласть("СтрокаТЧНесуществующиеКоды");
			Область.Параметры.Заполнить(СтрокаТЧ);
			ТабДок.Вывести(Область);	
		КонецЦикла; 
		ТабДок.ЗакончитьГруппуСтрок();
	КонецЕсли;

	Если СтруктураФормы.КодыРазныхТиповТоваров.Количество() Тогда 
		ТабДок.НачатьГруппуСтрок("ЗаголовокСТипом");
		Область = Макет.ПолучитьОбласть("ЗаголовокСТипом");
		ТабДок.Вывести(Область);
		Для каждого СтрокаТЧ Из СтруктураФормы.КодыРазныхТиповТоваров Цикл
			Область = Макет.ПолучитьОбласть("СтрокиТЧСТипом");
			Область.Параметры.Заполнить(СтрокаТЧ);
			ТабДок.Вывести(Область);
		КонецЦикла; 	
		ТабДок.ЗакончитьГруппуСтрок();
	КонецЕсли;
	
	Если СтруктураФормы.СтатусыСОшибками.Количество() Тогда 
		ТабДок.НачатьГруппуСтрок("ЗаголовокССтатусом");
		Область = Макет.ПолучитьОбласть("ЗаголовокССтатусом");
		ТабДок.Вывести(Область);
		Для каждого СтрокаТЧ Из СтруктураФормы.СтатусыСОшибками Цикл
			Область = Макет.ПолучитьОбласть("СтрокиТЧССтатусом");
			Область.Параметры.Заполнить(СтрокаТЧ);
			ТабДок.Вывести(Область);
		КонецЦикла; 	
		ТабДок.ЗакончитьГруппуСтрок();
	КонецЕсли;
	
	Если СтруктураФормы.КодыРазныхУпаковокТоваров.Количество() Тогда 
		ТабДок.НачатьГруппуСтрок("ЗаголовокСУпаковкой");
		Область = Макет.ПолучитьОбласть("ЗаголовокСУпаковкой");
		ТабДок.Вывести(Область);
		Для каждого СтрокаТЧ Из СтруктураФормы.КодыРазныхУпаковокТоваров Цикл
			Область = Макет.ПолучитьОбласть("СтрокаТЧСУпаковкой");
			Область.Параметры.Заполнить(СтрокаТЧ);
			ТабДок.Вывести(Область);
		КонецЦикла; 	
		ТабДок.ЗакончитьГруппуСтрок();
	КонецЕсли;   
	
	Если СтруктураФормы.KoдыРазныхGTIN.Количество() Тогда 
		ТабДок.НачатьГруппуСтрок("ЗаголовокСGTIN");
		Область = Макет.ПолучитьОбласть("ЗаголовокСGTIN");
		ТабДок.Вывести(Область);
		Для каждого СтрокаТЧ Из СтруктураФормы.KoдыРазныхGTIN Цикл
			Область = Макет.ПолучитьОбласть("СтрокаТЧСGTIN");
			Область.Параметры.Заполнить(СтрокаТЧ);
			ТабДок.Вывести(Область);
		КонецЦикла; 	
		ТабДок.ЗакончитьГруппуСтрок();
	КонецЕсли;   
	
	Если СтруктураФормы.КодыРазныхЕмкостей.Количество() Тогда
		//СтруктураФормы.КодыРазныхЕмкостей.Количество()
		ТабДок.НачатьГруппуСтрок("ЗаголовокСЕмкость");
		Область = Макет.ПолучитьОбласть("ЗаголовокСЕмкость");
		ТабДок.Вывести(Область);
		Для каждого СтрокаТЧ Из СтруктураФормы.КодыРазныхЕмкостей Цикл
			Область = Макет.ПолучитьОбласть("СтрокаТЧСЕмкость");
			Область.Параметры.Заполнить(СтрокаТЧ);
			ТабДок.Вывести(Область);
		КонецЦикла; 	
		ТабДок.ЗакончитьГруппуСтрок();
	КонецЕсли;   
		
	Возврат ТабДок;
	
КонецФункции

