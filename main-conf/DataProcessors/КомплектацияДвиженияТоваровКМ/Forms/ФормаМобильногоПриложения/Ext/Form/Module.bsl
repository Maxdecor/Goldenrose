Процедура ЗаписатьНовыйТокен(Организация, Токен) Экспорт
	
	Запись = РегистрыСведений.aslbelgisi_Токены.СоздатьМенеджерЗаписи();
	Запись.Организация = Организация;
	Запись.Токен = Токен;
	Запись.Записать(Истина);
	
