&НаКлиенте
Процедура КорректировкаСпискаКМ()
	
	Для каждого СтрокаТЧ Из НесуществующиеКоды Цикл
		КорректировкаСтрокиСписка(СтрокаТЧ);
	КонецЦикла;

	Для каждого СтрокаТЧ Из СтатусыСОшибками Цикл
		КорректировкаСтрокиСписка(СтрокаТЧ);
	КонецЦикла;

	Для каждого СтрокаТЧ Из KoдыРазныхGTIN Цикл
		КорректировкаСтрокиСписка(СтрокаТЧ);
	КонецЦикла;

	Для каждого СтрокаТЧ Из КодыРазныхЕмкостей Цикл
		КорректировкаСтрокиСписка(СтрокаТЧ);
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура КорректировкаСтрокиСписка(СтрокаТЧ) 
	
	Код=СтрокаТЧ.КодМаркировки;

	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Товар", Код);
	
	НайденныеСтроки = Объект.КодыСписок.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()>0 тогда
		ТабСтрока=НайденныеСтроки[0];
		//Если ТабСтрока.Проверка тогда
			ТабСтрока.Проверка=Ложь;  
			Если СтрокаТЧ.Свойство("GTINСайт")  тогда              
				Если ТабСтрока.GTIN<>СтрокаТЧ.GTINСайт тогда
					 ТабСтрока.GTIN=СтрокаТЧ.GTINСайт;
			         ТабСтрока.Номенклатура=ПолучитьНоменклатурунаСервере(ТабСтрока.GTIN);
				Конецесли;
			КонецЕсли;
			Если СтрокаТЧ.Свойство("ЕмкостьУпаковкиСайт")  тогда
			         ТабСтрока.ЕмкостьУпаковки=СтрокаТЧ.ЕмкостьУпаковкиСайт;
			         ТабСтрока.Количество=СтрокаТЧ.ЕмкостьУпаковкиСайт;
			КонецЕсли;
			
			// корретировка КМ в документе  
			ПересчетКоличестваКМДокументаОснования(ТабСтрока);
		//КонецЕсли;
	КонецЕсли;
КонецПроцедуры

 
&НаКлиенте
Процедура РаспаковатьКодыМаркировки(Команда)
	//Если Не РазрешеноПодключаться() Тогда 
	//	Возврат;
	//КонецЕсли;
	
	Если Организация.Пустая() тогда
		Сообщить("Выберите организацию !");
		возврат;
	КонецЕсли;

	ЕстьНесуществующиеКоды = Истина;
	ПослеАвторизации = Ложь;
	
	//УдаляетПустоеЗначениеИзСписок();
	КодыРазныхТиповТоваров.Очистить();
	СтатусыСОшибками.Очистить();

	КодыМаркировки = ПолучитьВсеКодыМаркировки();
	Если КодыМаркировки.Количество() > 100 Тогда 
		ПоказатьПредупреждение(, НСтр("ru = 'Обработка запросов требует времени потому, что у вас более 100 кодов. Пожалуйста, отметьте кнопку ""Запомнить на 6 часов"", чтобы срок действия токена не истек!'"));
	КонецЕсли;	
	
	СинхронизоватьКодыМаркировкиССайтом(КодыМаркировки, Ложь);

	ТекстСообщения = НСтр("ru = 'Синхронизация завершена!'");
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьРаспакованныеКоды(ТаблицаКодов);
	
	АгрегационныеКоды = Новый Массив;
	
	Для каждого СтрокаМассива Из ТаблицаКодов Цикл
		Если СтрокаМассива.Агрегации <> Неопределено Тогда 
			АгрегационныеКоды.Очистить();
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(АгрегационныеКоды, СтрокаМассива.Агрегации); 
			
			Для Инд=0 по АгрегационныеКоды.Количество()-1 Цикл

				Если Инд=0 тогда                         // первая строка
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("КодSSCC1", СтрокаМассива.Код);
					НайденныеСтроки = Объект.КодыСписок.НайтиСтроки(ПараметрыОтбора);
					Если НайденныеСтроки.Количество()>0 тогда
						ТабСтрока=НайденныеСтроки[0];
						ЕмкостьУпаковки=ТабСтрока.ЕмкостьУпаковки;
					иначе
						ТабСтрока=Объект.КодыСписок.Добавить();
					КонецЕсли;
				иначе
					ТабСтрока=Объект.КодыСписок.Добавить();
                КонецЕсли;

				ТабСтрока.КодSSCC1=СтрокаМассива.Код; 
				ТабСтрока.Товар=АгрегационныеКоды[Инд];
				ТабСтрока.GTIN=Сред(ТабСтрока.Товар,3,14); 
				ТабСтрока.ЕмкостьУпаковки=ЕмкостьУпаковки;
				ТабСтрока.Количество=1; 
				ТабСтрока.Проверка=Истина; 
				
				Если  Объект.ДокументОснование<>Неопределено тогда   // контроль и подсчет количества по документу
					СтрокаДокумента=Неопределено;
					Если Не КонтрольПоДокументу(ТабСтрока.GTIN,ТабСтрока.Количество,ТабСтрока.НомерСтроки,СтрокаДокумента) тогда
						ТабСтрока.Проверка=Ложь; 
					иначе
						ТабСтрока.Проверка=Истина; 
						ТабСтрока.Номенклатура=СтрокаДокумента.Номенклатура;
						ТабСтрока.НомерСерии=СтрокаДокумента.НомерСерии;
						//ТабСтрока.ЕмкостьУпаковки=СтрокаДокумента.Емкость;
					КонецЕсли;
				КонецЕсли;                                    
			КонецЦикла;
		КонецЕсли;
	КонецЦикла; 
	
	Объект.КодыСписок.Сортировать("КодSSCC1");
	
КонецПроцедуры

