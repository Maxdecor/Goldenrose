&НаСервере
Процедура ЗаписатьКомплектациюНаСервере() 
	
	КоличПовторКМ=0;
	// проверка и запись кодов
		//МассивАгрегации=Новый Массив();
		МассивРазагрегации=Новый Массив();
	
		МассивКодов=Новый Массив();
		МассивУпаковок=Новый Массив();
		Для каждого ТабСтрока Из Объект.КодыСписок Цикл 
			Если ТабСтрока.Проверка=ложь тогда 
				продолжить;
			КонецЕсли;
			//Если ТабСтрока.Товар<>"" тогда
				Если МассивКодов.Найти(ТабСтрока.Товар)=Неопределено тогда
					МассивКодов.Добавить();
					МассивКодов[МассивКодов.ВГраница()]=ТабСтрока.Товар; 
					Если ТабСтрока.УровеньУпаковки>0 тогда
						МассивУпаковок.Добавить();
						МассивУпаковок[МассивУпаковок.ВГраница()]=ТабСтрока.Товар; 
					КонецЕсли;
				Иначе
					Сообщить("Строка "+СтрЗаменить(Строка(ТабСтрока.НомерСтроки),Символ(160),"")+" "+Табстрока.КодSSCC1+" "+ТабСтрока.Товар+"  Повтор КМ! ");
					КоличПовторКМ=КоличПовторКМ+1;
					ФлОшиб=1;
				КонецЕсли; 
			//ИначеЕсли ТабСтрока.КодSSCC1<>"" тогда
			//	Если МассивУпаковок.Найти(ТабСтрока.КодSSCC1)=Неопределено тогда
			//		МассивУпаковок.Добавить();
			//		МассивУпаковок[МассивУпаковок.ВГраница()]=ТабСтрока.КодSSCC1; 
