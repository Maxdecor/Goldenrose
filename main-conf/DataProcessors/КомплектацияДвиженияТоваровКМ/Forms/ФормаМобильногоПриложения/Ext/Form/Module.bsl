&НаКлиенте
Процедура ОчиститьСписокКМ() 
	Если Объект.КодыСписок.Количество()>0 Тогда 
		Режим = РежимДиалогаВопрос.ДаНет;
		Ответ = Вопрос("Очистить табличную часть?", Режим, 0);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
		    Возврат;
		КонецЕсли;
		Объект.КодыСписок.Очистить(); 
		КодАгрегации="";
		Введено=0;
		ВведеноУпаковок=0;
		Если Объект.Контроль.Количество()>0  тогда 
			Для каждого СтрКонтроль из Объект.Контроль цикл
				Если  СтрКонтроль.НомерСтроки=1 тогда
					СтрКонтроль.ВыборСтроки=Истина; 
					GTIN1=СтрКонтроль.GTIN;
					НомерСерии1=СтрКонтроль.НомерСерии;
				Иначе
					Если СтрКонтроль.GTIN=GTIN1 и СтрКонтроль.НомерСерии=НомерСерии1 тогда
						СтрКонтроль.ВыборСтроки=Истина;
					иначе
						СтрКонтроль.ВыборСтроки=Ложь;
					КонецЕсли;
				КонецЕсли;
				
				СтрКонтроль.КоличествоКМ=0;
				СтрКонтроль.Сертификация=0;
			КонецЦикла;	
		КонецЕсли;	
		ЭтаФорма.ОбновитьОтображениеДанных(Элементы.Контроль);
	КонецЕсли;   
	
КонецПроцедуры 
	
