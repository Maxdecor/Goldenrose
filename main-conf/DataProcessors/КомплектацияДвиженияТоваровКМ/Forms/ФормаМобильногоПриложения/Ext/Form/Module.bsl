	Запрос.УстановитьПараметр("ТипТовара", ТипТовара);
	КодыРазныхТиповТоваров1 = ОбщегоНазначения.ТаблицаЗначенийВМассив(Запрос.Выполнить().Выгрузить());
	Результат.Вставить("КодыРазныхТиповТоваров", КодыРазныхТиповТоваров1);

		
	// Потребительские коды
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОбщиеКоды.КодМаркировки КАК КодМаркировки,
		|	ОбщиеКоды.Пометка КАК Пометка
		|ПОМЕСТИТЬ ВТ_ОбщиеКоды
