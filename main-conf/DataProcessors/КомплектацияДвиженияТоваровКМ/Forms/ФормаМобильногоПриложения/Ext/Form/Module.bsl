&НаКлиенте
Процедура ТоварыСписокПередУдалением(Элемент, Отказ)
	ТабСтрока=Элементы.ТоварыСписок.ТекущиеДанные;
	//Остаток= ТабСтрока.Количество;
	
	Если ТабСтрока.Проверка и  Объект.ДокументОснование<>неопределено тогда   // есть документ
		Режим = РежимДиалогаВопрос.ДаНет;
		Ответ = Вопрос("Вы действительно хотате удалить строку "+ТабСтрока.НомерСтроки+"?", Режим, 0);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Отказ=Истина;
			Возврат;
		КонецЕсли;
		ПересчетКоличестваКМДокументаОснования(ТабСтрока);
	КонецЕсли;	
	
	Если ТабСтрока.Проверка и  Объект.ДокументОснование=неопределено тогда   // нет документа
		Введено=Введено-1;
		Если  Емкость<>0 Тогда
			ВведеноУпаковок=Цел(Введено/Емкость);
		КонецЕсли;
	иначеЕсли Разагрегация и СокрЛП(КодАгрегации)=ТабСтрока.КодSSCC1 и ТабСтрока.НовыйКод тогда	
		Введено=Введено-1;		
	КонецЕсли;
	
