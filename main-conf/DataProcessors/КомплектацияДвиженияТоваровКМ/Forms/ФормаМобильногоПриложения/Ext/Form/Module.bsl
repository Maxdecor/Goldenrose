		|	ВТ_ОбщиеКоды.КодМаркировки КАК КодМаркировки,
		|	ВТ_ОбщиеКоды.Пометка КАК Пометка
		|ИЗ
		|	ВТ_ОбщиеКоды КАК ВТ_ОбщиеКоды";
	
	Запрос.УстановитьПараметр("ОбщиеКоды", ИсправленнаяТаблица);
	Запрос.УстановитьПараметр("ТипУпаковки", Перечисления.ВариантыИспользованияЕдиницыХраненияИСМП.ТранспортнаяУпаковка);
	
	ТранспортныеКоды1 = ОбщегоНазначения.ТаблицаЗначенийВМассив(Запрос.Выполнить().Выгрузить());
