			Сообщить("Количество повторных кодов -"+Строка(КоличПовторКМ)+". Запись списка КМ не произведена! ");
			Возврат;
		КонецЕсли;	

		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КодыМаркировки.КодМаркировки КАК КодМаркировки,
			|	КодыМаркировки.ДокументПрихода.Ссылка КАК ДокументПрихода,
			|	КодыМаркировки.ДокументРасхода.Ссылка КАК ДокументРасхода,
			|	КодыМаркировки.Статус КАК Статус,
			|	КодыМаркировки.КоличествоЕдиницТовара КАК КоличествоЕдиницТовара,
			|	КодыМаркировки.Номенклатура КАК Номенклатура,
			|	КодыМаркировки.КодSSCC1 КАК КодSSCC1
			|ИЗ
			|	РегистрСведений.КодыМаркировки КАК КодыМаркировки
			|ГДЕ
			|	(КодыМаркировки.КодМаркировки В (&МассивКодов)
			|			ИЛИ КодыМаркировки.КодSSCC1 В (&МассивУпаковок))
			|
			|УПОРЯДОЧИТЬ ПО
			|	КодМаркировки";
		
		Запрос.УстановитьПараметр("МассивКодов", МассивКодов);
		Запрос.УстановитьПараметр("МассивУпаковок", МассивУпаковок);
		
		РезультатЗапроса = Запрос.Выполнить(); 
		
		Выборка = РезультатЗапроса.Выбрать();    

		Если Выборка.Количество()>0 тогда     // проверка найденных кодов  

			Пока Выборка.Следующий() Цикл
				//Если Лев(Выборка.КодМаркировки,2)="01" тогда   // нужно определить тип упаковки
					
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("Товар", Выборка.КодМаркировки);
					НайденныеСтроки = Объект.КодыСписок.НайтиСтроки(ПараметрыОтбора);
					ТабСтрока=Неопределено;
					Если НайденныеСтроки.Количество()>0  тогда 
						Если НайденныеСтроки[0].Проверка тогда 
							ТабСтрока=НайденныеСтроки[0];
						КонецЕсли;
					КонецЕсли;	 
					Если ТабСтрока<>Неопределено тогда 
						ФлОшибЗап=ПроверитьЗапись(Выборка,НайденныеСтроки[0]);
						Если ФлОшибЗап=1 тогда
							 ФлОшиб=1;
						КонецЕсли;
					иначе	//  поиск упаковки - в выборку КМ попал по агрегатному коду	
						ПараметрыОтбора = Новый Структура;
						//ПараметрыОтбора.Вставить("КодSSCC1", Выборка.КодSSCC1);
						ПараметрыОтбора.Вставить("Товар", Выборка.КодSSCC1);
						НайденныеСтроки = Объект.КодыСписок.НайтиСтроки(ПараметрыОтбора); 
						Если НайденныеСтроки.Количество()>0 тогда   // разогрегация ошибка
							 //ФлОшиб=1;
							Если МассивРазагрегации.Найти(Выборка.КодSSCC1)=Неопределено тогда
								МассивРазагрегации.Добавить();
								МассивРазагрегации[МассивРазагрегации.ВГраница()]=Выборка.КодSSCC1; 
							КонецЕсли; 
						КонецЕсли;
					КонецЕсли;	
				//Иначе	// агрегатный код	
				//	МассивАгрегации.Добавить();
				//	МассивАгрегации[МассивАгрегации.ВГраница()]=Выборка.КодМаркировки; 
				//	
				//	Если МассивРазагрегации.Найти(Выборка.КодSSCC1)=Неопределено тогда
				//		ПараметрыОтбора = Новый Структура;
				//		ПараметрыОтбора.Вставить("КодSSCC1", Выборка.КодМаркировки);
				//		НайденныеСтроки = Объект.КодыСписок.НайтиСтроки(ПараметрыОтбора);
				//		Если НайденныеСтроки.Количество()>0 тогда
				//			ФлОшибЗап=ПроверитьЗапись(Выборка,НайденныеСтроки[0]);
				//			Если ФлОшибЗап=1 тогда
				//				 ФлОшиб=1;
				//			КонецЕсли;
				//		КонецЕсли;     
				//	КонецЕсли; 	
				//КонецЕсли;

				//Если НайденныеСтроки.Количество()>0 тогда 
				//	ФлОшибЗап=ПроверитьЗапись(Выборка,НайденныеСтроки[0].НомерСтроки);
				//	Если ФлОшибЗап=1 тогда
				//		 ФлОшиб=1;
				//	КонецЕсли;
				//КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если МассивРазагрегации.Количество()>0 тогда    // вывод сообщений об ошибках разагрегации
			Для инд=0 по МассивРазагрегации.Количество()-1 Цикл
				
				//Если МассивАгрегации.Найти(МассивРазагрегации[инд])=Неопределено тогда   // агрегатного кода не было
				//	Продолжить;
				//КонецЕсли; 
				
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Товар", МассивРазагрегации[инд]);
				НайденныеСтроки = Объект.КодыСписок.НайтиСтроки(ПараметрыОтбора); 
				Если НайденныеСтроки.Количество()>0 тогда   // разогрегация ошибка
					Сообщить("строка "+Строка(НайденныеСтроки[0].НомерСтроки)+" Код коробки "+НайденныеСтроки[0].Товар+" разагрегирован!") ; 
					ФлОшиб=1;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;	
			
		
		Если ФлОшиб=1 Тогда
			Сообщить("Есть ошибки. Запись списка КМ не произведена! ");
			Возврат;
		КонецЕсли;	
		
		// определим статус по документу основания
		Если Объект.ДокументОснование=Неопределено тогда
			мСтатус=0;
		Иначе
			Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг")  тогда //приход 
				мСтатус=1;				
			ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") тогда //расход  
				мСтатус=3;
			КонецЕсли;
			Если Объект.ДокументОснование.Проведен тогда
				мСтатус=мСтатус+1;
			КонецЕсли;
		КонецЕсли;

		//запись статуса и связей с документами найденных кодов  
		Если Выборка.Количество()>0  Тогда         
			Выборка.Сбросить() ;
			Пока Выборка.Следующий() Цикл 
				Запись=Регистрысведений.КодыМаркировки.СоздатьМенеджерЗаписи(); 
				Запись.КодМаркировки=Выборка.КодМаркировки; 
				Запись.Прочитать();
				Если Запись.Выбран() тогда
					Если (мСтатус=1 или мСтатус=2) и Запись.Статус=0 тогда
						Запись.ДокументПрихода=Объект.ДокументОснование; 
						Запись.Статус=мСтатус; 
						
