	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область РаботаСНеправильнымиКодами

&НаКлиенте
Процедура РаботаСНеправильнымиКодамиНачало()
		
	Если КодыРазныхТиповТоваров.Количество() 
		ИЛИ СтатусыСОшибками.Количество() 
		ИЛИ НесуществующиеКоды.Количество() 
		ИЛИ KoдыРазныхGTIN.Количество()
		ИЛИ КодыРазныхЕмкостей.Количество()
		ИЛИ КодыРазныхУпаковокТоваров.Количество() Тогда 
		
		
		КорректировкаСпискаКМ();         // корректировка признака Проверка списка КМ
		
		ТекстВопроса = "Обнаружены не соответствия кодов маркировки с Асл белгиси. Сформировать отчёт?";
		Оповещение = Новый ОписаниеОповещения("РаботаСНеправильнымиКодамиЗавершение", ЭтаФорма);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);					
		Возврат;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура РаботаСНеправильнымиКодамиЗавершение(Результат = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		// Очистить таблицы
		КодыРазныхТиповТоваров.Очистить();
		СтатусыСОшибками.Очистить();
		НесуществующиеКоды.Очистить();
		КодыРазныхУпаковокТоваров.Очистить(); 
		KoдыРазныхGTIN.Очистить();
		КодыРазныхЕмкостей.Очистить();
		Возврат;
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда
		
		ТабличныйДокумент = СформироватьОтчетОбОшибке();
				
		МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");
		ИдентификаторПечатнойФормы = "ПечатьДокумент";
		
		КоллекцияПечатныхФорм = МодульУправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм(ИдентификаторПечатнойФормы);
		ПечатнаяФорма = МодульУправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, ИдентификаторПечатнойФормы);
		ПечатнаяФорма.СинонимМакета = НСтр("ru = 'Отчет об ошибке маркировки (asl belgisi)'");
		ПечатнаяФорма.ТабличныйДокумент = ТабличныйДокумент;  //указываем подготовленный табличный документ
		ПечатнаяФорма.ТабличныйДокумент.АвтоМасштаб = Ложь;  //по ширине страницы
		
		МодульУправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция СформироватьОтчетОбОшибке()
	
	ТабличныйДокумент = СформироватьОтчетОбОшибкеТаблица(ЭтаФорма);
	
	// Очистить таблиц
	КодыРазныхТиповТоваров.Очистить();
	СтатусыСОшибками.Очистить();
	НесуществующиеКоды.Очистить();
	КодыРазныхУпаковокТоваров.Очистить();
	KoдыРазныхGTIN.Очистить();
	Возврат ТабличныйДокумент;
	
КонецФункции  


&НаСервере
Функция ПроверитьЗаписатьКодыМаркировки(ДанныеДляКодовМаркировки, ДоступныКодыМаркировки, ТолькоПроверить) 
	// Получить таблицу из массива маркировки из сайта
	ТаблицаДляМаркировкиИзСайта = ПолучитьТаблицуДляМаркировки();	
	ДополнитьТаблицу(ДанныеДляКодовМаркировки, ТаблицаДляМаркировкиИзСайта, "Код");

	// Получить таблицу из массива маркировки из список формы
	ТекущиеКодыМаркировки = ПолучитьТаблицуДляМаркировки();
	ДополнитьТаблицу(ДоступныКодыМаркировки.ПотребительскиеКодыМаркировки, ТекущиеКодыМаркировки, "Код");
	ДополнитьТаблицу(ДоступныКодыМаркировки.ГрупповыеКодыМаркировки, ТекущиеКодыМаркировки, "Код");
	ДополнитьТаблицу(ДоступныКодыМаркировки.ТранспортныеКодыМаркировки, ТекущиеКодыМаркировки, "Код");
		
	Результат = ПолучитьРезультатнуюСтруктуруИзСайтаДляМаркировки(ТекущиеКодыМаркировки, ТаблицаДляМаркировкиИзСайта, ТипТовара); 
	
	// Перезаполнить списки
	//ПотребительскихСписокКодовМаркировки.Очистить();
	//ГрупповыхСписокКодовМаркировки.Очистить();
	//ТранспортныхСписокКодовМаркировки.Очистить(); 
	
	ПотребительскихСписокКодовМаркировки=Новый СписокЗначений;
	ГрупповыхСписокКодовМаркировки=Новый СписокЗначений;
	ТранспортныхСписокКодовМаркировки=Новый СписокЗначений;

	
	Для каждого СтрокаМассива Из Результат.ПотребительскиеКоды Цикл
		ПотребительскихСписокКодовМаркировки.Добавить(СтрокаМассива.КодМаркировки,, СтрокаМассива.Пометка);
	КонецЦикла; 
	
	Для каждого СтрокаМассива Из Результат.ГрупповыеКоды Цикл
		ГрупповыхСписокКодовМаркировки.Добавить(СтрокаМассива.КодМаркировки,, СтрокаМассива.Пометка);
	КонецЦикла; 
	
	Для каждого СтрокаМассива Из Результат.ТранспортныеКоды Цикл
		ТранспортныхСписокКодовМаркировки.Добавить(СтрокаМассива.КодМаркировки,, СтрокаМассива.Пометка);
	КонецЦикла; 
		
	ДополнитьТаблицу(Результат.КодыРазныхТиповТоваров, КодыРазныхТиповТоваров, "КодМаркировки");
	ДополнитьТаблицу(Результат.СтатусыСОшибками, СтатусыСОшибками, "КодМаркировки");
	
	// Один раз проверить
	Если ЕстьНесуществующиеКоды Тогда  
		ДополнитьТаблицу(Результат.КодыРазныхУпаковокТоваров, КодыРазныхУпаковокТоваров, "КодМаркировки");
		
		ДополнитьТаблицу(Результат.НесуществующиеКоды, НесуществующиеКоды, "КодМаркировки");
		ЕстьНесуществующиеКоды = Ложь;
	КонецЕсли;

	ДополнитьТаблицу(Результат.КодыРазныхGTIN, KoдыРазныхGTIN, "КодМаркировки");
	ДополнитьТаблицу(Результат.КодыРазныхЕмкостей, КодыРазныхЕмкостей, "КодМаркировки");
														 
	// Получит агрегационные коды 
	АгрегационныеКоды = Новый Массив;
	
	Если ТолькоПроверить Тогда 
		
		Для каждого СтрокаМассива Из ДанныеДляКодовМаркировки Цикл
			Если СтрокаМассива.Агрегации <> Неопределено Тогда 
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(АгрегационныеКоды, СтрокаМассива.Агрегации);
			КонецЕсли;
		КонецЦикла; 
		
	КонецЕсли;
	
	Возврат АгрегационныеКоды; 
КонецФункции 

