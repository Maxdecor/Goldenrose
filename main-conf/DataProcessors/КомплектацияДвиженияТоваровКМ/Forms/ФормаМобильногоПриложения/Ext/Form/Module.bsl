	//Упаковка=1;
	СтрКонтроль=Объект.Контроль.Получить(0);
	ТипТовара=СтрКонтроль.ТипТовара;
	
	//ТипТовара=ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.БезОсобенностейУчета");
	//ТипТовара=ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.ЛекарственныеСредства");
	//ТипТовара=ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.СоковаяПродукция");
	//ТипТовара=ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.ТабачнаяПродукция");
	//ТипТовара=ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.УпакованнаяВода"); 
	//ТипТовара=ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.ПустаяСсылка");
	
	ОшибкаВвода=Ложь; 
