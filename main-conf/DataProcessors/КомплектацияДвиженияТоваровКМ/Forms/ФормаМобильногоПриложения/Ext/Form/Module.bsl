Процедура ТоварыСписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр) 
  	Если  Разагрегация   тогда       // по документу расхода
		Если СокрЛП(КодАгрегации)="" тогда
			Сообщить("Введите код коробки для разагрегации!");
			Отказ=Истина;
			возврат;
		КонецЕсли;
	Иначе
        // агрегация без документа
		Если СокрЛП(КодАгрегации)<>"" и Емкость=0   тогда
			Сообщить("Введите емкость упаковки!");
			Отказ=Истина;
			возврат;
		ИначеЕсли СокрЛП(КодАгрегации)<>"" и Емкость=Введено  тогда
			Сообщить("Введите новый код агрегации!"); 
			Элементы.КодАгрегации.Доступность=истина;
			Элементы.Емкость.Доступность=истина;
			КодАгрегации="";
			Введено=0;
			Отказ=Истина;
			возврат;
		КонецЕсли;	
	КонецЕсли;	

	Если ОшибкаВвода тогда
		Отказ=Истина;
		ОшибкаВвода=Ложь;
	КонецЕсли;
