	// Проверить по типу упаковки
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаИзСайта.Код КАК КодМаркировки,
		|	ТаблицаИзСайта.Пометка КАК Пометка,
		|	ТаблицаИзСайта.ТипУпаковки КАК ТипУпаковки,
		|	ТаблицаИзСайта.ТипТовара КАК ТипТовара,
		|	ТаблицаИзСайта.СтатусКода КАК СтатусКода,
		|	ТаблицаИзСайта.GTIN КАК GTIN,
		|	ТаблицаИзСайта.НаименованиеТовара КАК НаименованиеТовара
		|ПОМЕСТИТЬ ВТ_ТаблицаИзСайта
		|ИЗ
		|	&ТаблицаИзСайта КАК ТаблицаИзСайта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТекущаяТаблица.Код КАК КодМаркировки,
