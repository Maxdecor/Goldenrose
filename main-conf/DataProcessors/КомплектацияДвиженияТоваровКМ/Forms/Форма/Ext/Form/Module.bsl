&НаКлиенте
Процедура ОтправитьПодписатьСтроку(КодыМаркировки, ТолькоПроверить)
	
	Если СтруктураКлюча = Неопределено Тогда 
		ТекстСообщения = НСтр("ru = 'Не найден ключ ЭЦП организации!'");
		//ОбщегоНазначенияКлиент_ненужен.СообщитьПользователю(ТекстСообщения);
		Сообщить(ТекстСообщения);
		Возврат;
	КонецЕсли;	
		
	ДопПараметры = Новый Структура("КодыМаркировки, ТолькоПроверить", КодыМаркировки, ТолькоПроверить);

	ПодписатьСтрокуЗавершение = Новый ОписаниеОповещения("ПодписатьСтрокуЗавершение", ЭтаФорма, ДопПараметры);
	
	ПодписатьCreatePKCS7Начало = Новый Структура;
	ПодписатьCreatePKCS7Начало.Вставить("СоответствиеКлюча", СтруктураКлюча);
	ПодписатьCreatePKCS7Начало.Вставить("СтрокаНаПодпись", СтрокаНаПодпись);
	Оповещение_ПодписатьCreatePKCS7Начало = Новый ОписаниеОповещения("ПодписатьCreatePKCS7Начало", uzbled_ОбщегоНазначенияКлиентСервер.ОбщийМодуль("uzbled_EImzo"), ПодписатьCreatePKCS7Начало);
	
	ВыполнитьОбработкуОповещения(Оповещение_ПодписатьCreatePKCS7Начало, ПодписатьСтрокуЗавершение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьСтрокуЗавершение(Результат, ДопПараметры = Неопределено) Экспорт 
	
	Если ПустаяСтрока(Результат) Тогда
		ТекстСообщения = НСтр("ru = 'Произошли ошибки при авторизации: не удалось подписать данные авторизации ключом ЭЦП!'");
		//ОбщегоНазначенияКлиент_ненужен.СообщитьПользователю(ТекстСообщения);
		Сообщить(ТекстСообщения);
	Иначе
		
		РезультатСоответствие = uzbled_EImzoСлужебный.ПрочитатьСтрокуJSON(Результат, Истина);
		
		Если РезультатСоответствие.Получить("success") <> Неопределено
			И РезультатСоответствие.Получить("success") Тогда
			
			ПодписанныйТекст = РезультатСоответствие.Получить("pkcs7_64");
			ХэшПодписи = РезультатСоответствие.Получить("signature_hex");
			
			Если ПодписанныйТекст <> Неопределено Тогда
				Токен = АвторизацияЗавершение(Идентификатор, ПодписанныйТекст);
				ЗаписатьНовыйТокен(Организация, Токен);
				ПослеАвторизации = Истина;
				
				Если ЗначениеЗаполнено(Токен) Тогда 
					Если ДопПараметры <> Неопределено Тогда 
						СинхронизоватьКодыМаркировкиССайтом(ДопПараметры.КодыМаркировки, ДопПараметры.ТолькоПроверить);
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				ТекстСообщения = НСтр("ru = 'Произошли ошибки при авторизации: не удалось подписать данные авторизации ключом ЭЦП!'");
				//ОбщегоНазначенияКлиент_ненужен.СообщитьПользователю(ТекстСообщения);
				Сообщить(ТекстСообщения);
			КонецЕсли;
		Иначе
			ТекстСообщения = НСтр("ru = 'Произошли ошибки при авторизации: не удалось подписать данные авторизации ключом ЭЦП!'");
			//ОбщегоНазначенияКлиент_ненужен.СообщитьПользователю(ТекстСообщения);
			Сообщить(ТекстСообщения);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

