&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	Если Параметры.Свойство("ДокументОснование") тогда

		Объект.ДокументОснование=Параметры.ДокументОснование; 
		
		Для каждого ТабСтрока из Параметры.ДокументОснование.Товары Цикл 
			ДокСтрока=Объект.Контроль.Добавить();                                
			Если Не ТабСтрока.Серия.Пустая() тогда
				ДокСтрока.НомерСерии=ТабСтрока.Серия.Наименование; 
			КонецЕсли;	
			//ДокСтрока.Емкость=ТабСтрока.Серия.ЕмкостьУпаковки;
			ДокСтрока.Номенклатура=ТабСтрока.Номенклатура;
			ДокСтрока.GTIN=ТабСтрока.Номенклатура.GTIN;
			ДокСтрока.Количество=ТабСтрока.Количество;
			ДокСтрока.ТипТовара=ТабСтрока.Номенклатура.ВидНоменклатуры.ОсобенностьУчета;
			
			Если ТипЗнч(Объект.ДокументОснование)<>Неопределено  и 	ДокСтрока.НомерСтроки=1 тогда
				ДокСтрока.ВыборСтроки=Истина;
				GTIN1=ДокСтрока.GTIN;
				НомерСерии1=ДокСтрока.НомерСерии;
			ИначеЕсли ТипЗнч(Объект.ДокументОснование)<>Неопределено  и ДокСтрока.НомерСтроки>1 тогда
				Если ДокСтрока.GTIN=GTIN1 и ДокСтрока.НомерСерии=НомерСерии1 тогда
					ДокСтрока.ВыборСтроки=Истина;
				КонецЕсли;
			КонецЕсли;  
		КонецЦикла; 
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Процедура ПроверитьРаботуСДокументами(Отказ)
	ВыборкаСправочника = Справочники.Блокировки.Выбрать();
	Пока ВыборкаСправочника.Следующий() Цикл  
		Если ВыборкаСправочника.Ссылка=Справочники.Блокировки.КомплектацияДвиженияТоваровКМ тогда
			продолжить;
		КонецЕсли;
		
		Если   НЕ ВыборкаСправочника.ДокументОснование.Пустая() тогда
			Сообщить("Пользователь " + ВыборкаСправочника.Наименование+" работает с документом "+ВыборкаСправочника.ДокументОснование);
			Отказ=Истина;
		КонецЕсли;
	КонецЦикла;		
