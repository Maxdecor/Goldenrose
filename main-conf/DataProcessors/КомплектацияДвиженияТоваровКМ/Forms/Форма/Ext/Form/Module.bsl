&НаКлиенте
Процедура ЗаписатьКомплектацию(Команда) 
	
	// проверить на повторную запись
	Если ОпределитьКомплектациюНаСервере(Объект.ДокументОснование) тогда
		Сообщить(" Запись кодов маркировки по документу "+Объект.ДокументОснование+" уже производилась!" );
		Возврат;
	КонецЕсли;
	
	Если Объект.КодыСписок.Количество()=0 Тогда
		Сообщить("Заполните таблицу Комплектация товара!");
		Возврат;
	КонецЕсли;
	
	// проверить на повтор и получить массивы кодов и упаковок  для выборки из реестра КМ
	
	КоличПовторКМ=0;
	МассивКодов=Новый Массив();
	МассивУпаковок=Новый Массив();
	ФлОшиб=0;
	Для каждого ТабСтрока Из Объект.КодыСписок Цикл 
		Если ТабСтрока.Проверка=ложь тогда            // неправильные строки пропускаем
			продолжить;
		КонецЕсли;

		Если МассивКодов.Найти(ТабСтрока.Товар)=Неопределено тогда
			МассивКодов.Добавить();
			МассивКодов[МассивКодов.ВГраница()]=ТабСтрока.Товар; 
			Если ТабСтрока.УровеньУпаковки>0 тогда
				МассивУпаковок.Добавить();
				МассивУпаковок[МассивУпаковок.ВГраница()]=ТабСтрока.Товар; 
			КонецЕсли;
		Иначе
			Сообщить("Строка "+СтрЗаменить(Строка(ТабСтрока.НомерСтроки),Символ(160),"")+" "+Табстрока.КодSSCC1+" "+ТабСтрока.Товар+"  Повтор КМ! ");
			КоличПовторКМ=КоличПовторКМ+1;
			ФлОшиб=1;
		КонецЕсли; 
	КонецЦикла;  
		
	Если ФлОшиб=1 Тогда
		Сообщить("Количество повторных кодов -"+Строка(КоличПовторКМ)+". Запись списка КМ не произведена! ");
		Возврат;
	КонецЕсли;	

	// контроль по документу всех введенных строк
	Если КонтрольПоДокументуПередЗаписью()=Ложь тогда Возврат;
    КонецЕсли;
	
	ЗаписатьКомплектациюНаСервере(МассивКодов,МассивУпаковок);
КонецПроцедуры

