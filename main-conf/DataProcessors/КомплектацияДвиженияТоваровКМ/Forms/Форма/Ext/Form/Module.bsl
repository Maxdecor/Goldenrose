&НаКлиенте
Функция ПолучитьВсеКодыМаркировки()
	
	КодыМаркировки = Новый Массив;
	
	ПотребительскиеКодыМаркировки = Новый Массив;
	ГрупповыеКодыМаркировки = Новый Массив;
	ТранспортныеКодыМаркировки = Новый Массив;

	
	Для Каждого ТабСтр из Объект.КодыСписок Цикл
		//Если ТабСтр.Проверка=Ложь тогда  Продолжить;
		//КонецЕсли;
		
		//ТабСтр.ПроверенНаСайте=Истина;             // предварительно
		Если ТабСтр.УровеньУпаковки=0 тогда
			ПотребительскиеКодыМаркировки.Добавить(ТабСтр.Товар);
		ИначеЕсли ТабСтр.УровеньУпаковки=1 тогда
			ГрупповыеКодыМаркировки.Добавить(ТабСтр.Товар);
		иначе
			ТранспортныеКодыМаркировки.Добавить(ТабСтр.Товар);
		Конецесли;	

	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КодыМаркировки, ПотребительскиеКодыМаркировки, Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КодыМаркировки, ГрупповыеКодыМаркировки, Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КодыМаркировки, ТранспортныеКодыМаркировки, Истина);
	//ДополнитьМассив(КодыМаркировки, ПотребительскиеКодыМаркировки, Истина);
	//ДополнитьМассив(КодыМаркировки, ГрупповыеКодыМаркировки, Истина);
	//ДополнитьМассив(КодыМаркировки, ТранспортныеКодыМаркировки, Истина);
	
	Возврат КодыМаркировки;
	
КонецФункции
&НаКлиенте
Функция ПолучитьАгрегационныеКоды()
	
	КодыМаркировки = Новый Массив;
	

	ПроверкаНаСайте=Ложь;
	Для Каждого ТабСтр из Объект.КодыСписок Цикл
		Если ТабСтр.Проверка=Ложь тогда  Продолжить;
		КонецЕсли;
		
		Если ТабСтр.ПроверенНаСайте>0 Тогда
			ПроверкаНаСайте=Истина;	
		КонецЕсли;
		
		Если ТабСтр.Количество>1 и ТабСтр.ПроверенНаСайте=1 тогда
			КодыМаркировки.Добавить(ТабСтр.Товар);
		Конецесли;	

	КонецЦикла;
	
	Если ПроверкаНаСайте=Ложь тогда
		Сообщить("Выполните проверку кодов!");
	ИначеЕсли КодыМаркировки.Количество()=0 тогда
		Сообщить("Агрегационные коды для распаковки не найдены");
	КонецЕсли;	
	
	Возврат КодыМаркировки;
	
КонецФункции

