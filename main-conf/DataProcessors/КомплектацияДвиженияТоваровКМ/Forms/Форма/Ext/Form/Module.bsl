 #Область СлужебныеФункцииПриВводеДанных

 &НаСервереБезКонтекста
 Функция ПолучитьНоменклатуруНаСервере(pGTIN)
	 Если pGTIN="" тогда
		 Возврат Справочники.Номенклатура.ПустаяСсылка();
	 Иначе
		 Возврат Справочники.Номенклатура.НайтиПоРеквизиту("GTIN",pGTIN);
	 КонецЕсли;
 КонецФункции 

&НаКлиенте
Функция ПолучитьНомерСерииюИзДокумента(GTIN)
	
	НомерСерии="";
	Для Каждого СтрокаДок из Объект.Контроль Цикл
		Если СтрокаДок.ВыборСтроки и СтрокаДок.GTIN=GTIN  тогда
			НомерСерии=СтрокаДок.НомерСерии;
			прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НомерСерии;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьЗаписьИзРеестра(КодМаркировки)
	
		ВозвратСтруктура=Новый Структура; 
	
		Запись=Регистрысведений.КодыМаркировки.СоздатьМенеджерЗаписи(); 
		Запись.КодМаркировки=Кодмаркировки; 
		Запись.Прочитать();
		
		Если Запись.Выбран() тогда
			ВозвратСтруктура.Вставить("Выбран",Истина);
			ВозвратСтруктура.Вставить("КодМаркировки",Запись.КодМаркировки);
			ВозвратСтруктура.Вставить("КодSSCC1",Запись.КодSSCC1);
			ВозвратСтруктура.Вставить("Номенклатура",Запись.Номенклатура);
			ВозвратСтруктура.Вставить("НомерСерии",Запись.НомерСерии);
			ВозвратСтруктура.Вставить("ЕмкостьУпаковки",Запись.ЕмкостьУпаковки);
			ВозвратСтруктура.Вставить("Статус",Запись.Статус);
			ВозвратСтруктура.Вставить("ДокументПрихода",Запись.ДокументПрихода);
			ВозвратСтруктура.Вставить("ДокументРасхода",Запись.ДокументРасхода);
		Иначе
			ВозвратСтруктура.Вставить("Выбран",Ложь);
	    КонецЕсли;
		
		Возврат ВозвратСтруктура; 

КонецФункции

&НаКлиенте
Функция ПолучитьДанныеСтрокиДокумента()
	
	СтруктураВозврат=Новый Структура;
	Если Объект.ДокументОснование<>Неопределено тогда
		Для Каждого СтрокаДок из Объект.Контроль Цикл
	 		Если СтрокаДок.ВыборСтроки   тогда
				СтруктураВозврат.Вставить("GTIN",СтрокаДок.GTIN);
				СтруктураВозврат.Вставить("Номенклатура",СтрокаДок.Номенклатура);
				СтруктураВозврат.Вставить("НомерСерии",СтрокаДок.НомерСерии);
				прервать;
			КонецЕсли;
		КонецЦикла;     
	КонецЕсли;
	
	Если СтруктураВозврат.Количество()=0 тогда
		СтруктураВозврат.Вставить("GTIN","");
		СтруктураВозврат.Вставить("Номенклатура",ПолучитьНоменклатуруНаСервере("")); // пустая ссылка
		СтруктураВозврат.Вставить("НомерСерии","");
		Если Объект.ДокументОснование<>Неопределено тогда
			Сообщить("Не выбрана строка документа");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураВозврат;
	
КонецФункции 
	

&НаКлиенте
Функция ПолучитьСериюНоменклатурыИзДокумента(GTIN)   // полное наименование
	
	НомерСерии="";
	Для Каждого СтрокаДок из Объект.Контроль Цикл
		Если СтрокаДок.ВыборСтроки и СтрокаДок.GTIN=GTIN  тогда
			НомерСерии=СокрЛП(СтрокаДок.НомерСерии);  
			прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НомерСерии;
	
КонецФункции

#КонецОбласти	
	

#Область ИмпортИзCSV

&НаКлиенте 
Функция ПроверкаВыбораСтрок() 
	
	// проверка выбора строк  - оставляем выбор только для одинаковых строк GTIN+НомерСерии

	КоличВыбранныхСтрок=0;
	Для каждого КонтрольСтр Из Объект.Контроль Цикл  
		Если КонтрольСтр.ВыборСтроки  и КоличВыбранныхСтрок=0 тогда
			GTIN0=КонтрольСтр.GTIN;
			НомерСерии0=КонтрольСтр.НомерСерии;
			КоличВыбранныхСтрок=КоличВыбранныхСтрок+1;
		иначе	
			Если КонтрольСтр.GTIN<>GTIN0 или КонтрольСтр.НомерСерии<>НомерСерии0 тогда
				КонтрольСтр.ВыборСтроки=Ложь;
			иначе
				КоличВыбранныхСтрок=КоличВыбранныхСтрок+1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат КоличВыбранныхСтрок; 
	
КонецФункции

&НаКлиенте 
Процедура ЗагрузкаИзCSVНачало(Команда) 
	
	КоличВыбранныхСтрок=ПроверкаВыбораСтрок(); 
		
	Если КоличВыбранныхСтрок=0  тогда
		Если  Объект.ДокументОснование=Неопределено Тогда
			  КоличВыбранныхСтрок=1;
		иначе
			Сообщить("Выберите строки документа для загрузки");
			Возврат;
		КонецЕсли;
	КонецЕсли;
			
	Если КоличВыбранныхСтрок>0 Тогда
	//ВыполнитьОбработкуОповещения(Оповещение);
		ОчиститьСписокКМНачало(Новый ОписаниеОповещения("ЗагрузкаИзCSVПродолжение",ЭтотОбъект));	// очистка с вопросом
	КонецЕсли;
КонецПроцедуры

&НаКлиенте 
Процедура ЗагрузкаИзCSVПродолжение(Результат,ДопПараметры) Экспорт

	НачСпискаКМ=Объект.КодыСписок.Количество()+1;            // начало загруженных кодов
	
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	Фильтр = НСтр("ru = 'Выберите CSV файл'")+ "(*.CSV)|*.CSV";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Выберите CSV файл";
	
	ФлОшиб=0;

	
		Если ДиалогОткрытияФайла.Выбрать() Тогда 
			ЗагрузитьИзФайла(ДиалогОткрытияФайла.ПолноеИмяФайла,1,ФлОшиб);   
			Если ФлОшиб=1 тогда 
				возврат;
			КонецЕсли;	
		КонецЕсли;	
		
	Если  Объект.ДокументОснование<>Неопределено тогда   // контроль и подсчет количества по документу
		
		Для каждого ТабСтрока Из Объект.КодыСписок Цикл 
			Если ТабСтрока.НомерСтроки<НачСпискаКМ тогда Продолжить;  
			КонецЕсли;
			ТабСтрока.Проверка=Истина; 
			СтрокаДокумента=Неопределено;
			Если Не КонтрольПоДокументу(ТабСтрока.GTIN,ТабСтрока.Количество,ТабСтрока.НомерСтроки,СтрокаДокумента) тогда
				ТабСтрока.Проверка=Ложь; 
			иначе
				ТабСтрока.Проверка=Истина; 
				ТабСтрока.Номенклатура=СтрокаДокумента.Номенклатура;
				ТабСтрока.НомерСерии=СтрокаДокумента.НомерСерии; 
			КонецЕсли;
		 КонецЦикла;
		
	КонецЕсли;	
 КонецПроцедуры  


&НаКлиенте
Процедура ЗагрузитьИзФайла(ПутьКФайлу,НомерСтрокиДокумента,ФлОшиб) 
		
	Документ= Новый ТекстовыйДокумент;
	Документ.Прочитать(ПутьКФайлу); 

	
	КодSSCC1Нач="0";
	НомерСтроки=1; 
	мВведеноУпаковок=0;
	мВведено=0;
	КоличКмВУпаковке=0;
	
	КолСтрок=Документ.КоличествоСтрок();

	КоличКмВУпаковке=Емкость;
 	ВложенныеУпаковки=Новый Структура;
	
	СтрокаКонтроль=ПолучитьДанныеСтрокиДокумента();

	ФлОшиб=0;

	Для Инд=НомерСтроки По КолСтрок Цикл
		СтрокаДокумента=Документ.ПолучитьСтроку(Инд);
		
		Если Прав(СтрокаДокумента,1)=";"  тогда
			ФлУпак=1;
		ИначеЕсли Лев(СтрокаДокумента,1)=";" Тогда
			ФлУпак=0;
		ИначеЕсли УпаковкаУровень>1 тогда	
			ФлУпак=1;
		//ИначеЕсли Лев(СтрокаДокумента,2)="01" и Сред(СтрокаДокумента,17,2)="21" Тогда
		//     ФлУпак=0;
        Иначе
            ФлУпак=0;
		КонецЕсли;	
			
		Если ФлУпак=1 тогда                                                    
			КодSSCC1=СокрЛП(СтрЗаменить(СтрокаДокумента,";",""));
			Если КодSSCC1=""  тогда продолжить;   // пропуск пустых строк
			КонецЕсли;
			
	 		Если Лев(КодSSCC1,2)="01" и Сред(КодSSCC1,17,2)="21"  тогда 
				Если ТипУпаковки=ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ТранспортнаяУпаковка") тогда 
					Сообщить("Несоответствие структуры КМ выбраннму типу упаковки! Импорт прекращен!") ; 
					ТабСтрока=Объект.КодыСписок.Добавить();
					ТабСтрока.Товар=КодSSCC1; 
					ФлОшиб=1;
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
			Если КодSSCC1Нач="0" тогда    // первый вход
				Если Инд>1 тогда
					Сообщить("Файл импорта содержит коды упаковок. Строки 1-"+Строка(Инд-1)+" не имеют кода упаковки! Импорт прекращен!");
					ФлОшиб=1;
					Возврат;
				Иначе
					Если УпаковкаУровень<=1  тогда
						Сообщить("Файл импорта содержит коды упаковок. Выберите транспортную упаковку! ");
						ФлОшиб=1;
					иначе
						ВложенныеУпаковки=ПолучитьПараметрыВложеннойУпаковки(УпаковкаЕдИзм,УпаковкаУровень);
					КонецЕсли;	
					Если ФлОшиб=1 тогда
						Возврат;
					иначе
						Элементы.Контроль.ПодчиненныеЭлементы.КонтрольСертификация.Видимость=Ложь;
						КодSSCC1Нач=КодSSCC1;
						мВведено=мВведено+КоличКмВУпаковке;
						КоличКмВУпаковке=0;
					Конецесли;
					
				Конецесли;
				
			ИначеЕсли КодSSCC1<>КодSSCC1Нач тогда 
				Если КоличКмВУпаковке <> Емкость  тогда
					//Если Объект.ДокументОснование=Неопределено тогда
						Если КоличКмВУпаковке > 0  тогда
							Сообщить("Отклонение! Код упаковки -"+КодSSCC1Нач+" - количество КМ "+Строка(КоличКмВУпаковке)); 
						КонецЕсли;	
					//КонецЕсли;
				КонецЕсли;;
				мВведеноУпаковок=мВведеноУпаковок+1;
				Если КоличКмВУпаковке=0 тогда      // только упаковка
					ТабСтрока=Объект.КодыСписок.Добавить();
					//ТабСтрока.КодSSCC1=КодSSCC1Нач; 
					ТабСтрока.Товар=КодSSCC1Нач; 
					ТабСтрока.Статус=0;
					ТабСтрока.ЕмкостьУпаковки=Емкость;
					ТабСтрока.Количество=УпаковкаКоличество;
					ТабСтрока.УровеньУпаковки=УпаковкаУровень;
					ТабСтрока.ТипУпаковки=ТипУпаковки;
					
					мВведено=мВведено+Емкость;
					Если Объект.ДокументОснование=Неопределено тогда
						ТабСтрока.Проверка=Истина;
						//ТабСтрока.Номенклатура=ПолучитьНоменклатуруНаСервере(ТабСтрока.GTIN);
					Иначе
						ТабСтрока.GTIN=СтрокаКонтроль.GTIN;
						ТабСтрока.НомерСерии=СтрокаКонтроль.НомерСерии;	
					Конецесли;
				КонецЕсли;
				КодSSCC1Нач=КодSSCC1; 
				мВведено=мВведено+КоличКмВУпаковке;
				КоличКмВУпаковке=0;
			КонецЕсли;	
			
			Продолжить;
		КонецЕсли;
		
		// вложенный код
		КоличКмВУпаковке=КоличКмВУпаковке+1;
		КодМаркировки=СокрЛП(СтрЗаменить(СтрокаДокумента,";",""));   
		
		ТабСтрока=Объект.КодыСписок.Добавить();
		ТабСтрока.Товар=КодМаркировки; 
		ТабСтрока.КодSSCC1=КодSSCC1; 
		ТабСтрока.Статус=0;

		Если ВложенныеУпаковки.Количество()>0 Тогда 
			ТабСтрока.ЕмкостьУпаковки=ВложенныеУпаковки.Емкость;
			ТабСтрока.Количество=ВложенныеУпаковки.Количество;
			ТабСтрока.УровеньУпаковки=ВложенныеУпаковки.УровеньУпаковки;
			ТабСтрока.ТипУпаковки=ВложенныеУпаковки.ТипУпаковки;
		иначе	
			ТабСтрока.ЕмкостьУпаковки=Емкость;
			ТабСтрока.Количество=УпаковкаКоличество;
			ТабСтрока.УровеньУпаковки=УпаковкаУровень;
			ТабСтрока.ТипУпаковки=ТипУпаковки; 
		КонецЕсли;  
		
		Если ТабСтрока.УровеньУпаковки<2 тогда         // потребительская или групповая
			ТабСтрока.Товар=УбратьКодПроверкиИКриптохвост(ТабСтрока.Товар,ТабСтрока.УровеньУпаковки,ТипТовара);
			ТабСтрока.GTIN=ПолучитьGTINПоКодуМаркировки(ТабСтрока.Товар,ТабСтрока.УровеньУпаковки,ТипТовара); 
			Если ТабСтрока.GTIN=Неопределено тогда
				Сообщить("Строка "+СтрЗаменить(Строка(ТабСтрока.НомерСтроки),Символ(160),"")+" КМ "+ТабСтрока.Товар+" не содержит GTIN! ");
			КонецЕсли;	
		иначе  // GTIN по документу
			ТабСтрока.GTIN=СтрокаКонтроль.GTIN;
		КонецЕсли;
		
		ТабСтрока.НомерСерии=СтрокаКонтроль.НомерСерии;	

			
		Если Объект.ДокументОснование=Неопределено тогда
			ТабСтрока.Проверка=Истина;
			//ТабСтрока.Номенклатура=ПолучитьНоменклатуруНаСервере(ТабСтрока.GTIN);
		Конецесли;
	КонецЦикла;  
	

	// последняя упаковка
	Если КодSSCC1<>Неопределено тогда
		Если КоличКмВУпаковке<>Емкость  тогда
			Если КоличКмВУпаковке > 0  тогда
				//Сообщить("Отклонение! Код коробки -"+КодSSCC1+" - количество КМ "+Строка(КоличКмВУпаковке)); 
				Сообщить("Отклонение! Код коробки -"+КодSSCC1+" - количество КМ "+Формат(КоличКмВУпаковке,"Ч10")); 
			КонецЕсли;	
			Если КоличКмВУпаковке=0 тогда      // только упаковка
				ТабСтрока=Объект.КодыСписок.Добавить();
				//ТабСтрока.КодSSCC1=КодSSCC1Нач; 
				ТабСтрока.Товар=КодSSCC1Нач; 
				ТабСтрока.Статус=0;
				ТабСтрока.ЕмкостьУпаковки=Емкость;
				ТабСтрока.Количество=УпаковкаКоличество;
				ТабСтрока.УровеньУпаковки=УпаковкаУровень;
				ТабСтрока.ТипУпаковки=ТипУпаковки;

				мВведено=мВведено+Емкость;
				Если Объект.ДокументОснование=Неопределено тогда
					ТабСтрока.Проверка=Истина;
					//ТабСтрока.Номенклатура=ПолучитьНоменклатуруНаСервере(ТабСтрока.GTIN);  
				Иначе
					ТабСтрока.GTIN=СтрокаКонтроль.GTIN;
					ТабСтрока.НомерСерии=СтрокаКонтроль.НомерСерии;	
				Конецесли;
			КонецЕсли;
		КонецЕсли;
		мВведеноУпаковок=мВведеноУпаковок+1
	КонецЕсли;
	
	Если Объект.ДокументОснование=Неопределено тогда
		//Введено=Объект.КодыСписок.Количество(); 
		Введено=мВведено;
		ВведеноУпаковок=мВведеноУпаковок;
	иначе
		//Емкость=0;       // по документу используется для построчного контроля
	КонецЕсли;	
	
КонецПроцедуры
#КонецОбласти

&НаСервереБезКонтекста
Функция ОпределитьКомплектациюНаСервере(ДокументОснование)
        ЕстьМаркировка=Ложь;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	КодыМаркировки.Статус КАК Статус,
			|	КодыМаркировки.ДокументРасхода КАК ДокументРасхода,
			|	КодыМаркировки.КодМаркировки КАК КодМаркировки
			|ИЗ
			|	РегистрСведений.КодыМаркировки КАК КодыМаркировки
			|ГДЕ
			|	КодыМаркировки.ДокументПрихода = &Ссылка";   
		
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") тогда //расход  
        	Запрос.Текст=СтрЗаменить(Запрос.Текст,"ДокументПрихода","ДокументРасхода");
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
		
		РезультатЗапроса = Запрос.Выполнить();  
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Если ВыборкаДетальныеЗаписи.Количество()>0 Тогда
			ЕстьМаркировка=Истина;
		КонецЕсли; 
		Возврат ЕстьМаркировка;
КонецФункции

&НаСервере
Процедура ЗаписатьКомплектациюНаСервере(МассивКодов,МассивУпаковок) 

	МассивРазагрегации=Новый Массив();

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КодыМаркировки.КодМаркировки КАК КодМаркировки,
	|	КодыМаркировки.ДокументПрихода.Ссылка КАК ДокументПрихода,
	|	КодыМаркировки.ДокументРасхода.Ссылка КАК ДокументРасхода,
	|	КодыМаркировки.Статус КАК Статус,
	|	КодыМаркировки.КоличествоЕдиницТовара КАК КоличествоЕдиницТовара,
	|	КодыМаркировки.Номенклатура КАК Номенклатура,
	|	КодыМаркировки.КодSSCC1 КАК КодSSCC1
	|ИЗ
	|	РегистрСведений.КодыМаркировки КАК КодыМаркировки
	|ГДЕ
	|	(КодыМаркировки.КодМаркировки В (&МассивКодов)
	|			ИЛИ КодыМаркировки.КодSSCC1 В (&МассивУпаковок))
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодМаркировки";
	
	Запрос.УстановитьПараметр("МассивКодов", МассивКодов);
	Запрос.УстановитьПараметр("МассивУпаковок", МассивУпаковок);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	ВыборкаТЗ=РезультатЗапроса.Выгрузить();

	Если ВыборкаТЗ.Количество()>0 тогда     // проверка найденных кодов  
		
		Для Каждого Выборка из ВыборкаТЗ Цикл
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Товар", Выборка.КодМаркировки);
			НайденныеСтроки = Объект.КодыСписок.НайтиСтроки(ПараметрыОтбора);
			ТабСтрока=Неопределено;
			Если НайденныеСтроки.Количество()>0  тогда 
				Если НайденныеСтроки[0].Проверка тогда 
					ТабСтрока=НайденныеСтроки[0];      // код есть в списке КМ
				КонецЕсли;
			КонецЕсли;	 
			
			Если ТабСтрока<>Неопределено тогда 
				ФлОшибЗап=ПроверитьЗапись(Выборка,НайденныеСтроки[0]);
				Если ФлОшибЗап=1 тогда
					ФлОшиб=1;
				КонецЕсли;
				
			иначе	//  поиск упаковки - в выборку КМ попал по агрегатному коду	
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Товар", Выборка.КодSSCC1);
				НайденныеСтроки = Объект.КодыСписок.НайтиСтроки(ПараметрыОтбора); 
				Если НайденныеСтроки.Количество()>0 тогда   // найден агрегатный код - разогрегация ошибка
					Если МассивРазагрегации.Найти(Выборка.КодSSCC1)=Неопределено тогда
						МассивРазагрегации.Добавить();
						МассивРазагрегации[МассивРазагрегации.ВГраница()]=Выборка.КодSSCC1; 
					КонецЕсли; 
				КонецЕсли;
			КонецЕсли;	
			
		КонецЦикла;
	КонецЕсли;
		
	Если МассивРазагрегации.Количество()>0 тогда    // вывод сообщений об ошибках разагрегации
		Для инд=0 по МассивРазагрегации.Количество()-1 Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Товар", МассивРазагрегации[инд]);
			НайденныеСтроки = Объект.КодыСписок.НайтиСтроки(ПараметрыОтбора); 
