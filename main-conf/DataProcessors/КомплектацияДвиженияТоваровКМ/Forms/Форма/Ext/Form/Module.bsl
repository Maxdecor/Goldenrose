&НаСервере
Функция СформироватьСписокВыбораНаСервере(НоменклатураСсылка) 
	МассивСЗ=Новый Массив;
	Если НоменклатураСсылка.ИспользоватьУпаковки=Ложь тогда
		МассивСЗ.Вставить(0,НоменклатураСсылка.ЕдиницаИзмерения);  // базовая единица измерния
	иначе
		Если НоменклатураСсылка.наборУпаковок=Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры тогда
			Владелец=НоменклатураСсылка;
		Иначе
			Владелец=НоменклатураСсылка.наборУпаковок;
		КонецЕсли;
		
		Выборка=Справочники.УпаковкиЕдиницыИзмерения.Выбрать(,Владелец,,"Наименование");	

		Пока Выборка.Следующий() Цикл
			Если Выборка.Наименование=НоменклатураСсылка.ЕдиницаИзмерения.Наименование тогда
				МассивСЗ.Вставить(0,Выборка.Ссылка);  // базовая единица измерния
			иначе
				МассивСЗ.Добавить(Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат МассивСЗ;     //НоменклатураСсылка.ЕдиницаИзмерения=Выборка.Ссылка
КонецФункции 

&НаКлиенте
Процедура УпаковкаКоличествоЗаполнитьСписокВыбора()
	Элементы.УпаковкаЕдИзм.СписокВыбора.Очистить();
	СтрокаДок=ПолучитьДанныеСтрокиДокумента();
	МассивДляВыбора=СформироватьСписокВыбораНаСервере(СтрокаДок.Номенклатура);
	Элементы.УпаковкаЕдИзм.СписокВыбора.ЗагрузитьЗначения(МассивДляВыбора);
	УпаковкаЕдИзм=МассивДляВыбора[0]; 
	УпаковкаКоличествоПриИзменении(Неопределено)
КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоИЕмкостьУпаковкиНаСервере(УпаковкаСсылка)
	текст="";
    Уровень=0;

	КоличествоУпаковок=УпаковкаСсылка.КоличествоУпаковок; 
	ПредыдущаяУпаковка=УпаковкаСсылка; 

	Пока  КоличествоУпаковок>0 Цикл 
		Текст=Текст+Строка(КоличествоУпаковок)+"X";
		Уровень=Уровень+1;
		ПредыдущаяУпаковка=ПредыдущаяУпаковка.Родитель;
		КоличествоУпаковок=ПредыдущаяУпаковка.КоличествоУпаковок;  // предыдущая упаковка
	КонецЦикла;  
	
	Если КоличествоУпаковок=0 и Уровень>0 тогда  // последняя упаковка 
		Текст=Текст+Строка(ПредыдущаяУпаковка.Числитель)+"X";
		Уровень=Уровень+1;
	КонецЕсли;	
	
	Если Текст<>"" Тогда
		Текст=Сред(Текст,1,СтрДлина(Текст)-1);  
		Если Текст="1" тогда
			Текст="";
		иначе
	    	Текст="("+Текст+")";
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыУпаковки=Новый Структура;
	ПараметрыУпаковки.Вставить("текст", текст);
	ПараметрыУпаковки.Вставить("Количество", УпаковкаСсылка.Числитель);
	ПараметрыУпаковки.Вставить("Емкость", УпаковкаСсылка.КоличествоУпаковок); 
	ПараметрыУпаковки.Вставить("Уровень", Уровень); 
		
	Возврат ПараметрыУпаковки;
	
КонецФункции 

&НаКлиенте
Процедура УпаковкаКоличествоПриИзменении(Элемент)
	
	ПараметрыУпаковки=ПолучитьКоличествоИЕмкостьУпаковкиНаСервере(УпаковкаЕдИзм);
	
	УпаковкаКоличество=ПараметрыУпаковки.Количество;
	Емкость=ПараметрыУпаковки.Емкость;
	УпаковкаУровень=ПараметрыУпаковки.Уровень;
	
	Текст=ПараметрыУпаковки.Текст; 
	Элементы.ДекорацияПредупреждение.Заголовок="";
	Элементы.ДекорацияПредупреждение.Видимость=Ложь;
	
	Если (Емкость=0 и УпаковкаКоличество=0) или (Емкость=0 и УпаковкаКоличество=1) или (Емкость=1 и УпаковкаКоличество=1) тогда
		ТипУпаковки=ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ПотребительскаяУпаковка");
		Текст=Текст+" Потребительская"; 
		УпаковкаУровень=0;
	ИначеЕсли Емкость=0 и УпаковкаКоличество>1 тогда
		ТипУпаковки=ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ГрупповаяУпаковка"); 
		Текст=Текст+" Групповая";
		УпаковкаУровень=1;
		Емкость=УпаковкаКоличество;
	иначе
		ТипУпаковки=ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ТранспортнаяУпаковка"); 
		Текст=Текст+" Транспортная";
		Элементы.ДекорацияПредупреждение.Заголовок="Для транспортных упаковок GTIN подставляется из документа!";
		Элементы.ДекорацияПредупреждение.Видимость=Истина;
	КонецЕсли;
	Элементы.ДекорацияУпаковка.Заголовок=Текст;

КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыВложеннойУпаковки(УпаковкаСсылка,УровеньУпаковки)
	
	ПараметрыУпаковки=Новый Структура;  
	
	Если УровеньУпаковки>1 Тогда
	
		ВложеннаяУпаковка=УпаковкаСсылка.Родитель;

		ПараметрыУпаковки.Вставить("Количество", ВложеннаяУпаковка.Числитель);
		ПараметрыУпаковки.Вставить("Емкость", ВложеннаяУпаковка.КоличествоУпаковок);

		Если ВложеннаяУпаковка.КоличествоУпаковок=0 и ВложеннаяУпаковка.Числитель>1 Тогда   // групповая
			ПараметрыУпаковки.Вставить("УровеньУпаковки", 1);
			ПараметрыУпаковки.Вставить("ТипУпаковки",ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ГрупповаяУпаковка")); 

		ИначеЕсли ВложеннаяУпаковка.КоличествоУпаковок=0 и ВложеннаяУпаковка.Числитель=1 Тогда   // потребительская
			ПараметрыУпаковки.Вставить("УровеньУпаковки", 0);
			ПараметрыУпаковки.Вставить("ТипУпаковки",ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ПотребительскаяУпаковка")); 
		иначе	
			ПараметрыУпаковки.Вставить("УровеньУпаковки",УровеньУпаковки-1);
			ПараметрыУпаковки.Вставить("ТипУпаковки",ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ТранспортнаяУпаковка")); 
		КонецЕсли;

	КонецЕсли;

	Возврат ПараметрыУпаковки;
	
КонецФункции 

&НаКлиенте
Функция ПолучитьGTINПоКодуМаркировки(КодМаркировки,УровеньУпаковки,ТипТовара);
	
	Если УровеньУпаковки>2  Тогда 
	     Возврат Неопределено;
	КонецЕсли;

	Если ТипТовара=ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.ТабачнаяПродукция") и 
		 УровеньУпаковки=0 тогда
		 GTIN=Сред(КодМаркировки,1,14); 
	иначеЕсли Сред(КодМаркировки,1,2)="01" тогда	// признак GTIN	
		GTIN=Сред(КодМаркировки,3,14);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат GTIN;
КонецФункции 

&НаКлиенте
Функция УбратьКодПроверкиИКриптохвост(КодМаркировки,УровеньУпаковки,ТипТовара);
	
	Если УровеньУпаковки>1 Тогда 
	     Возврат КодМаркировки;          // без изменений   транспортная упаковка
	 КонецЕсли;
	 
	
	//Для Поз29=1 по СтрДлина(КодМаркировки) Цикл 
	//	Если КодСимвола(Сред(КодМаркировки,Поз29,1))=29 тогда
	//		Если Сред(КодМаркировки,Поз29+1,2)="91" тогда
	//			КодМаркировки=Сред(КодМаркировки,1,Поз29-1);  // усеченный код GTIN + серия 
	//		КонецЕсли;	
	//		Прервать;
	//	КонецЕсли;
	//КонецЦикла;

	//Возврат КодМаркировки;
	
	
	Если ТипТовара=ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.ТабачнаяПродукция") тогда
		Если  УровеньУпаковки=0 тогда
	 		КодМаркировки=Сред(КодМаркировки,1,21); 
		иначе		
		 	КодМаркировки=Сред(КодМаркировки,1,25); 
		КонецЕсли;

	ИначеЕсли ТипТовара=ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.АлкогольнаяПродукция") или
		      ТипТовара=ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.Пиво") или 
	          ТипТовара=ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.БезалкогольноеПиво") тогда 
		
		Если  УровеньУпаковки=0 тогда
	 		КодМаркировки=Сред(КодМаркировки,1,25); 
		иначе		
		 	КодМаркировки=Сред(КодМаркировки,1,31); 
		КонецЕсли;

	ИначеЕсли ТипТовара=ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.ЛекарственныеСредства") тогда 
		КодМаркировки=Сред(КодМаркировки,1,31); 

	ИначеЕсли ТипТовара=ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.УпакованнаяВода") тогда  
		КодМаркировки=Сред(КодМаркировки,1,31); 

	ИначеЕсли ТипТовара=ПредопределенноеЗначение("Перечисление.ОсобенностиУчетаНоменклатуры.БытоваяТехника") тогда 
 		КодМаркировки=Сред(КодМаркировки,1,38); 
    КонецЕсли;

	Возврат КодМаркировки;
КонецФункции 

&НаКлиенте
Процедура ЗакрытьРаспаковку(Команда)
	Объект.КодыРаспаковки.Очистить();
	Элементы.КодыРаспаковки.Видимость=Ложь;
КонецПроцедуры


&НаКлиенте
Процедура ЗаписатьРаспаковкуВРеестрКМ(Команда)
	Если Объект.КодыРаспаковки.Количество()>0 тогда  
		Если Объект.КодыРаспаковки[0].Проверка=Ложь тогда
			Сообщить("Запись не требуется. Вложенные коды не найдены!");
			Возврат;
		Иначе
			ЗаписатьРаспаковкуВРеестрНаСервере(Объект.КодыРаспаковки[0].КодSSCC1)
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРаспаковкуВРеестрНаСервере(КодSSCC1) 
	
	//МассивКодов=Новый Массив(1); 
	//МассивКодов[0]=КодSSCC1;   

	МассивУпаковок=Новый Массив(1);
	МассивУпаковок[0]=КодSSCC1; 

	МассивКодов=Новый Массив(); 

	МассивКодов.Добавить();
	МассивКодов[МассивКодов.ВГраница()]=КодSSCC1;       // упаковка

	Для каждого ТабСтрока Из Объект.КодыРаспаковки Цикл    // коды разагрегации
		МассивКодов.Добавить();
		МассивКодов[МассивКодов.ВГраница()]=ТабСтрока.Товар; 
    КонецЦикла;

	// проверка на наличие кодов в реестре	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КодыМаркировки.КодМаркировки КАК КодМаркировки,
			|	КодыМаркировки.ДокументПрихода.Ссылка КАК ДокументПрихода,
			|	КодыМаркировки.ДокументРасхода.Ссылка КАК ДокументРасхода,
			|	КодыМаркировки.Статус КАК Статус,
			|	КодыМаркировки.КоличествоЕдиницТовара КАК КоличествоЕдиницТовара,
			|	КодыМаркировки.Номенклатура КАК Номенклатура,
			|	КодыМаркировки.КодSSCC1 КАК КодSSCC1
			|ИЗ
			|	РегистрСведений.КодыМаркировки КАК КодыМаркировки
			|ГДЕ
			|	(КодыМаркировки.КодМаркировки В (&МассивКодов)
			|			ИЛИ КодыМаркировки.КодSSCC1 В (&МассивУпаковок))
			|
			|УПОРЯДОЧИТЬ ПО
			|	КодМаркировки";
		
		Запрос.УстановитьПараметр("МассивКодов", МассивКодов);
		Запрос.УстановитьПараметр("МассивУпаковок", МассивУпаковок);
		
		РезультатЗапроса = Запрос.Выполнить(); 
		
		//ВыборкаТЗ=РезультатЗапроса.Выгрузить();

		Выборка = РезультатЗапроса.Выбрать();    
		
		Если Выборка.Количество()=0 тогда     // Кода в регистре нет - ошибка
		    Сообщить("Код упаковки "+КодSSCC1+" в реестре не найден! Ошибка.");
		    Возврат; 
		ИначеЕсли Выборка.Количество()>1 тогда 
			Сообщить("Код упаковки "+КодSSCC1+" уже разагрегирован! Ошибка.");
			Возврат; 
		ИначеЕсли Выборка.Следующий() и Выборка.КодМаркировки<>КодSSCC1 тогда 
		    Сообщить("Код упаковки "+КодSSCC1+" в реестре не найден! Ошибка.");
		    Возврат; 
		КонецЕсли;
		
       // запись вложенных кодов
		
	   Запись=Регистрысведений.КодыМаркировки.СоздатьМенеджерЗаписи(); 
	   Запись.КодМаркировки=КодSSCC1; 
	   Запись.Прочитать(); 
	   Если Запись.Выбран() тогда
		   // сохраним значения
		   КодSSCC1=Запись.КодМаркировки;
		   КоличествоЕдиницТовара=Запись.КоличествоЕдиницТовара;
		   Номенклатура=Запись.Номенклатура;
		   НомерСерии=Запись.НомерСерии; 
		   Статус=Запись.Статус;
		   ДокументПрихода=Запись.ДокументПрихода; 
		   ДокументРасхода=Запись.ДокументРасхода; 	
		   
		   // изменим реквизиты агрегатного кода
		   Запись.КоличествоЕдиницТовара=0;
		   Запись.Статус=0;
		   Запись.ДокументПрихода=""; 
		   Запись.ДокументРасхода=""; 	
		   Запись.Записать(); 
	   КонецЕсли;
	   
	   КоличествоВложенныхКодов=Объект.КодыРаспаковки.Количество();

	   Для Каждого ТабСтр из Объект.КодыРаспаковки Цикл
		   Запись=Регистрысведений.КодыМаркировки.СоздатьМенеджерЗаписи(); 
		   Запись.КодМаркировки=ТабСтр.Товар; 
		   Запись.Прочитать();
		   Если Не Запись.Выбран() тогда
			   Запись.ПроверенНаСайте=Истина;
			   Запись.КодSSCC1=КодSSCC1;
			   Запись.КодМаркировки=ТабСтр.Товар;
			   Запись.КоличествоЕдиницТовара=КоличествоЕдиницТовара/КоличествоВложенныхКодов;
			   Запись.Номенклатура=Номенклатура;
			   Запись.НомерСерии=НомерСерии; 
			   Запись.ТипУпаковки=ТабСтр.ТипУпаковки;
			   Запись.ЕмкостьУпаковки=ТабСтр.ЕмкостьУпаковки;
			   Запись.Статус=Статус;
			   Запись.ДокументПрихода=ДокументПрихода; 
			   Запись.ДокументРасхода=ДокументРасхода; 	
			   Запись.Записать();
		   КонецЕсли;
		   
	   КонецЦикла;	

	   Сообщить("Выполнена запись распакованных кодов в реестр КМ"); 

		            
КонецПроцедуры

