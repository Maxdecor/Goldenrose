Процедура ЗаписатьНовыйТокен(Организация, Токен) Экспорт
	
	Запись = РегистрыСведений.aslbelgisi_Токены.СоздатьМенеджерЗаписи();
	Запись.Организация = Организация;
	Запись.Токен = Токен;
	Запись.Записать(Истина);
	
КонецПроцедуры

Функция ПолучитьРезультатнуюСтруктуруИзСайтаДляМаркировки(ТекущаяТаблица, ТаблицаИзСайта, ТипТовара) Экспорт
	
	Результат = Новый Структура;
	
	// Несуществующие коды
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТекущаяТаблица.Код КАК КодМаркировки,
		|	ТекущаяТаблица.Пометка КАК Пометка,
		|	ТекущаяТаблица.ТипУпаковки КАК ТипУпаковки,
		|	ТекущаяТаблица.ТипТовара КАК ТипТовара
		|ПОМЕСТИТЬ ВТ_НесуществующиеКоды
		|ИЗ
		|	&ТекущаяТаблица КАК ТекущаяТаблица
		|ГДЕ
		|	ТекущаяТаблица.Код НЕ В(&Код)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_НесуществующиеКоды.КодМаркировки КАК КодМаркировки,
		|	ВТ_НесуществующиеКоды.Пометка КАК Пометка,
		|	ВТ_НесуществующиеКоды.ТипУпаковки КАК ТипУпаковки,
		|	ВТ_НесуществующиеКоды.ТипТовара КАК ТипТовара
		|ИЗ
		|	ВТ_НесуществующиеКоды КАК ВТ_НесуществующиеКоды";
	
	Запрос.УстановитьПараметр("ТекущаяТаблица", ТекущаяТаблица);
	Запрос.УстановитьПараметр("Код", ТаблицаИзСайта.ВыгрузитьКолонку("Код"));
	
	НесуществующиеКоды1 = Запрос.Выполнить().Выгрузить();
	Результат.Вставить("НесуществующиеКоды", НесуществующиеКоды1);
	
	// Проверить статус кодов
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаИзСайта.Код КАК КодМаркировки,
		|	ТаблицаИзСайта.СтатусКода КАК СтатусКода
		|ПОМЕСТИТЬ ВТ_ТаблицаИзСайта
		|ИЗ
		|	&ТаблицаИзСайта КАК ТаблицаИзСайта
		|ГДЕ
		|	НЕ ТаблицаИзСайта.СтатусКода В (&СтатусКода)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТаблицаИзСайта.КодМаркировки КАК КодМаркировки,
		|	ВТ_ТаблицаИзСайта.СтатусКода КАК СтатусКода
		|ИЗ
		|	ВТ_ТаблицаИзСайта КАК ВТ_ТаблицаИзСайта";
	
	СтатусКода = Новый Массив;
	СтатусКода.Добавить(Перечисления.aslbelgisi_СтатусКодовМаркировки.ПустаяСсылка());
