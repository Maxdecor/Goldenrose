&НаСервере
Функция ЗаполнитьРеквизиты(ДокументОснованиеСсылка)
	ДокументОснованиеОбъект=ДокументОснованиеСсылка.ПолучитьОбъект(); 
	ТекстДекорации = Формат(
	"Склад: " + ДокументОснованиеОбъект.Склад.Наименование + " / " +
	"Контрагент: " + ДокументОснованиеОбъект.Контрагент.Наименование + " / " +
	?(Не ПустаяСтрока(ДокументОснованиеОбъект.Договор.Наименование), " / " +
	"Договор: " + ДокументОснованиеОбъект.Договор.Наименование, "")); 
	
	
	СоответствиеВозврат=Новый Соответствие;
	СоответствиеВозврат.Вставить("Организация",ДокументОснованиеОбъект.Организация); 
	СоответствиеВозврат.Вставить("ТекстДекорации",ТекстДекорации); 
	
	Возврат СоответствиеВозврат;
	
