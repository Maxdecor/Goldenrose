&НаСервереБезКонтекста
Функция	ПроверитьНаличиеКодSSCC1ВРеестре(КодАгрегации,ДокументОснованиеСсылка);
	// поиск в реестре
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КодыМаркировки.КодМаркировки КАК КодМаркировки,
		|	КодыМаркировки.Номенклатура КАК Номенклатура,
		|	КодыМаркировки.Статус КАК Статус,
		|	КодыМаркировки.ДокументПрихода КАК ДокументПрихода,
		|	КодыМаркировки.ДокументРасхода КАК ДокументРасхода,
		|	КодыМаркировки.Номенклатура.GTIN КАК GTIN,
		|	КодыМаркировки.КодSSCC1 КАК КодSSCC1,
		|	КодыМаркировки.ЕмкостьУпаковки КАК ЕмкостьУпаковки,
		|	КодыМаркировки.КоличествоЕдиницТовара КАК КоличествоЕдиницТовара,
		|	КодыМаркировки.НомерСерии КАК НомерСерии
		|ИЗ
		|	РегистрСведений.КодыМаркировки КАК КодыМаркировки
		|ГДЕ
		|	КодыМаркировки.КодSSCC1 = &КодSSCC
		|
		|УПОРЯДОЧИТЬ ПО
		|	КодМаркировки";
	
	Запрос.УстановитьПараметр("КодSSCC", КодАгрегации);
	
	ФлагВозврата=Истина;

	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка= РезультатЗапроса.Выбрать();
	//Если Выборка.Количество()>0 и Объект.ДокументОснование=Неопределено тогда
	Если Выборка.Количество()>0 и ДокументОснованиеСсылка=Неопределено тогда
		Сообщить(" Код упаковки "+КодАгрегации+" в реестре КМ уже есть!") ;
		Кодагрегации="";
		ФлагВозврата=Ложь;
	//ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") тогда
	ИначеЕсли ТипЗнч(ДокументОснованиеСсылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") тогда
		Если Выборка.Количество()=0 тогда
			Сообщить(" Код упаковки "+КодАгрегации+" в реестре КМ не найден!") ;
			ФлагВозврата=Ложь;	
		иначе
			КоличКМ=0; 
			ФлАгрКод=0;
			Пока Выборка.Следующий() Цикл 
				Если Лев(Выборка.КодМаркировки,2)="01" тогда
					КоличКМ=КоличКМ+1;
				ИначеЕсли СокрЛП(Выборка.КодSSCC1)=СокрЛП(Выборка.КодМаркировки) тогда  // агрегатный код
					ФлАгрКод=1;
					Если Выборка.Статус>2 тогда
						Сообщить(" Агрегатный код упаковки "+КодАгрегации+"уже реализован "+Выборка.ДокументРасхода) ; 
						КодАгрегации="";
						ФлагВозврата=Ложь;
					Иначе
						Емкость=Выборка.ЕмкостьУпаковки;
						Введено=КоличКМ;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если ФлАгрКод=0 тогда 
				Сообщить(" Агрегатный код упаковки "+КодАгрегации+" в реестре КМ не найден!") ; 
				КодАгрегации=""; 
				ФлагВозврата=Ложь;
			КонецЕсли;	
		КонецЕсли		
	КонецЕсли;
    Возврат ФлагВозврата;
КонецФункции

&НаКлиенте
Процедура КодАгрегацииПриИзменении(Элемент)
	
	Если СтрДлина(КодАгрегации)>18 тогда
			КодАгрегации=Прав(СокрЛП(КодАгрегации),18); // возможно два лишних символа впереди
	КонецЕсли;
	
	Если СтрДлина(КодАгрегации)<>18  тогда
		Сообщить(" Ошибка в коде упаковки "+КодАгрегации) ;   
	    Кодагрегации="";
		Возврат;
	КонецЕсли;

	Если ПроверитьНаличиеКодSSCC1ВРеестре(КодАгрегации,Объект.ДокументОснование) тогда
		Сообщить(" Код упаковки "+КодАгрегации+" в реестре КМ уже есть!") ;   
	    Кодагрегации="";
	КонецЕсли;
	
КонецПроцедуры

