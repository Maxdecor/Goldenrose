&НаКлиенте
Процедура КорректировкаСпискаКМ()
	
	Для каждого СтрокаТЧ Из НесуществующиеКоды Цикл
		КорректировкаСтрокиСписка(СтрокаТЧ);
	КонецЦикла;

	Для каждого СтрокаТЧ Из СтатусыСОшибками Цикл
		КорректировкаСтрокиСписка(СтрокаТЧ);
	КонецЦикла;

	Для каждого СтрокаТЧ Из KoдыРазныхGTIN Цикл
		КорректировкаСтрокиСписка(СтрокаТЧ);
	КонецЦикла;

	Для каждого СтрокаТЧ Из КодыРазныхЕмкостей Цикл
		КорректировкаСтрокиСписка(СтрокаТЧ);
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура КорректировкаСтрокиСписка(СтрокаТЧ) 
	
	Код=СтрокаТЧ.КодМаркировки;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Товар", Код);
	
	НайденныеСтроки = Объект.КодыСписок.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()>0 тогда
		ТабСтрока=НайденныеСтроки[0];
		Если ТабСтрока.Проверка тогда  // корретировка КМ в документе
			ПересчетКоличестваКМДокументаОснования(ТабСтрока);
		КонецЕсли;
		ТабСтрока.Проверка=Ложь;  
		ТабСтрока.ПроверенНаСайте=2;     // проверен - ошибки

		// корретировка строки в списке КМ
		Если СтрокаТЧ.Свойство("GTINСайт")  тогда              
			Если ТабСтрока.GTIN<>СтрокаТЧ.GTINСайт тогда
				ТабСтрока.GTIN=СтрокаТЧ.GTINСайт;
				ТабСтрока.Номенклатура=ПолучитьНоменклатурунаСервере(ТабСтрока.GTIN);
			Конецесли;
		КонецЕсли;
		Если СтрокаТЧ.Свойство("ЕмкостьУпаковкиСайт")  тогда
			Если ТабСтрока.ЕмкостьУпаковки<>0 Тогда
				КоличествоЕдиницТовара=ТабСтрока.Количество/ТабСтрока.ЕмкостьУпаковки;
				ТабСтрока.ЕмкостьУпаковки=СтрокаТЧ.ЕмкостьУпаковкиСайт;
				ТабСтрока.Количество=СтрокаТЧ.ЕмкостьУпаковкиСайт*КоличествоЕдиницТовара;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

 

&НаКлиенте
Процедура ЗаписатьРаспакованныеКоды(ТаблицаКодов,ИмяТаблицы);  
	АгрегационныеКоды = Новый Массив;
	АгрегационныеКодыВсе = Новый Массив;
	
	Для каждого СтрокаМассива Из ТаблицаКодов Цикл
		Если СтрокаМассива.Агрегации <> Неопределено Тогда 
			АгрегационныеКоды.Очистить();

			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(АгрегационныеКоды, СтрокаМассива.Агрегации); 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(АгрегационныеКодыВсе, СтрокаМассива.Агрегации);
			
			Для Инд=0 по АгрегационныеКоды.Количество()-1 Цикл

				Если Инд=0 тогда                         // первая строка
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("Товар", СтрокаМассива.Код);
					//НайденныеСтроки = Объект.КодыСписок.НайтиСтроки(ПараметрыОтбора);
					НайденныеСтроки = Объект[ИмяТаблицы].НайтиСтроки(ПараметрыОтбора);
					Если НайденныеСтроки.Количество()>0 тогда
						ТабСтрока=НайденныеСтроки[0]; 
						GTIN=ТабСтрока.GTIN;
						НомерСерии=ТабСтрока.НомерСерии;
						Номенклатура=ТабСтрока.Номенклатура;
						КоличествоЕдиницТовара=ТабСтрока.Количество/АгрегационныеКоды.Количество();
						Статус=ТабСтрока.Статус;
					иначе
						ТабСтрока=Объект[ИмяТаблицы].Добавить(); 
						Если ИмяТаблицы="КодыРаспаковки" тогда
							GTIN=СтрокаМассива.GTIN;
							Номенклатура=СтрокаМассива.НаименованиеТовара;
							Статус=СтрокаМассива.СтатусКода; 
						КонецЕсли;	
					КонецЕсли;
				иначе
					ТабСтрока=Объект[ИмяТаблицы].Добавить();
                КонецЕсли;

				ТабСтрока.КодSSCC1=СтрокаМассива.Код; 
				ТабСтрока.Товар=АгрегационныеКоды[Инд];
				ТабСтрока.GTIN=GTIN;
				ТабСтрока.Номенклатура=Номенклатура;
				ТабСтрока.НомерСерии=НомерСерии; 
				ТабСтрока.Количество=КоличествоЕдиницТовара;
				ТабСтрока.Статус=Статус;
				
				ТабСтрока.Проверка=Истина; 
				ТабСтрока.ПроверенНаСайте=1; 
				
			КонецЦикла;
		Иначе
			Если ИмяТаблицы="КодыРаспаковки" тогда
				ТабСтрока=Объект[ИмяТаблицы].Добавить(); 
				ТабСтрока.Товар=СтрокаМассива.Код;
				ТабСтрока.GTIN=СтрокаМассива.GTIN;
				ТабСтрока.Номенклатура=СтрокаМассива.НаименованиеТовара;
				ТабСтрока.Статус=СтрокаМассива.СтатусКода;
				ТабСтрока.ЕмкостьУпаковки=СтрокаМассива.ЕмкостьУпаковки;
				ТабСтрока.ТипУпаковки=СтрокаМассива.ТипУпаковки;
				ТабСтрока.Проверка=Ложь;         // агрегаций нет
			КонецЕсли;
			Сообщить("Для упаковки с кодом  "+СтрокаМассива.Код+"  вложенные коды не найдены! ");
		КонецЕсли;
	КонецЦикла; 
	
	Объект[ИмяТаблицы].Сортировать("КодSSCC1");
	Если АгрегационныеКодыВсе.Количество()>0 тогда
		СинхронизоватьКодыМаркировкиССайтом(АгрегационныеКодыВсе, Ложь); // еже раз для получения след. уровня
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПараметрыРаспакованныхКодов(ТаблицаКодов,ИмяТаблицы);  
	Для каждого СтрокаМассива Из ТаблицаКодов Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Товар", СтрокаМассива.Код);
		//НайденныеСтроки = Объект.КодыСписок.НайтиСтроки(ПараметрыОтбора);
		НайденныеСтроки = Объект[ИмяТаблицы].НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество()>0 тогда
			ТабСтрока=НайденныеСтроки[0];
			ТабСтрока.ТипУпаковки=СтрокаМассива.ТипУпаковки;		
			ТабСтрока.УровеньУпаковки=СтрокаМассива.УровеньУпаковки;
			ТабСтрока.ЕмкостьУпаковки=СтрокаМассива.ЕмкостьУпаковки;
		КонецЕсли;
	КонецЦикла; 
	КонецПроцедуры

