				ПотребительскиеКодыМаркировки.Добавить(Новый Структура("Код, GTIN,Пометка,УровеньУпаковки, ТипУпаковки,ЕмкостьУпаковки, ТипТовара", 
					ТабСтр.Товар,ТабСтр.GTIN,ТабСтр.Проверка,ТабСтр.УровеньУпаковки,ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ПотребительскаяУпаковка"),ТабСтр.Количество, ТипТовара));

			ИначеЕсли ТабСтр.ТипУпаковки=ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ГрупповаяУпаковка") тогда  
				ГрупповыеКодыМаркировки.Добавить(Новый Структура("Код, GTIN,Пометка,УровеньУпаковки, ТипУпаковки,ЕмкостьУпаковки, ТипТовара", 
					ТабСтр.Товар,ТабСтр.GTIN,ТабСтр.Проверка,ТабСтр.УровеньУпаковки,ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ПотребительскаяУпаковка"),ТабСтр.Количество, ТипТовара));

			ИначеЕсли ТабСтр.ТипУпаковки=ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ТранспортнаяУпаковка") тогда
				ТранспортныеКодыМаркировки.Добавить(Новый Структура("Код,GTIN, Пометка,УровеньУпаковки, ТипУпаковки,ЕмкостьУпаковки, ТипТовара", 
