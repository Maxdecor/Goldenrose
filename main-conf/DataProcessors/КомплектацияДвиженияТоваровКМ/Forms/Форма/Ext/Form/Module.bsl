&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
	Если  Объект.ДокументОснование=Неопределено тогда
		// проверим работают ли с документами пользователи 
		ПроверитьРаботуСДокументами(Отказ);
		
		
		Если Отказ тогда
			Сообщить("Работа в режиме 'без привязки к документам' заблокирована. Попробуйте позже!");
		иначе
			Если НЕ ЗаблокироватьОбработку() Тогда
				Сообщить("С обработкой уже работают в режиме 'без привязки к документам'. Попробуйте позже!");
				Отказ=истина;
			КонецЕсли;
		КонецЕсли;

	Иначе
		
		РеквизитыСоответствие=ЗаполнитьРеквизиты(Объект.ДокументОснование);
		
		Организация=РеквизитыСоответствие.Получить("Организация");
		ТекстДекорации=РеквизитыСоответствие.Получить("ТекстДекорации");

		
		Элементы.Организация.Доступность=Ложь;
		
		Элементы.ДекорацияИнформация.Заголовок=ТекстДекорации;
		
		
		Элементы.ГруппаАгрегацииРазагрегации.Видимость=Ложь;
		
		Элементы.ДекорацияПредупреждение.Видимость=Ложь;
		
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") тогда

			Элементы.КонтрольСертификация.Видимость=Ложь; 
			Элементы.ТоварыСписок.КоманднаяПанель.ПодчиненныеЭлементы.ТоварыСписокЗагрузкаИзCSV.Видимость=Ложь;
			
		КонецЕсли;
		
		Элементы.КодыРаспаковки.Видимость=Ложь;
	КонецЕсли; 
	

	// заполним списокивыбора упаковки
	УпаковкаКоличествоЗаполнитьСписокВыбора();
	
	//Упаковка=1;
	СтрКонтроль=Объект.Контроль.Получить(0);
	ТипТовара=СтрКонтроль.ТипТовара;
	
	ОшибкаВвода=Ложь; 
	wsh=Новый COMОбъект("WScript.Shell"); 
	
	ВыполнитьЗакрытиеФормы=Ложь;
КонецПроцедуры

