	//Для Каждого СтрокаМаркировки Из ТранспортныхСписокКодовМаркировки Цикл
	//	ТранспортныеКодыМаркировки.Добавить(Новый Структура("Код, Пометка, ТипУпаковки, ТипТовара", 
	//		СтрокаМаркировки.Значение, СтрокаМаркировки.Пометка, ПредопределенноеЗначение("Перечисление.ВариантыИспользованияЕдиницыХраненияИСМП.ТранспортнаяУпаковка"), ТипТовара));
