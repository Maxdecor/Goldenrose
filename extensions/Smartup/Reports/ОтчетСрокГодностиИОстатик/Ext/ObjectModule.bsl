Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДокументРезультат.Очистить();
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("НаборДанных1", ОстаткиТоваровССрокомГодностиИзSmartup(ТекущаяДата()));
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	
	ПроцессорВывода.НачатьВывод();
	ЭлементРезультата = ПроцессорКомпоновки.Следующий();
	Пока ЭлементРезультата <> Неопределено Цикл
		ПроцессорВывода.ВывестиЭлемент(ЭлементРезультата);
		ЭлементРезультата = ПроцессорКомпоновки.Следующий();
	КонецЦикла;
	ПроцессорВывода.ЗакончитьВывод();	
КонецПроцедуры


// ============================================================================
// ОСТАТКИ ТОВАРОВ СО СРОКОМ ГОДНОСТИ ИЗ SMARTUP (balance$export)
// ============================================================================
// Используется как источник данных для СКД (вызывается в обработчике
// "При компоновке результата" отчёта).
//
// В отличие от исходного варианта — НЕ схлопывает данные только по
// product_code (это стирало бы партии/сроки годности), а группирует по
// ПОЛНОМУ ключу партии (товар + склад + партия + срок годности + серия),
// суммируя количество отдельно по трём условиям остатка:
//   quantity_b - забронировано (condition "B")
//   quantity_f - свободно      (condition "F")
//   quantity_t - в пути/транзит (condition "T")
//
// API отдаёт остаток только для ОДНОГО condition за раз, поэтому делаем
// 3 запроса (по одному на B/F/T) и объединяем результат по ключу партии.
// ============================================================================

// Возвращает ТаблицаЗначений с остатками товаров на дату ДатаОстатка
// (по умолчанию - сегодня), одна строка = одна партия на складе.
//
// КОЛОНКИ ТАБЛИЦЫ (для построения СКД):
//   product_code           - Строка(20)  - код товара
//   product_id             - Строка(20)  - ID товара в Smartup
//   warehouse_code         - Строка(20)  - код склада
//   warehouse_id           - Строка(20)  - ID склада в Smartup
//   batch_number           - Строка(30)  - номер партии
//   serial_number          - Строка(30)  - серийный номер
//   card_code              - Строка(20)  - код карточки товара
//   inventory_kind         - Строка(2)   - вид запаса (G/M/P)
//   producer_code          - Строка(20)  - код поставщика/производителя
//   currency_code          - Строка(10)  - код валюты
//   measure_code           - Строка(10)  - код единицы измерения
//   expiry_date            - Дата        - срок годности (сконвертирован из "дд.мм.гггг")
//   ДнейДоИстечения        - Число(10,0) - сколько дней осталось (отрицательное = просрочено)
//   quantity_b             - Число(15,3) - количество "забронировано"
//   quantity_f             - Число(15,3) - количество "свободно"
//   quantity_t             - Число(15,3) - количество "в пути"
//   input_price            - Число(15,2) - цена прихода
//   base_price             - Число(15,2) - базовая цена
&НаСервере
Функция ОстаткиТоваровССрокомГодностиИзSmartup(ДатаОстатка = Неопределено) Экспорт
	
	Если ДатаОстатка = Неопределено Тогда
		ДатаОстатка = ТекущаяДата();
	КонецЕсли;
	
	Таблица = ПолучитьПустуюТаблицуОстатковSmartup();
	
	УсловияОтбора = Новый Массив;
	//УсловияОтбора.Добавить("B");
	УсловияОтбора.Добавить("F");
	//УсловияОтбора.Добавить("T");
	
	Для Каждого Условие Из УсловияОтбора Цикл
		
		СтруктураДанные = Новый Структура;
		//МассивСклад = Новый Массив;
		//МассивСклад.Добавить(Новый Структура("warehouse_code", "MAIN"));
		//СтруктураДанные.Вставить("warehouse_codes", МассивСклад);
		СтруктураДанные.Вставить("filial_code", Константы.ОрганизацияКодSmartup.Получить());
		
		МассивУсловий = Новый Массив;
		МассивУсловий.Добавить(Условие);
		СтруктураДанные.Вставить("product_conditions", МассивУсловий);
		
		СтруктураДанные.Вставить("begin_date", Формат(ДатаОстатка, "ДФ=dd.MM.yyyy"));
		СтруктураДанные.Вставить("end_date",   Формат(ДатаОстатка, "ДФ=dd.MM.yyyy"));
		
		JSON = uzbled_EImzoСлужебный.ЗаписатьВСтрокуJSON(СтруктураДанные);
		
		Попытка 
			Данные = smartUp.ОтправитьЗапросВSmartup("/b/anor/mxsx/mkw/balance$export", JSON);
		Исключение
			Продолжить;
		КонецПопытки;
		
		//Если Ответ = Неопределено ИЛИ Ответ.КодСостояния <> 200 Тогда
		//	Продолжить;
		//КонецЕсли;
		//
		//Данные = uzbled_EImzoСлужебный.ПрочитатьСтрокуJSON(Ответ.ПолучитьТелоКакСтроку());
		
		Если НЕ Данные.Свойство("balance") Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Стр Из Данные.balance Цикл
			
			НС = Таблица.Добавить();
			НС.product_code   = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",Стр.product_code).Наименование;
			НС.product_id     = Стр.product_id;
			НС.warehouse_code = Стр.warehouse_code;
			НС.warehouse_id   = Стр.warehouse_id;
			НС.batch_number   = Стр.batch_number;
			НС.serial_number  = Стр.serial_number;
			НС.card_code      = Стр.card_code;
			НС.inventory_kind = Стр.inventory_kind;
			Если Стр.Свойство("producer_code") Тогда 
				НС.producer_code  = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",Стр.product_code).Наименование;
			КонецЕсли;
			Если Стр.Свойство("currency_code") Тогда 
				НС.currency_code  = Стр.currency_code;
			КонецЕсли;
			Если Стр.Свойство("measure_code") Тогда 
				НС.measure_code  = Стр.measure_code;
			КонецЕсли;
			
			НС.expiry_date = ПреобразоватьДатуSmartup(Стр.expiry_date);
			
			Если ЗначениеЗаполнено(НС.expiry_date) Тогда
				НС.ДнейДоИстечения = Цел((НС.expiry_date - ТекущаяДата()) / 86400);
			КонецЕсли;			
			Если Условие = "B" Тогда
				НС.quantity_b = ?(ЗначениеЗаполнено(Стр.quantity), Число(Стр.quantity), 0);
			ИначеЕсли Условие = "F" Тогда
				НС.quantity_f = ?(ЗначениеЗаполнено(Стр.quantity), Число(Стр.quantity), 0);
			ИначеЕсли Условие = "T" Тогда
				НС.quantity_t = ?(ЗначениеЗаполнено(Стр.quantity), Число(Стр.quantity), 0);
			КонецЕсли;
			
			НС.input_price = ?(ЗначениеЗаполнено(Стр.input_price), Число(Стр.input_price), 0);
			Если Стр.Свойство("base_price") Тогда 
				НС.base_price  = ?(ЗначениеЗаполнено(Стр.base_price),  Число(Стр.base_price),  0);
			КонецЕсли;
			
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если Таблица.Количество() > 0 Тогда
		
		Таблица.Свернуть(
		"product_code, product_id, warehouse_code, warehouse_id, batch_number,
		|serial_number, card_code, inventory_kind, producer_code, currency_code,
		|measure_code, expiry_date, ДнейДоИстечения, input_price, base_price",
		"quantity_b, quantity_f, quantity_t");
		
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

// Формирует пустую таблицу значений с типизированными колонками
&НаСервере
Функция ПолучитьПустуюТаблицуОстатковSmartup()
	
	Таблица = Новый ТаблицаЗначений;
	
	КС20 = Новый КвалификаторыСтроки(20);
	КС30 = Новый КвалификаторыСтроки(30);
	КС10 = Новый КвалификаторыСтроки(10);
	КС2  = Новый КвалификаторыСтроки(2);
	
	МассивСтрока = Новый Массив;
	МассивСтрока.Добавить(Тип("Строка"));
	
	МассивДата = Новый Массив;
	МассивДата.Добавить(Тип("Дата"));
	
	МассивЧисло = Новый Массив;
	МассивЧисло.Добавить(Тип("Число"));
	
	ОТ_Строка20 = Новый ОписаниеТипов(МассивСтрока, , КС20);
	ОТ_Строка30 = Новый ОписаниеТипов(МассивСтрока, , КС30);
	ОТ_Строка10 = Новый ОписаниеТипов(МассивСтрока, , КС10);
	ОТ_Строка2  = Новый ОписаниеТипов(МассивСтрока, , КС2);
	ОТ_Дата     = Новый ОписаниеТипов(МассивДата, Новый КвалификаторыДаты(ЧастиДаты.Дата));
	ОТ_ЧислоКол = Новый ОписаниеТипов(МассивЧисло, , , Новый КвалификаторыЧисла(15, 3));
	ОТ_ЧислоЦен = Новый ОписаниеТипов(МассивЧисло, , , Новый КвалификаторыЧисла(15, 2));
	ОТ_ЧислоДни = Новый ОписаниеТипов(МассивЧисло, , , Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой));
	
	Таблица.Колонки.Добавить("product_code",     ОТ_Строка20);
	Таблица.Колонки.Добавить("product_id",       ОТ_Строка20);
	Таблица.Колонки.Добавить("warehouse_code",   ОТ_Строка20);
	Таблица.Колонки.Добавить("warehouse_id",     ОТ_Строка20);
	Таблица.Колонки.Добавить("batch_number",     ОТ_Строка30);
	Таблица.Колонки.Добавить("serial_number",    ОТ_Строка30);
	Таблица.Колонки.Добавить("card_code",        ОТ_Строка20);
	Таблица.Колонки.Добавить("inventory_kind",   ОТ_Строка2);
	Таблица.Колонки.Добавить("producer_code",    ОТ_Строка20);
	Таблица.Колонки.Добавить("currency_code",    ОТ_Строка10);
	Таблица.Колонки.Добавить("measure_code",     ОТ_Строка10);
	Таблица.Колонки.Добавить("expiry_date",      ОТ_Дата);
	Таблица.Колонки.Добавить("ДнейДоИстечения",  ОТ_ЧислоДни);
	Таблица.Колонки.Добавить("quantity_b",       ОТ_ЧислоКол);
	Таблица.Колонки.Добавить("quantity_f",       ОТ_ЧислоКол);
	Таблица.Колонки.Добавить("quantity_t",       ОТ_ЧислоКол);
	Таблица.Колонки.Добавить("input_price",      ОТ_ЧислоЦен);
	Таблица.Колонки.Добавить("base_price",       ОТ_ЧислоЦен);
	
	Возврат Таблица;
	
КонецФункции

// Конвертирует строку даты Smartup "дд.мм.гггг" в Дату 1С (только дата, без времени)
&НаСервере
Функция ПреобразоватьДатуSmartup(СтрДата)
	
	Если НЕ ЗначениеЗаполнено(СтрДата) Тогда
		Возврат Дата(1,1,1);
	КонецЕсли;
	
	Попытка
		ЧастиДень = СтрРазделить(СтрДата, ".");
		Возврат Дата(ЧастиДень[2], ЧастиДень[1], ЧастиДень[0]);
	Исключение
		Возврат Дата(1,1,1);
	КонецПопытки;
	
КонецФункции

