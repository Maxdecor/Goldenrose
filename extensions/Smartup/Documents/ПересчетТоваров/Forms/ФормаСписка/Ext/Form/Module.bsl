
// ── 1. Команда "Загрузить инвентаризацию из Smartup" (форма с ПериодSmartUp) ──

&НаКлиенте
Процедура Расш1_ЗагрузкаИзSmartUpПосле(Команда)
	
	ДлительнаяОперация = ЗапуститьЗагрузкуИнвентаризацииНаСервере(
		ПериодSmartUp.ДатаНачала, ПериодSmartUp.ДатаОкончания);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"Расш1_ЗагрузкаИзSmartUpПослеЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьЗагрузкуИнвентаризацииНаСервере(ДатаНачала, ДатаОкончания)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Загрузка инвентаризации из Smartup'");
	
	ПараметрыФ = Новый Структура;
	ПараметрыФ.Вставить("ДатаНачала",    ДатаНачала);
	ПараметрыФ.Вставить("ДатаОкончания", ДатаОкончания);
	
	РезультатВыполнения = ДлительныеОперации.ВыполнитьВФоне(
		"SmartUp.ЗагрузкаИнвентаризацииВФоне",
		ПараметрыФ, ПараметрыВыполнения);
	
	Возврат РезультатВыполнения;
	
КонецФункции

&НаКлиенте
Процедура Расш1_ЗагрузкаИзSmartUpПослеЗавершение(РезультатДлительнойОперации, ДополнительныеПараметры) Экспорт
	
	Если РезультатДлительнойОперации = Неопределено Тогда
		// Пользователь отменил операцию
		Возврат;
	КонецЕсли;
	
	Если РезультатДлительнойОперации.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			"Ошибка при загрузке инвентаризации: " + РезультатДлительнойОперации.ПодробноеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	Итоги = ПолучитьИзВременногоХранилища(РезультатДлительнойОперации.АдресРезультата);
	
	Текст = СтрШаблон(
		"Загрузка инвентаризации завершена.
		|
		|Инвентаризаций обработано: %1
		|  • создано новых документов: %2
		|  • обновлено существующих: %3
		|
		|Строк товаров всего: %4
		|  • найдено по Артикулу: %5
		|  • найдено по Описанию (Smartup-код): %6
		|  • НЕ найдено (пропущено): %7
		|
		|Ошибок: %8",
		Итоги.ВсегоИнвентаризаций,
		Итоги.ДокументовСоздано,
		Итоги.ДокументовОбновлено,
		Итоги.ВсегоСтрок,
		Итоги.СтрокНайденоПоАртикулу,
		Итоги.СтрокНайденоПоОписанию,
		Итоги.СтрокНеНайдено,
		Итоги.ОшибокДокументов);
	
	Если Итоги.СтрокНеНайдено > 0 Тогда
		Текст = Текст + "
		|
		|⚠ Есть ненайденные товары — проверьте комментарии документов
		|(отмечены как 'ТРЕБУЕТ ПРОВЕРКИ') и выполните синхронизацию номенклатуры.";
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(Текст, , "Загрузка инвентаризации из Smartup");
	
КонецПроцедуры




