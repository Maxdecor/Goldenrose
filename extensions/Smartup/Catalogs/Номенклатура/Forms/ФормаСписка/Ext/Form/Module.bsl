// ── 2. Команда "Синхронизировать номенклатуру со Smartup" (форма списка Номенклатура) ──

&НаКлиенте
Процедура Расш1_СинхронизацияНоменклатурыПосле(Команда)
	
	ДлительнаяОперация = ЗапуститьСинхронизациюНоменклатурыНаСервере();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"Расш1_СинхронизацияНоменклатурыПослеЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьСинхронизациюНоменклатурыНаСервере()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Синхронизация номенклатуры со Smartup'");
	
	ПараметрыФ = Новый Структура;
	
	РезультатВыполнения = ДлительныеОперации.ВыполнитьВФоне(
		"SmartUp.СинхронизацияНоменклатурыВФоне",
		ПараметрыФ, ПараметрыВыполнения);
	
	Возврат РезультатВыполнения;
	
КонецФункции

&НаКлиенте
Процедура Расш1_СинхронизацияНоменклатурыПослеЗавершение(РезультатДлительнойОперации, ДополнительныеПараметры) Экспорт
	
	Если РезультатДлительнойОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатДлительнойОперации.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			"Ошибка при синхронизации номенклатуры: " + РезультатДлительнойОперации.ОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	Итоги = ПолучитьИзВременногоХранилища(РезультатДлительнойОперации.АдресРезультата);
	
	Текст = СтрШаблон(
		"Синхронизация номенклатуры завершена.
		|
		|Товаров получено из Smartup: %1
		|  • создано новых элементов: %2
		|  • уже было (по Артикулу): %3
		|  • сопоставлено по Наименованию (требует сверки Артикула): %4
		|
		|Ошибок: %5",
		Итоги.Всего,
		Итоги.Создано,
		Итоги.НайденоПоАртикулу,
		Итоги.НайденоПоНаименованию,
		Итоги.ОшибокКоличество);
	
	Если Итоги.НайденоПоНаименованию > 0 Тогда
		Текст = Текст + "
		|
		|⚠ Есть товары с расхождением Артикула — см. поле 'Описание'
		|соответствующих элементов номенклатуры ('Smartup: <код>').";
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(Текст, , "Синхронизация номенклатуры Smartup");
	
	Если ЭтотОбъект.Элементы.Найти("Список") <> Неопределено Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
	
КонецПроцедуры
