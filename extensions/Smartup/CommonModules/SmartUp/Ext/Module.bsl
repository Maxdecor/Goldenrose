// Поиск уже загруженного заказа по external_id (deal_id из Smartup)
&НаСервере
Функция НайтиЗаказКлиента(deal_id)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказКлиента.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Номер = &deal_id";
	Запрос.УстановитьПараметр("deal_id", Строка(deal_id));
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Документы.ЗаказКлиента.ПустаяСсылка();
	КонецЕсли;
	Возврат Результат.Выгрузить()[0].Ссылка;
КонецФункции

// Поиск номенклатуры по коду из Smartup
&НаСервере
Функция НайтиНоменклатуру(Товар)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", Товар.product_name);
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда

		НовыйТовар = Справочники.Номенклатура.СоздатьЭлемент();
		НовыйТовар.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товар");
		НовыйТовар.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
		НовыйТовар.Наименование    = Товар.product_name; 
		НовыйТовар.НаименованиеПолное = Товар.product_name; 
		НовыйТовар.Артикул         = Товар.product_code;     
		НовыйТовар.ВариантОформленияПродажи  = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
		НовыйТовар.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
		Попытка
		НовыйТовар.SmartUpID       = Товар.product_id; 
		Исключение
		КонецПопытки;
		НовыйТовар.ЕдиницаИзмерения= Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("Шт");
		
			
		Возврат НовыйТовар.Ссылка;
	КонецЕсли;
	
	Возврат Результат.Выгрузить()[0].Ссылка;
КонецФункции

