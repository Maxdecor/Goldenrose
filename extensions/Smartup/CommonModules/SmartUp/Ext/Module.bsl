                                                                                                
Процедура SmartUp(ПериодСинх) Экспорт
	ЗагрузитьЗаказыИзSmartupНаСервере(ПериодСинх);	
КонецПроцедуры
&НаСервере
Процедура СписокЗаказовНаСервере()  
	
	Логин  = Константы.Логин.Получить();
	Пароль = Константы.Пароль.Получить();
	
	СтруктураДанныхJSON = Новый Структура;
	СтруктураДанныхJSON.Вставить("external_id", "");
	СтруктураДанныхJSON.Вставить("deal_id", "");
	СтруктураДанныхJSON.Вставить("begin_deal_date","");
	СтруктураДанныхJSON.Вставить("end_deal_date", "");
	СтруктураДанныхJSON.Вставить("delivery_date","");
	СтруктураДанныхJSON.Вставить("begin_created_on", "");
	СтруктураДанныхJSON.Вставить("end_created_on", "");
	СтруктураДанныхJSON.Вставить("begin_modified_on", "");
	СтруктураДанныхJSON.Вставить("end_modified_on", "");
	
	СтрокаJSON = uzbled_EImzoСлужебный.ЗаписатьВСтрокуJSON(СтруктураДанныхJSON);	
	SSL = Новый ЗащищенноеСоединениеOpenSSL();	
	HTTP =  Новый HTTPСоединение("smartup.online",,Логин,Пароль,,,SSL);
	запросPOST = Новый HTTPЗапрос("POST");
	запросPOST.АдресРесурса = "/b/trade/txs/tdeal/order$export";
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	запросPOST.Заголовки = Заголовки;
	запросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	HTTPОтвет    = HTTP.ОтправитьДляОбработки(запросPOST);
	ОтветСервера = HTTPОтвет.ПолучитьТелоКакСтроку();
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ОтветСервера);
	Результат = ЗаполнитьСтруктуруИзОтветаJSON(Чтение);	
	Чтение.Закрыть();
	
	Для Каждого Строка Из Результат Цикл
		Для Каждого Стр Из Строка.Значение Цикл 
			
			Если ТипЗнч(Строка.Значение) = Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			
			НайденныйДокумент =  НайтиЗаказ(Стр.deal_id);
			Если НайденныйДокумент = Документы.РеализацияТоваровУслуг.ПустаяСсылка() Тогда
				НовДок = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
			ИНаче
				НовДок = НайденныйДокумент.ПолучитьОбъект();
				НовДок.Товары.Очистить();
			Конецесли;	
			
			
			Для Каждого СтрТовар из стр.order_products Цикл
				НовСтрокаТалицы = НовДок.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрокаТалицы,стрТовар);
				НовСтрокаТалицы.deal_id = Стр.deal_id;					
			КонецЦикла;
			
		КонецЦикла;	
	КонецЦикла;
КонецПроцедуры	
&НаСервере
Функция НайтиЗаказ(IdЗаказа)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиента.Номер КАК IDЗаказа,
	|	ЗаказКлиента.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Номер = &IDЗаказа";
	
	Запрос.УстановитьПараметр("IDЗаказа", IDЗаказа);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	Возврат Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	
КонецФункции


