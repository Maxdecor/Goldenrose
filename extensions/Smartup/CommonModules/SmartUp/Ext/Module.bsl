// Конвертация строки даты "dd.mm.yyyy hh24:mi:ss" → Дата 1С
&НаСервере
Функция КонвертироватьДатуСмартап(СтрДата)
	Если НЕ ЗначениеЗаполнено(СтрДата) Тогда
		Возврат '00010101';
	КонецЕсли;
	// Формат: "dd.mm.yyyy hh:mm:ss"
	Попытка
		ЧастиДата  = СтрРазделить(СтрДата, " ");
		ЧастиДень  = СтрРазделить(ЧастиДата[0], ".");
		Д  = ЧастиДень[0];
		М  = ЧастиДень[1];
		Г  = ЧастиДень[2];
		Если КоличествоЧастей(ЧастиДата) > 1 Тогда
			ЧастиВремя = СтрРазделить(ЧастиДата[1], ":");
			Ч  = ЧастиВремя[0];
			Мн = ЧастиВремя[1];
			С  = ?(КоличествоЧастей(ЧастиВремя) > 2, ЧастиВремя[2], "00");
		Иначе
			Ч = "00"; Мн = "00"; С = "00";
		КонецЕсли;
		Возврат Дата(Г, М, Д, Ч, Мн, С);
	Исключение
		Возврат '00010101';
	КонецПопытки;
КонецФункции

&НаСервере
Функция КоличествоЧастей(Массив)
	Возврат Массив.Количество();
КонецФункции

// Маппинг статуса Smartup → статус УТ
&НаСервере
Функция ПолучитьСтатусЗаказа(СтатусСмартап)
	// В УТ статус "ЗаказКлиента" — перечисление СтатусыЗаказовКлиентов
	// Маппинг: B#N, B#E → К выполнению; B#W, B#S → Выполнен; D → Согласование; C → Отменён
	Если СтатусСмартап = "D" Тогда
		Возврат Перечисления.СтатусыЗаказовКлиентов.НаОформлении;
	ИначеЕсли СтатусСмартап = "B#N" ИЛИ СтатусСмартап = "B#E" Тогда
		Возврат Перечисления.СтатусыЗаказовКлиентов.КВыполнению;
	ИначеЕсли СтатусСмартап = "B#W" ИЛИ СтатусСмартап = "B#S" ИЛИ СтатусСмартап = "B#V" Тогда
		Возврат Перечисления.СтатусыЗаказовКлиентов.Выполнен;
	ИначеЕсли СтатусСмартап = "C" Тогда
		Возврат Перечисления.СтатусыЗаказовКлиентов.Закрыт;
	Иначе
		Возврат Перечисления.СтатусыЗаказовКлиентов.НаОформлении;
	КонецЕсли;
КонецФункции

Функция ИзменитьСтатусЗаказ(Статус = "A",НомерЗаказ) Экспорт 
	//    {
	//  "order": [
	//      {
	//      "deal_id": "111",
	//      "status": "B#E"
	//      }
	//  ]
	//}  
	ЗаказСмартап = РегистрыСведений.ДанныеИзSmartUp.ПолучитьПоследнее(,Новый Структура("КодЗаказа",НомерЗаказ)); 
	Если ЗаказСмартап.JSON <> "" Тогда 
		СтруктураДанные = Новый Структура;
		СтруктураДанные.Вставить("status",Статус);
		СтруктураДанные.Вставить("deal_id",НомерЗаказ); 
		МассивОрдер = Новый Массив;
		МассивОрдер.Добавить(СтруктураДанные); 
		Ответ = ОтправитьЗапросВSmartup("/b/trade/txs/tdeal/order$change_status",uzbled_EImzoСлужебный.ЗаписатьВСтрокуJSON(Новый Структура("order",МассивОрдер)));
		
		Если Ответ.Свойство("successes") Тогда 
			Возврат Ответ.successes.Количество()>0; 
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ЗагрузитьЗаказыИзSmartupНаСервере(ПериодСинх)
	
	// 1. Получаем учётные данные
	Логин  = Константы.Логин.Получить();
	Пароль = Константы.Пароль.Получить();
	
	// 2. Формируем тело запроса (фильтр — можно настроить даты)
	СтруктураДанныхJSON = Новый Структура;
	СтруктураДанныхJSON.Вставить("external_id",       "");
	СтруктураДанныхJSON.Вставить("deal_id",           "");
	СтруктураДанныхJSON.Вставить("begin_deal_date",   "");
	СтруктураДанныхJSON.Вставить("end_deal_date",     "");
	СтруктураДанныхJSON.Вставить("delivery_date",     "");
	СтруктураДанныхJSON.Вставить("begin_created_on",  Формат(ПериодСинх.ДатаНачала,"ДФ=dd.MM.yyyy"));
	СтруктураДанныхJSON.Вставить("end_created_on",    Формат(ПериодСинх.ДатаОкончания,"ДФ=dd.MM.yyyy"));
	СтруктураДанныхJSON.Вставить("begin_modified_on", "");
	СтруктураДанныхJSON.Вставить("end_modified_on",   "");
	
	СтрокаJSON = uzbled_EImzoСлужебный.ЗаписатьВСтрокуJSON(СтруктураДанныхJSON);
	
	// 3. HTTP-запрос к Smartup
	SSL       = Новый ЗащищенноеСоединениеOpenSSL();
	HTTP      = Новый HTTPСоединение("smartup.online",, Логин, Пароль,,, SSL);
	ЗапросPOST = Новый HTTPЗапрос("/b/trade/txs/tdeal/order$export");
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	ЗапросPOST.Заголовки = Заголовки;
	ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	
	HTTPОтвет    = HTTP.ОтправитьДляОбработки(ЗапросPOST);
	ОтветСервера = HTTPОтвет.ПолучитьТелоКакСтроку();
	
	// 4. Разбор JSON-ответа
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ОтветСервера);
	МассивЗаказов = ЗаполнитьСтруктуруИзОтветаJSON(Чтение);
	Чтение.Закрыть();
	
		
	Для Каждого ДанныеЗаказа Из МассивЗаказов.order Цикл
		
		Попытка 
			Если ДанныеЗаказа.status <> "B#V" Тогда
				Продолжить;
			Конецесли;
			
			// ── 5.1. Ищем или создаём документ ──────────────────────────
			deal_id = ДанныеЗаказа.deal_id;
			
			НайденныйДокумент = НайтиЗаказКлиента(deal_id);
			
			Если НайденныйДокумент = Документы.ЗаказКлиента.ПустаяСсылка() Тогда
				НовДок = Документы.ЗаказКлиента.СоздатьДокумент();
			Иначе
				НовДок = НайденныйДокумент.ПолучитьОбъект();
				НовДок.Товары.Очистить();
			КонецЕсли;
			
			// ── 5.2. Шапка документа ─────────────────────────────────────
			
			// Дата документа
			НовДок.Дата = КонвертироватьДатуСмартап(ДанныеЗаказа.deal_time);
			НовДок.номер = deal_id;
			НовДок.Статус = Перечисления.СтатусыЗаказовКлиентов.КОтгрузке;
			НовДок.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний");
			НовДок.Склад = Справочники.Склады.НайтиПоНаименованию("Основной склад");
		    НовДок.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
			НовДок.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
			НовДок.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;  
			НовДок.валюта = Справочники.Валюты.НайтиПоКоду(ДанныеЗаказа.currency_code);
			// Желаемая дата отгрузки
			Если ДанныеЗаказа.Свойство("delivery_date") И ЗначениеЗаполнено(ДанныеЗаказа.delivery_date) Тогда
				НовДок.ДатаОтгрузки = КонвертироватьДатуСмартап(ДанныеЗаказа.delivery_date);
			КонецЕсли;
			
			Партнеры = НайтиПартнеры(ДанныеЗаказа);
			Если ЗначениеЗаполнено(Партнеры) Тогда
				НовДок.Партнер    = Партнеры; // в УТ 11 партнёр ≠ контрагент, подкорректируйте
			Иначе
				Сообщить("Не найден контрагент с кодом: " + ДанныеЗаказа.person_code
				+ " (deal_id=" + deal_id + ")");
			КонецЕсли;

			
			// Контрагент (клиент)
			Контрагент = НайтиКонтрагента(ДанныеЗаказа,Партнеры);
			Если ЗначениеЗаполнено(Контрагент) Тогда
				НовДок.Контрагент = Контрагент;
			Иначе
				Сообщить("Не найден контрагент с кодом: " + ДанныеЗаказа.person_code
				+ " (deal_id=" + deal_id + ")");
			КонецЕсли; 
			
			НовДок.Договор = НайтиИлиСоздатьДоговор(НовДок.Организация, Партнеры, Контрагент, НовДок.Валюта,ДанныеЗаказа.subfilial_code);
			
			
			// Склад (берём из первой строки товаров, если не задан глобально)
			СкладДок = Справочники.Склады.НайтиПоНаименованию("Основной склад");
			
			// Валюта
			Если ДанныеЗаказа.Свойство("currency_code") И ЗначениеЗаполнено(ДанныеЗаказа.currency_code) Тогда
				НайденнаяВалюта = Справочники.Валюты.НайтиПоКоду(ДанныеЗаказа.currency_code);
				Если ЗначениеЗаполнено(НайденнаяВалюта) Тогда
					НовДок.Валюта = НайденнаяВалюта;
				КонецЕсли;
			КонецЕсли;
			
			// ── 5.3. Табличная часть «Товары» ────────────────────────────
			Если ДанныеЗаказа.Свойство("order_products") И ТипЗнч(ДанныеЗаказа.order_products) = Тип("Массив") Тогда
				
				Для Каждого СтрТовар Из ДанныеЗаказа.order_products Цикл
					
					Номенклатура = НайтиНоменклатуру(СтрТовар);
					
					Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
						Сообщить("Не найдена номенклатура: " + СтрТовар.product_code
						+ " (deal_id=" + deal_id + ") — строка пропущена.");
						Продолжить;
					КонецЕсли;
					
					НовСтрока = НовДок.Товары.Добавить();
					НовСтрока.Номенклатура = Номенклатура;
					НовСтрока.Количество   = Число(СтрТовар.order_quant); 
					НовСтрока.КоличествоУпаковок = Число(СтрТовар.order_quant); 
					НовСтрока.Цена         = СтрТовар.product_price;
					НовСтрока.Сумма        = НовСтрока.Количество * НовСтрока.Цена; 
					НовСтрока.СуммаСНДС    = НовСтрока.Сумма;
					НовСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;
					
						
					// НДС
					Если СтрТовар.Свойство("vat_percent") И ЗначениеЗаполнено(СтрТовар.vat_percent) Тогда
						НовСтрока.СтавкаНДС = СтрТовар.vat_percent;
					КонецЕсли;
					Если СтрТовар.Свойство("vat_amount") И ЗначениеЗаполнено(СтрТовар.vat_amount) Тогда
						НовСтрока.СуммаНДС = СтрТовар.vat_amount;
					КонецЕсли;
					
					// Единица измерения — берём базовую у номенклатуры
					НовСтрока.Упаковка = Номенклатура.ЕдиницаИзмерения;
					   					// Коэффициент упаковки
					//НовСтрока.Коэффициент = 1;
					
					// Пересчёт суммы со скидкой
					НовСтрока.Сумма = НовСтрока.Количество * НовСтрока.Цена;					
				КонецЦикла;
				
			КонецЕсли;
			
			// ── 5.4. Подарки / промо (order_gifts) ───────────────────────
			Если ДанныеЗаказа.Свойство("order_gifts") И ТипЗнч(ДанныеЗаказа.order_gifts) = Тип("Массив") Тогда
				
				Для Каждого СтрПодарок Из ДанныеЗаказа.order_gifts Цикл
					
					Номенклатура = НайтиНоменклатуру(СтрПодарок.product_code);
					Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
						Продолжить;
					КонецЕсли;
					
					НовСтрока = НовДок.Товары.Добавить();
					НовСтрока.Номенклатура       = Номенклатура;
					НовСтрока.Количество          = СтрПодарок.order_quant;
					НовСтрока.Цена                = 0;    // подарок — цена ноль
					НовСтрока.Сумма               = 0;
					НовСтрока.ЕдиницаИзмерения    = Номенклатура.ЕдиницаХраненияОстатков;
					НовСтрока.Коэффициент         = 1;
					НовСтрока.Склад               = СкладДок; 
					// Отметка что это подарок (если есть такой реквизит)
					// НовСтрока.ВидДвижения = "Подарок";
					
				КонецЦикла;
				
			КонецЕсли;
			
			// ── 5.5. Склад в шапку (из первой строки товаров) ───────────
			Если ЗначениеЗаполнено(СкладДок) Тогда
				НовДок.Склад = СкладДок;
			КонецЕсли;
			НовДок.СуммаДокумента = НовДок.Товары.Итог("Сумма");
			// ── 5.6. Запись документа ──────────────────────────────────── 
			//НовДок.ИсходныеДанные = Новый ХранилищеЗначения(ДанныеЗаказа, Новый СжатиеДанных(9));

			НовДок.Записать(РежимЗаписиДокумента.Запись);
			
			// Потом проводим штатно
			ДокОбъект = НовДок.Ссылка.ПолучитьОбъект();
			Попытка
				НаборЗаписей = РегистрыСведений.ДанныеИзSmartUp.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.КодЗаказа.Установить(deal_id);
				
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.Период    = ТекущаяДатаСеанса();
				НоваяЗапись.КодЗаказа = deal_id;    
				ДанныеЗаказа.Удалить("order_products");
				ДанныеЗаказа.Удалить("status");

				ЗаписьJSON = Новый ЗаписьJSON;
				ЗаписьJSON.УстановитьСтроку();
				ЗаписатьJSON(ЗаписьJSON, ДанныеЗаказа);
				НоваяЗапись.JSON = ЗаписьJSON.Закрыть();
				
				НаборЗаписей.Записать(Истина);		
			Исключение
				Сообщить("Не провёлся deal_id=" + deal_id + ": " + ОписаниеОшибки());
			КонецПопытки;
			                  	
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Функция НайтиИлиСоздатьДоговор(Организация, Партнер, Контрагент, Валюта = Неопределено,кодПроекта)
	
	Проект = Справочники.ПроектыSmartUp.НайтиПоКоду(кодПроекта);
    // 1) Ищем действующий договор реализации по связке Партнёр + Контрагент + Организация
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |	Договоры.Ссылка КАК Ссылка
    |ИЗ
    |	Справочник.ДоговорыКонтрагентов КАК Договоры
    |ГДЕ
    |	Договоры.Партнер = &Партнер
    |	И Договоры.Организация = &Организация
    |	И НЕ Договоры.ПометкаУдаления
    |	И Договоры.Контрагент = &Контрагент";
    
    Запрос.УстановитьПараметр("Партнер",      Партнер);
    Запрос.УстановитьПараметр("Контрагент",   Контрагент);
    Запрос.УстановитьПараметр("Организация",  Организация);
    
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;
    
    // 2) Не нашли — создаём новый
    НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
    НовыйДоговор.Контрагент           	= Контрагент;  
    НовыйДоговор.Партнер              	= Партнер;
    НовыйДоговор.Организация        	 = Организация;   
	НовыйДоговор.ДатаОкончанияДействия   = Дата(2030,01,01);
	НовыйДоговор.статус         = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
    НовыйДоговор.Наименование        	 = Проект.Наименование; 
	НовыйДоговор.ТипДоговора         	 = Перечисления.ТипыДоговоров.СПокупателем;
    НовыйДоговор.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;    
    Если ЗначениеЗаполнено(Валюта) Тогда
        НовыйДоговор.ВалютаВзаиморасчетов = Валюта;
    Иначе
        НовыйДоговор.Валюта = Константы.ВалютаУправленческогоУчета.Получить();
    КонецЕсли;
    
    Попытка
        НовыйДоговор.Записать();
        Возврат НовыйДоговор.Ссылка;
    Исключение
        Сообщить("Ошибка создания договора: " + ОписаниеОшибки());
        Возврат Справочники.Договоры.ПустаяСсылка();
    КонецПопытки;
    
КонецФункции

&НаСервере
Функция ЗаполнитьСтруктуруИзОтветаJSON(Знач Чтение) Экспорт

	Результат = Новый Структура;

	ПоследнееИмяРеквизита = Неопределено;
	
	Пока Чтение.Прочитать() Цикл
		Тип = Чтение.ТипТекущегоЗначения;
		Если Тип = ТипЗначенияJSON.НачалоОбъекта И ПоследнееИмяРеквизита<>Неопределено Тогда 
			Результат[ПоследнееИмяРеквизита] = ЗаполнитьСтруктуруИзОтветаJSON(Чтение);
		ИначеЕсли Тип = ТипЗначенияJSON.КонецОбъекта Тогда 
			Возврат Результат;
			ПоследнееИмяРеквизита = Неопределено;
		ИначеЕсли Тип = ТипЗначенияJSON.ИмяСвойства Тогда 
			Результат.Вставить(Чтение.ТекущееЗначение, Неопределено);
			ПоследнееИмяРеквизита = Чтение.ТекущееЗначение;
		ИначеЕсли Тип = ТипЗначенияJSON.Булево или Тип = ТипЗначенияJSON.Строка
			или Тип = ТипЗначенияJSON.Число или Тип = ТипЗначенияJSON.Null Тогда 
			Результат[ПоследнееИмяРеквизита] = Чтение.ТекущееЗначение;
		ИначеЕсли Тип = ТипЗначенияJSON.НачалоМассива Тогда 
			Результат[ПоследнееИмяРеквизита] = ЗаполнитьМассивИзОтветаJSON(Чтение);
		КонецЕсли;
	КонецЦикла;  
		
	Возврат Результат;
КонецФункции 

&НаСервере
Функция ЗаполнитьМассивИзОтветаJSON(Знач Чтение)
	Результат = Новый Массив;
	
	Пока Чтение.Прочитать() Цикл
		Тип = Чтение.ТипТекущегоЗначения;
		Если Тип = ТипЗначенияJSON.НачалоОбъекта Тогда 
			Результат.Добавить(ЗаполнитьСтруктуруИзОтветаJSON(Чтение));
		ИначеЕсли Тип = ТипЗначенияJSON.КонецМассива Тогда 
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;  
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ОтправитьЗаказВSmartup(ЗаказСсылка) Экспорт
	
	ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
	
	СтруктураЗаказа = Новый Структура;
	
	СтруктураЗаказа.Вставить("order_products", СформироватьМассивТоваровДляSmartup(ЗаказОбъект));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|  ДанныеИзSmartUpСрезПоследних.JSON КАК JSON
	|ИЗ
	|  РегистрСведений.ДанныеИзSmartUp.СрезПоследних КАК ДанныеИзSmartUpСрезПоследних
	|ГДЕ
	|  ДанныеИзSmartUpСрезПоследних.КодЗаказа = &КодЗаказа";
	
	Запрос.УстановитьПараметр("КодЗаказа", ЗаказСсылка.ЗаказКлиента.Номер);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Выборка.JSON);
		ДанныеИзРегистра = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		Для Каждого КлючЗначение Из ДанныеИзРегистра Цикл
			СтруктураЗаказа.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
		
	КонецЕсли;  
	СтруктураЗаказа.Вставить("room_code",       СтруктураЗаказа.room_name); // код рабочей зоны — заполните реальным
	СтруктураЗаказа.Вставить("robot_code",      "1"); 
	//СтруктураЗаказа.Вставить("filial_Id",  	""); 
	СтруктураЗаказа.Вставить("status",  	"A");   
	СтруктураЗаказа.Вставить("room_name",  	"");  
	СтруктураЗаказа.Вставить("inventory_kind",  	"P");
	Тело = Новый Структура("order", Новый Массив);
	Тело.order.Добавить(СтруктураЗаказа);
	
	СтрокаJSON = uzbled_EImzoСлужебный.ЗаписатьВСтрокуJSON(Тело);  
	Результат = ОтправитьЗапросВSmartup("/b/trade/txs/tdeal/order$import", СтрокаJSON);
	
	Если Результат = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Обрабатываем ответ
	Если Результат.Свойство("errors") И Результат.errors.Количество() > 0 Тогда
		Для Каждого Ошибка Из Результат.errors Цикл
			Сообщить("Ошибка Smartup [" + Ошибка.code + "]: " + Ошибка.message);
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;	
КонецФункции

&НаСервере
Функция СформироватьМассивТоваровДляSmartup(ЗаказОбъект)
	
	МассивТоваров = Новый Массив;
	
	Для Каждого СтрТовар Из ЗаказОбъект.Товары Цикл
		
		ЭлементТовара = Новый Структура;
		
		// product_unit_id — если позиция уже была загружена из Smartup и мы знаем её ID
		ЭлементТовара.Вставить("product_unit_id", "");
		ЭлементТовара.Вставить("external_id",     "");
		ЭлементТовара.Вставить("product_code",     СтрТовар.Номенклатура.Артикул);
		ЭлементТовара.Вставить("inventory_kind",   "G"); // G-товары/P-продукция/M-сырье, настройте под учёт
		ЭлементТовара.Вставить("warehouse_code", "13");
		ЭлементТовара.Вставить("card_code",        "");
		ЭлементТовара.Вставить("serial_number",    "");
		ЭлементТовара.Вставить("expiry_date",      "");
		ЭлементТовара.Вставить("on_balance",       "");
		
		// ключевые изменяемые поля
		ЭлементТовара.Вставить("order_quant",   Строка(Формат(СтрТовар.Количество, "ЧГ=0; ЧРД=.")));
		ЭлементТовара.Вставить("product_price", Строка(Формат(СтрТовар.Цена,       "ЧГ=0; ЧРД=.")));
		
		ЭлементТовара.Вставить("price_type_code",  "1"); // код типа цены, уточните у Smartup			ЭлементТовара.Вставить("margin_kind",   "P");
					
		МассивТоваров.Добавить(ЭлементТовара);
		
	КонецЦикла;
	
	Возврат МассивТоваров;
	
КонецФункции

&НаСервере
Функция ПолучитьСтатусSmartup(СтатусУТ)
	
	Если СтатусУТ = Перечисления.СтатусыЗаказовКлиентов.НаОформлении Тогда
		Возврат "D";
	ИначеЕсли СтатусУТ = Перечисления.СтатусыЗаказовКлиентов.КВыполнению Тогда
		Возврат "B#N";
	ИначеЕсли СтатусУТ = Перечисления.СтатусыЗаказовКлиентов.Выполнен Тогда
		Возврат "B#S";
	ИначеЕсли СтатусУТ = Перечисления.СтатусыЗаказовКлиентов.Закрыт Тогда
		Возврат "C";
	Иначе
		Возврат "D";
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьВозвратыИзSmartupНаСервере() Экспорт 
	
	// 1. Получаем учётные данные
	Логин  = Константы.Логин.Получить();
	Пароль = Константы.Пароль.Получить();
	
	// 2. Формируем тело запроса (фильтр — можно настроить даты)
	СтруктураДанныхJSON = Новый Структура;
	СтруктураДанныхJSON.Вставить("external_id",       "");
	СтруктураДанныхJSON.Вставить("deal_id",           "");
	СтруктураДанныхJSON.Вставить("begin_deal_date",   "");
	СтруктураДанныхJSON.Вставить("end_deal_date",     "");
	СтруктураДанныхJSON.Вставить("begin_created_on",  "");
	СтруктураДанныхJSON.Вставить("end_created_on",    "");
	СтруктураДанныхJSON.Вставить("begin_modified_on", "");
	СтруктураДанныхJSON.Вставить("end_modified_on",   "");
	
	СтрокаJSON = uzbled_EImzoСлужебный.ЗаписатьВСтрокуJSON(СтруктураДанныхJSON);
	
	// 3. HTTP-запрос к Smartup (эндпоинт возвратов)
	SSL        = Новый ЗащищенноеСоединениеOpenSSL();
	HTTP       = Новый HTTPСоединение("smartup.online",, Логин, Пароль,,, SSL);
	ЗапросPOST = Новый HTTPЗапрос("/b/anor/mxsx/mdeal/return$export");
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	ЗапросPOST.Заголовки = Заголовки;
	ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	
	HTTPОтвет    = HTTP.ОтправитьДляОбработки(ЗапросPOST);
	ОтветСервера = HTTPОтвет.ПолучитьТелоКакСтроку();
	
	// 4. Разбор JSON-ответа
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ОтветСервера);
	МассивВозвратов = ЗаполнитьСтруктуруИзОтветаJSON(Чтение);
	Чтение.Закрыть();
	
	// В ответе возвраты приходят в массиве "return"
	// (проверьте по факту: может называться "order" или "returns")
	Если НЕ МассивВозвратов.Свойство("return") Тогда
		Сообщить("В ответе Smartup не найден массив возвратов. Ответ: " + Лев(ОтветСервера, 500));
		Возврат;
	КонецЕсли;
	
	Для Каждого ДанныеВозврата Из МассивВозвратов.return Цикл
		
		Попытка
			
			//// Фильтр по статусу — при необходимости скорректируйте код статуса возврата
			//Если ДанныеВозврата.Свойство("status") И ДанныеВозврата.status <> "B#V" Тогда
			//	Продолжить;
			//КонецЕсли;
			
			// ── 5.1. Ищем или создаём документ ──────────────────────────
			deal_id = ДанныеВозврата.deal_id;
			
			НайденныйДокумент = НайтиВозвратОтКлиента(deal_id);
			
			Если НайденныйДокумент = Документы.ВозвратТоваровОтКлиента.ПустаяСсылка() Тогда
				НовДок = Документы.ВозвратТоваровОтКлиента.СоздатьДокумент();
			Иначе
				НовДок = НайденныйДокумент.ПолучитьОбъект();
				НовДок.Товары.Очистить();
			КонецЕсли;
			
			// ── 5.2. Шапка документа ─────────────────────────────────────
			НовДок.Дата   = КонвертироватьДатуСмартап(ДанныеВозврата.deal_time);
			НовДок.Номер  = deal_id;
			
			НовДок.Организация            = Справочники.Организации.ОрганизацияПоУмолчанию();
			НовДок.ХозяйственнаяОперация  = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиента;
			//НовДок.Статус                 = Перечисления.СтатусыВозвратовТоваровОтКлиентов.КВозврату;
			НовДок.валюта = Справочники.Валюты.НайтиПоКоду(ДанныеВозврата.currency_code);

			СкладДок     = Справочники.Склады.НайтиПоНаименованию("Основной склад");
			НовДок.Склад = СкладДок;
			
			// Партнёр и контрагент — те же функции, что и в загрузке заказов
			Партнеры = НайтиПартнеры(ДанныеВозврата);
			Если ЗначениеЗаполнено(Партнеры) Тогда
				НовДок.Партнер = Партнеры;
			Иначе
				Сообщить("Не найден партнёр с кодом: " + ДанныеВозврата.person_code
					+ " (deal_id=" + deal_id + ")");
			КонецЕсли;
			
			Контрагент = НайтиКонтрагента(ДанныеВозврата, Партнеры);
			Если ЗначениеЗаполнено(Контрагент) Тогда
				НовДок.Контрагент = Контрагент;
			Иначе
				Сообщить("Не найден контрагент с кодом: " + ДанныеВозврата.person_code
					+ " (deal_id=" + deal_id + ")");
			КонецЕсли; 
			
			НовДок.Договор = НайтиИлиСоздатьДоговор(НовДок.Организация, Партнеры, Контрагент, НовДок.Валюта,ДанныеВозврата.subfilial_code);
			
			// Валюта
			Если ДанныеВозврата.Свойство("currency_code") И ЗначениеЗаполнено(ДанныеВозврата.currency_code) Тогда
				НайденнаяВалюта = Справочники.Валюты.НайтиПоКоду(ДанныеВозврата.currency_code);
				Если ЗначениеЗаполнено(НайденнаяВалюта) Тогда
					НовДок.Валюта = НайденнаяВалюта;
				КонецЕсли;
			КонецЕсли;
			
			//// Документ реализации, по которому оформляется возврат
			//// (если Smartup передаёт ссылку на исходный заказ — order_deal_id / base_deal_id)
			//ДокументРеализации = Неопределено;
			//Если ДанныеВозврата.Свойство("order_deal_id") И ЗначениеЗаполнено(ДанныеВозврата.order_deal_id) Тогда
			//	ДокументРеализации = НайтиРеализациюПоЗаказу(ДанныеВозврата.order_deal_id);
			//КонецЕсли;
			//
			// ── 5.3. Табличная часть «Товары» ────────────────────────────
			// Массив строк: в возвратах Smartup обычно return_products
			// (если приходит order_products — поменяйте имя свойства)
			ИмяМассиваТоваров = "";
			Если ДанныеВозврата.Свойство("return_products") Тогда
				ИмяМассиваТоваров = "return_products";
			ИначеЕсли ДанныеВозврата.Свойство("order_products") Тогда
				ИмяМассиваТоваров = "order_products";
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ИмяМассиваТоваров) Тогда
				
				МассивТоваров = ДанныеВозврата[ИмяМассиваТоваров];
				
				Для Каждого СтрТовар Из МассивТоваров Цикл
									
					Номенклатура = НайтиНоменклатуру(СтрТовар);
					
					Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
						Сообщить("Не найдена номенклатура: " + СтрТовар.product_code
						+ " (deal_id=" + deal_id + ") — строка пропущена.");
						Продолжить;
					КонецЕсли;
					
					НовСтрока = НовДок.Товары.Добавить();
					НовСтрока.Номенклатура = Номенклатура;
					НовСтрока.Количество   = Число(СтрТовар.return_quant); 
					НовСтрока.КоличествоУпаковок = Число(СтрТовар.return_quant); 
					НовСтрока.Цена         = СтрТовар.product_price;
					НовСтрока.Сумма        = НовСтрока.Количество * НовСтрока.Цена; 
					НовСтрока.СуммаСНДС    = НовСтрока.Сумма;
								
						
					// НДС
					Если СтрТовар.Свойство("vat_percent") И ЗначениеЗаполнено(СтрТовар.vat_percent) Тогда
						НовСтрока.СтавкаНДС = СтрТовар.vat_percent;
					КонецЕсли;
					Если СтрТовар.Свойство("vat_amount") И ЗначениеЗаполнено(СтрТовар.vat_amount) Тогда
						НовСтрока.СуммаНДС = СтрТовар.vat_amount;
					КонецЕсли;
					
					// Единица измерения — берём базовую у номенклатуры
					НовСтрока.Упаковка = Номенклатура.ЕдиницаИзмерения;
					   					// Коэффициент упаковки
					//НовСтрока.Коэффициент = 1;
					
					// Пересчёт суммы со скидкой
					НовСтрока.Сумма = НовСтрока.Количество * НовСтрока.Цена;					
				КонецЦикла;				
			КонецЕсли;
			
			НовДок.СуммаДокумента = НовДок.Товары.Итог("Сумма");
			
			// ── 5.4. Запись документа ────────────────────────────────────
			НовДок.Записать(РежимЗаписиДокумента.Запись);
			
			// ── 5.5. Сохраняем исходный JSON в регистр сведений ─────────
			Попытка
				НаборЗаписей = РегистрыСведений.ДанныеИзSmartUp.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.КодЗаказа.Установить(deal_id);
				
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.Период    = ТекущаяДатаСеанса();
				НоваяЗапись.КодЗаказа = deal_id;
				
				Если ЗначениеЗаполнено(ИмяМассиваТоваров) Тогда
					ДанныеВозврата.Удалить(ИмяМассиваТоваров);
				КонецЕсли;
				
				ЗаписьJSON = Новый ЗаписьJSON;
				ЗаписьJSON.УстановитьСтроку();
				ЗаписатьJSON(ЗаписьJSON, ДанныеВозврата);
				НоваяЗапись.JSON = ЗаписьJSON.Закрыть();
				
				НаборЗаписей.Записать(Истина);
			Исключение
				Сообщить("Ошибка записи регистра deal_id=" + deal_id + ": " + ОписаниеОшибки());
			КонецПопытки;
			
		Исключение
			Сообщить("Ошибка загрузки возврата: " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// ─────────────────────────────────────────────────────────────────
// Поиск ранее загруженного возврата по номеру (deal_id)
&НаСервере
Функция НайтиВозвратОтКлиента(deal_id)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Возврат.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВозвратТоваровОтКлиента КАК Возврат
	|ГДЕ
	|	Возврат.Номер = &Номер";
	Запрос.УстановитьПараметр("Номер", Строка(deal_id));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ВозвратТоваровОтКлиента.ПустаяСсылка();
	
КонецФункции

// dd.mm.yyyy [hh:mi:ss] — как требует Smartup
&НаСервере
Функция ФорматДатаSmartup(Дата, СВременем = Ложь)
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;
	Если СВременем Тогда
		Возврат Формат(Дата, "ДФ=dd.MM.yyyy");
	Иначе
		Возврат Формат(Дата, "ДФ=dd.MM.yyyy");
	КонецЕсли;
КонецФункции

&НаСервере
Функция ОтправитьЗапросВSmartup(АдресРесурса, СтрокаJSON) Экспорт
	
	Логин  = Константы.Логин.Получить();
	Пароль = Константы.Пароль.Получить();
	
	SSL  = Новый ЗащищенноеСоединениеOpenSSL();
	HTTP = Новый HTTPСоединение("smartup.online",, Логин, Пароль,,, SSL);
	
	ЗапросPOST = Новый HTTPЗапрос(АдресРесурса);
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	ЗапросPOST.Заголовки = Заголовки;
	ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	
	Попытка
		HTTPОтвет = HTTP.ОтправитьДляОбработки(ЗапросPOST);
	Исключение
		Сообщить("Ошибка соединения со Smartup: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	ОтветСервера = HTTPОтвет.ПолучитьТелоКакСтроку();
	
	// order$import_order_marking_codes может вернуть пустое тело — обрабатываем отдельно
	Если НЕ ЗначениеЗаполнено(ОтветСервера) Тогда
		Возврат Новый Структура("successes, errors", Новый Массив, Новый Массив);
	КонецЕсли;
	
	//Чтение = Новый ЧтениеJSON;
	//Чтение.УстановитьСтроку(ОтветСервера);
	//Результат = ЗаполнитьСтруктуруИзОтветаJSON(Чтение);
	//Чтение.Закрыть();
	
	Возврат uzbled_EImzoСлужебный.ПрочитатьСтрокуJSON(ОтветСервера);
	
КонецФункции 

// ============================================================================
// А) СИНХРОНИЗАЦИЯ НОМЕНКЛАТУРЫ — версия с прогрессом и статистикой
// ============================================================================

// Возвращает Структуру:
//   Всего                  - Число - сколько товаров пришло из Smartup
//   Создано                - Число - сколько НОВЫХ элементов номенклатуры создано
//   НайденоПоАртикулу       - Число - сколько уже существовало (по Артикулу), не тронуто
//   НайденоПоНаименованию   - Число - сколько сопоставлено по Наименованию
//                                     (Артикул другой/пуст — Описание дополнено)
//   ОшибокКоличество        - Число
//   СписокОшибок            - Массив строк с описанием ошибок (до 50 штук)
&НаСервере
Функция ВыполнитьСинхронизациюНоменклатурыСДеталями() Экспорт
	
	Итоги = Новый Структура;
	Итоги.Вставить("Всего", 0);
	Итоги.Вставить("Создано", 0);
	Итоги.Вставить("НайденоПоАртикулу", 0);
	Итоги.Вставить("НайденоПоНаименованию", 0);
	Итоги.Вставить("ОшибокКоличество", 0);
	Итоги.Вставить("СписокОшибок", Новый Массив);
	
	СтруктураДанныхJSON = Новый Структура;
	СтруктураДанныхJSON.Вставить("code", "");
	СтруктураДанныхJSON.Вставить("begin_created_on", "");
	СтруктураДанныхJSON.Вставить("end_created_on", "");
	СтруктураДанныхJSON.Вставить("begin_modified_on", "");
	СтруктураДанныхJSON.Вставить("end_modified_on", "");
	
	СтрокаJSON = uzbled_EImzoСлужебный.ЗаписатьВСтрокуJSON(СтруктураДанныхJSON);
	
	ДлительныеОперации.СообщитьПрогресс(0, "Запрашиваем список товаров у Smartup...");
	
	Результат = ОтправитьЗапросВSmartup("/b/anor/mxsx/mr/inventory$export", СтрокаJSON);
	
	Если Результат = Неопределено ИЛИ НЕ Результат.Свойство("inventory") Тогда
		Итоги.СписокОшибок.Добавить("Не удалось получить список товаров из Smartup (inventory$export)");
		Итоги.ОшибокКоличество = 1;
		Возврат Итоги;
	КонецЕсли;
	
	Всего = Результат.inventory.Количество();
	Итоги.Всего = Всего;
	
	Обработано = 0;
	ПоследнийПоказанныйПроцент = -1;
	
	Для Каждого ТоварSmartup Из Результат.inventory Цикл
		
		Обработано = Обработано + 1;
		
		Попытка
			
			Код = ТоварSmartup.code;
			Если НЕ ЗначениеЗаполнено(Код) Тогда
				Продолжить;
			КонецЕсли;
			
			НайденоПоАртикулу = Ложь;
			Номенклатура = НайтиНоменклатуруПоАртикулу(Код);
			
			Если ЗначениеЗаполнено(Номенклатура) Тогда
				НайденоПоАртикулу = Истина;
				Итоги.НайденоПоАртикулу = Итоги.НайденоПоАртикулу + 1;
			Иначе
				Номенклатура = НайтиНоменклатуруПоНаименованию(ТоварSmartup.name);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
				
				// Не найдено ни по артикулу, ни по наименованию — создаём новый элемент
				НовыйТовар = Справочники.Номенклатура.СоздатьЭлемент();
				НовыйТовар.ВидНоменклатуры    = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товар");
				НовыйТовар.ТипНоменклатуры    = Перечисления.ТипыНоменклатуры.Товар;
				НовыйТовар.Наименование        = ТоварSmartup.name;
				НовыйТовар.НаименованиеПолное  = ?(ЗначениеЗаполнено(ТоварSmartup.name), ТоварSmartup.name, Код);
				НовыйТовар.Артикул             = Код;                                                                            
				НовыйТовар.ВариантОформленияПродажи  = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
				НовыйТовар.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
				Попытка
					НовыйТовар.SmartUpID = ТоварSmartup.product_id;
				Исключение
				КонецПопытки;
				НовыйТовар.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("Шт");
				НовыйТовар.Записать();   
				 
				МенеджерЗаписи = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Период = ТекущаяДата();
				МенеджерЗаписи.Номенклатура = НовыйТовар.Ссылка; 
				МенеджерЗаписи.Штрихкод = ТоварSmartup.barcodes;           // реквизиты
				МенеджерЗаписи.Записать();

				
				Итоги.Создано = Итоги.Создано + 1;
				
			ИначеЕсли НЕ НайденоПоАртикулу Тогда
				
				// Найдено ПО НАИМЕНОВАНИЮ — Артикул не трогаем, фиксируем код в Описании
				ПометкаSmartup = "Smartup: " + Код;
				Попытка
					ТекущееОписание = Номенклатура.Описание;
					Если НЕ ЗначениеЗаполнено(ТекущееОписание) ИЛИ СтрНайти(ТекущееОписание, ПометкаSmartup) = 0 Тогда
						ОбъектНоменклатуры = Номенклатура.ПолучитьОбъект();
						Если ЗначениеЗаполнено(ТекущееОписание) Тогда
							ОбъектНоменклатуры.Описание = ТекущееОписание + " | " + ПометкаSmartup;
						Иначе
							ОбъектНоменклатуры.Описание = ПометкаSmartup;
						КонецЕсли;
						ОбъектНоменклатуры.Записать();
					КонецЕсли;
				Исключение
				КонецПопытки;
				
				Итоги.НайденоПоНаименованию = Итоги.НайденоПоНаименованию + 1;
				
			КонецЕсли;
			
		Исключение
			Итоги.ОшибокКоличество = Итоги.ОшибокКоличество + 1;
			Если Итоги.СписокОшибок.Количество() < 50 Тогда
				Итоги.СписокОшибок.Добавить("code=" + ТоварSmartup.code + ": " + ОписаниеОшибки());
			КонецЕсли;
		КонецПопытки;
		
		// Обновляем индикатор прогресса не на каждой позиции, а при изменении процента
		Процент = ?(Всего = 0, 100, Окр(Обработано * 100 / Всего, 0));
		Если Процент <> ПоследнийПоказанныйПроцент Тогда
			ДлительныеОперации.СообщитьПрогресс(Процент,
				СтрШаблон("Обработано %1 из %2. Создано: %3, найдено по Артикулу: %4, по Наименованию: %5",
					Обработано, Всего, Итоги.Создано, Итоги.НайденоПоАртикулу, Итоги.НайденоПоНаименованию));
			ПоследнийПоказанныйПроцент = Процент;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Итоги;
	
КонецФункции
&НаСервере
Функция НайтиНоменклатуруПоАртикулу(Артикул)
	
	Если НЕ ЗначениеЗаполнено(Артикул) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул = &Артикул";
	Запрос.УстановитьПараметр("Артикул", Артикул);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат.Выгрузить()[0].Ссылка;
	
КонецФункции

// Поиск номенклатуры в 1С по наименованию (используется как второй шаг,
// если по артикулу ничего не нашлось)
&НаСервере
Функция НайтиНоменклатуруПоНаименованию(Наименование)
	
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат.Выгрузить()[0].Ссылка;
	
КонецФункции


// ============================================================================
// Б) БЫСТРЫЙ ЛОКАЛЬНЫЙ КЭШ ДЛЯ ИНВЕНТАРИЗАЦИИ (без обращений к Smartup)
// ============================================================================
// В отличие от ЗагрузитьСправочникНоменклатурыИзSmartup(), эта функция
// НИЧЕГО не создаёт и не ходит в Smartup — просто одним запросом читает
// уже существующую в 1С номенклатуру (у которой заполнен Артикул) и строит
// Соответствие Артикул → Ссылка. Быстро даже при 3-5 тыс. позиций.
&НаСервере
Функция ПостроитьКэшНоменклатурыПоАртикулу() Экспорт
	
	Кэш = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Артикул КАК Артикул,
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул <> """"
	|	И НЕ Номенклатура.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Кэш.Вставить(Выборка.Артикул, Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Кэш;
	
КонецФункции

// Резервный поиск по Описанию (где записан код Smartup в формате "Smartup: <код>")
// Используется ТОЛЬКО когда товар не найден в быстром кэше по Артикулу —
// то есть на "проблемные" позиции, которых обычно немного, поэтому
// на общую скорость обработки инвентаризации это не влияет.
&НаСервере
Функция НайтиНоменклатуруПоОписаниюSmartup(Код) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Код) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Описание ПОДОБНО &Маска
	|	И НЕ Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Маска", "%Smartup: " + Код + "%");
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат.Выгрузить()[0].Ссылка;
	
КонецФункции
// Обёртка для запуска в фоновом задании (стандартная сигнатура для
// ДлительныеОперации.ВыполнитьВФоне — Параметры, АдресРезультата)
&НаСервере
Процедура СинхронизацияНоменклатурыВФоне(Параметры, АдресРезультата) Экспорт
	
	Итоги = ВыполнитьСинхронизациюНоменклатурыСДеталями();
	ПоместитьВоВременноеХранилище(Итоги, АдресРезультата);
	
КонецПроцедуры


// ============================================================================
// Б) ЗАГРУЗКА ИНВЕНТАРИЗАЦИЙ — версия с прогрессом и статистикой
// ============================================================================

// Возвращает Структуру:
//   ВсегоИнвентаризаций     - Число
//   ДокументовСоздано       - Число - новых документов "Пересчёт товаров"
//   ДокументовОбновлено     - Число - уже существовавших (по Номер = SmartupID)
//   ВсегоСтрок              - Число - всего строк товаров по всем документам
//   СтрокНайденоПоАртикулу  - Число
//   СтрокНайденоПоОписанию  - Число
//   СтрокНеНайдено          - Число
//   ОшибокДокументов        - Число
//   СписокОшибок            - Массив строк (до 50 штук)
&НаСервере
Функция ВыполнитьЗагрузкуИнвентаризацииСДеталями(ДатаНач, ДатаКон) Экспорт
	
	Итоги = Новый Структура;
	Итоги.Вставить("ВсегоИнвентаризаций", 0);
	Итоги.Вставить("ДокументовСоздано", 0);
	Итоги.Вставить("ДокументовОбновлено", 0);
	Итоги.Вставить("ВсегоСтрок", 0);
	Итоги.Вставить("СтрокНайденоПоАртикулу", 0);
	Итоги.Вставить("СтрокНайденоПоОписанию", 0);
	Итоги.Вставить("СтрокНеНайдено", 0);
	Итоги.Вставить("ОшибокДокументов", 0);
	Итоги.Вставить("СписокОшибок", Новый Массив);
	
	ДлительныеОперации.СообщитьПрогресс(0, "Строим кэш номенклатуры...");
	КэшНоменклатуры = ПостроитьКэшНоменклатурыПоАртикулу();
	
	МассивФилиалов = Новый Массив;
	МассивФилиалов.Добавить(Новый Структура("filial_code", ""));
	
	СтруктураДанныхJSON = Новый Структура;
	СтруктураДанныхJSON.Вставить("filial_codes", МассивФилиалов);
	СтруктураДанныхJSON.Вставить("filial_code", Константы.ОрганизацияКодSmartup.Получить());
	СтруктураДанныхJSON.Вставить("external_id", "");
	СтруктураДанныхJSON.Вставить("stocktaking_id", "");
	СтруктураДанныхJSON.Вставить("begin_stocktaking_date", ФорматДатаSmartup(ДатаНач));
	СтруктураДанныхJSON.Вставить("end_stocktaking_date",   ФорматДатаSmartup(ДатаКон));
	СтруктураДанныхJSON.Вставить("begin_created_on", "");
	СтруктураДанныхJSON.Вставить("end_created_on", "");
	СтруктураДанныхJSON.Вставить("begin_modified_on", "");
	СтруктураДанныхJSON.Вставить("end_modified_on", "");
	
	СтрокаJSON = uzbled_EImzoСлужебный.ЗаписатьВСтрокуJSON(СтруктураДанныхJSON);   
	
	ДлительныеОперации.СообщитьПрогресс(5, "Запрашиваем инвентаризации у Smartup...");
	Результат = ОтправитьЗапросВSmartup("/b/anor/mxsx/mkw/stocktaking$export", СтрокаJSON);
	
	Если Результат = Неопределено Тогда
		Итоги.СписокОшибок.Добавить("Не удалось получить ответ от Smartup (stocktaking$export)");
		Итоги.ОшибокДокументов = 1;
		Возврат Итоги;
	КонецЕсли;
	
	Если НЕ Результат.Свойство("stocktaking") Тогда
		Итоги.СписокОшибок.Добавить("В ответе Smartup не найден массив 'stocktaking'");
		Итоги.ОшибокДокументов = 1;
		Возврат Итоги;
	КонецЕсли;
	
	Всего = Результат.stocktaking.Количество();
	Итоги.ВсегоИнвентаризаций = Всего;
	
	Обработано = 0;
	ПоследнийПоказанныйПроцент = -1;
	
	Для Каждого ДанныеИнвентаризации Из Результат.stocktaking Цикл
		
		Обработано = Обработано + 1;
		
		Попытка
			
			SmartupID    = ДанныеИнвентаризации.stocktaking_id;
			SmartupНомер = ДанныеИнвентаризации.stocktaking_number;
			
			НайденныйДокумент = НайтиИнвентаризациюПоSmartupID(SmartupID);
			ЭтоНовыйДокумент = (НайденныйДокумент = Документы.ПересчетТоваров.ПустаяСсылка());
			
			Если ЭтоНовыйДокумент Тогда
				Инвентаризация = Документы.ПересчетТоваров.СоздатьДокумент();
			Иначе
				Инвентаризация = НайденныйДокумент.ПолучитьОбъект();
				Инвентаризация.Товары.Очистить();
			КонецЕсли;
			
			Инвентаризация.Дата        = КонвертироватьДатуСмартап(ДанныеИнвентаризации.stocktaking_date);
			Инвентаризация.Номер       = Строка(SmartupID);
			
			Инвентаризация.Склад = Константы.СкладДляSmartup.Получить();
			Инвентаризация.Комментарий = "Синхронизован из Smartup | № Smartup: " + SmartupНомер;
			НеНайденныеКоды = Новый Массив;
			
			Если ДанныеИнвентаризации.Свойство("stocktaking_items")
				И ТипЗнч(ДанныеИнвентаризации.stocktaking_items) = Тип("Массив") Тогда
				
				Для Каждого СтрТовар Из ДанныеИнвентаризации.stocktaking_items Цикл
					
					Итоги.ВсегоСтрок = Итоги.ВсегоСтрок + 1;
					
					Номенклатура = КэшНоменклатуры.Получить(СтрТовар.product_code);
					
					Если Номенклатура <> Неопределено И ЗначениеЗаполнено(Номенклатура) Тогда
						Итоги.СтрокНайденоПоАртикулу = Итоги.СтрокНайденоПоАртикулу + 1;
					Иначе
						
						Номенклатура = НайтиНоменклатуруПоОписаниюSmartup(СтрТовар.product_code);
						
						Если ЗначениеЗаполнено(Номенклатура) Тогда
							КэшНоменклатуры.Вставить(СтрТовар.product_code, Номенклатура);
							Итоги.СтрокНайденоПоОписанию = Итоги.СтрокНайденоПоОписанию + 1;
						Иначе
							НеНайденныеКоды.Добавить(СтрТовар.product_code);
							Итоги.СтрокНеНайдено = Итоги.СтрокНеНайдено + 1;
							Продолжить;
						КонецЕсли;
						
					КонецЕсли;
					
					НоваяСтрока                  = Инвентаризация.Товары.Добавить();
					НоваяСтрока.Номенклатура      = Номенклатура;
					НоваяСтрока.КоличествоУпаковокФакт        = ?(ЗначениеЗаполнено(СтрТовар.quantity), Число(СтрТовар.quantity), 0);
				КонецЦикла;
				
			КонецЕсли;
			
			Если НеНайденныеКоды.Количество() > 0 Тогда
				Инвентаризация.Комментарий = Инвентаризация.Комментарий
					+ " | ТРЕБУЕТ ПРОВЕРКИ: не найдены товары ("
					+ Строка(НеНайденныеКоды.Количество()) + " шт.): "
					+ СтрСоединить(НеНайденныеКоды, ", ");
			КонецЕсли;
			
			//Инвентаризация.СуммаДокумента = Инвентаризация.Запасы.Итог("Сумма");
			Инвентаризация.Записать(РежимЗаписиДокумента.Запись);
			
			Если ЭтоНовыйДокумент Тогда
				Итоги.ДокументовСоздано = Итоги.ДокументовСоздано + 1;
			Иначе
				Итоги.ДокументовОбновлено = Итоги.ДокументовОбновлено + 1;
			КонецЕсли;
			
		Исключение
			Итоги.ОшибокДокументов = Итоги.ОшибокДокументов + 1;
			Если Итоги.СписокОшибок.Количество() < 50 Тогда
				Итоги.СписокОшибок.Добавить("stocktaking_id=" + ДанныеИнвентаризации.stocktaking_id + ": " + ОписаниеОшибки());
			КонецЕсли;
		КонецПопытки;
		
		Процент = ?(Всего = 0, 100, 5 + Окр(Обработано * 95 / Всего, 0));
		Если Процент <> ПоследнийПоказанныйПроцент Тогда
			ДлительныеОперации.СообщитьПрогресс(Процент,
				СтрШаблон("Обработано %1 из %2 инвентаризаций. Создано: %3, обновлено: %4, не найдено строк: %5",
					Обработано, Всего, Итоги.ДокументовСоздано, Итоги.ДокументовОбновлено, Итоги.СтрокНеНайдено));
			ПоследнийПоказанныйПроцент = Процент;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Итоги;
	
КонецФункции

// Обёртка для запуска в фоновом задании
&НаСервере
Процедура ЗагрузкаИнвентаризацииВФоне(Параметры, АдресРезультата) Экспорт
	
	Итоги = ВыполнитьЗагрузкуИнвентаризацииСДеталями(Параметры.ДатаНачала, Параметры.ДатаОкончания);
	ПоместитьВоВременноеХранилище(Итоги, АдресРезультата);
	
КонецПроцедуры

// Поиск ранее загруженного документа "Пересчёт товаров" по SmartupID,
// который хранится напрямую в реквизите "Номер" документа (уникальный ключ)
&НаСервере
Функция НайтиИнвентаризациюПоSmartupID(SmartupID)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Инвентаризация.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПересчетТоваров КАК Инвентаризация
	|ГДЕ
	|	Инвентаризация.Номер = &Номер";
	Запрос.УстановитьПараметр("Номер", Строка(SmartupID));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ПересчетТоваров.ПустаяСсылка();
	
КонецФункции

